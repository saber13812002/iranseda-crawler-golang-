# IranSeda Whisper worker/api — GPU image on server 53 (FULLY OFFLINE build).
#
# Base whisper-web-whisper:latest already has working CUDA (torch 2.13+cu130),
# faster-whisper 1.2.1, ctranslate2 4.8, ffmpeg. We only add pymysql/requests
# from pre-downloaded local wheels (server 53's build networking is broken:
# read-only /etc/resolv.conf, IPv6-blackhole DNS, dead baked-in proxy).
#
# The Whisper model (whisper-4-persian = nezamisafa/whisper-persian-v4, CT2
# int8 + tokenizer) is NOT baked in; it is mounted read-only at runtime from
# /home/saber/whisper-models.
#
# Build:  docker build -f Dockerfile.whisper -t iranseda-whisper:latest .
FROM whisper-web-whisper:latest
# Clear the base image entrypoint (it boots its own web service + model conversion).
ENTRYPOINT []

ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

COPY wheels/ /tmp/wheels/
RUN env -u http_proxy -u https_proxy -u HTTP_PROXY -u HTTPS_PROXY \
    pip3 install --no-cache-dir --no-index --find-links=/tmp/wheels \
      "pymysql>=1.1" "requests>=2.31" "python-multipart>=0.0.9" \
    && python3 -c "import pymysql, requests, multipart; print('deps ok')" \
    && rm -rf /tmp/wheels

COPY services/whisper/ /app/whisper/
WORKDIR /app/whisper
CMD ["python3", "worker.py"]
