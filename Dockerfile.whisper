# IranSeda Whisper service (API + worker), GPU build.
# Built on server 53 (H100). The resulting container runs on a CUDA GPU.
# NOTE: server 53's Docker bridge can't resolve DNS (LAN resolver), so all
# network steps run with --network=host. Build with BuildKit/buildx.
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.11 python3.11-venv python3-pip ffmpeg openssh-client \
        build-essential git \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.11 /usr/local/bin/python

WORKDIR /app

# Install Python deps first (better layer caching).
COPY services/whisper/requirements.txt /app/requirements.txt
RUN pip3 install --break-system-packages -r /app/requirements.txt

# Pre-cache the whisper model into the image so containers start fast.
ARG WHISPER_MODEL=large-v3-turbo
ENV WHISPER_MODEL=${WHISPER_MODEL}
RUN python3 -c "from faster_whisper.utils import download_model; download_model('large-v3-turbo'); print('cached large-v3-turbo')" || \
    echo "model pre-cache skipped (offline build); will download on first run"

# Application code.
COPY services/whisper/ /app/

# ffmpeg for faster-whisper audio decode.
RUN ln -sf /usr/bin/ffmpeg /usr/local/bin/ffmpeg

EXPOSE 9500

CMD ["python3", "-m", "uvicorn", "api:app", "--host", "0.0.0.0", "--port", "9500"]
