1
0:00:00 --> 0:00:04,880
انشالله نگاه پر از محروم محبت خداونده متعال بدرقه راه زندگیتون

2
0:00:04,880 --> 0:00:09,160
همراه بشیم برکرانه نور و خدا یارو نگهدار شما

3
0:00:30 --> 0:00:44,600
فَاسْأَلُوا أَهْلَذِكْرِ اِنْ كُنتُمْ لَا دَعْلَهُونَ

4
0:00:44,600 --> 0:00:48,200
بر چراغه نور

5
0:00:48,200 --> 0:00:54,400
بِالْبَيِّنَاتِ وَالزُّهُرُ

6
0:00:54,400 --> 0:00:59,400
وَأَنْزَلْنَا

7
0:01:00 --> 0:01:10
اِلَيْكَ الذِكْرَهِتُ بَيْنَ لِلنَّاسِ

8
0:01:10,820 --> 0:01:22
وَنُزِّلَ اِلَيْهِمْ وَلَعَلَّهُمْ يَتَفَكَّرُونَ

9
0:01:23 --> 0:01:25,820
بسم الله الرحمن الرحیم

10
0:01:25,820 --> 0:01:28,460
یا ایهالذین آمنون

11
0:01:28,460 --> 0:01:29,860
لا تحرمون

12
0:01:29,860 --> 0:01:29,980
قرآنه

13
0:01:29,980 --> 0:01:31,980
تیبات معا حل الله لکن

14
0:01:32,640 --> 0:01:34,340
و لا تعتدو

15
0:01:34,340 --> 0:01:36,980
اِنَّ اللَّهُ نَا يُحِبُّهُ مُعْتَدِينَ

16
0:01:36,980 --> 0:01:41,620
وَکُلُوا مِمَّا رَزَغِخُمُ اللَّهُ حَلَارًا تَيِّبَا

17
0:01:41,620 --> 0:01:45,780
وَاتَّغُوا لَّا هَلَّبِي اَنْتُمْ بِهِ مُؤْمِنُونَ

18
0:01:45,780 --> 0:01:51,020
در شان نزول این آیه نغل شد

19
0:01:51,020 --> 0:01:53,960
بعد از این که ذات اقدس اله

20
0:01:54,200 --> 0:01:59,840
سبب معفقیت بعضی از مسیح ها را که این فرمود کنه ها

21
0:01:59,980 --> 0:02:06,300
دارای قسیسینن، دارای روحبانن و خوی استکباری ندارن

22
0:02:06,300 --> 0:02:12,980
وقتی آیات الهی را بشنوند خوب درک میکنند و ایمان میاورند

23
0:02:13,520 --> 0:02:18,300
اده از اصحاب پیغمبر صلی اللہ علیه و سلم

24
0:02:18,300 --> 0:02:23,260
در خانه اثمان ابن مزعون دوره هم جمع شدن

25
0:02:23,260 --> 0:02:26,400
تصمیم به رحبانیت گرفتند

26
0:02:26,400 --> 0:02:31,300
تصمیم گرفتند که شبها نخوابند روزها روزه بگیرند

27
0:02:31,300 --> 0:02:37,880
تصمیم گرفتند از بسیاری از قضاهای لذیذ پرهیس کنند و مانند گردند

28
0:02:37,880 --> 0:02:41,680
هر کدام به یک نهوی تعهد خواست داشت

29
0:02:41,680 --> 0:02:46,880
بعضی هم احیانا فکر میکردند که از جامعه منظوی بشند

30
0:02:46,880 --> 0:02:50,680
خبر به پیغمبر صلی اللہ علیه و سلم رسید

31
0:02:50,680 --> 0:02:55,420
وجود امبارک هزارد آمدن منزل اثمان ابن مزعون

32
0:02:55,420 --> 0:02:56,380
از همسری سواله

33
0:02:56,400 --> 0:03:02,360
او نخواست اصرار شوهرش رو پاش کند

34
0:03:02,360 --> 0:03:08,220
و از طرفی هم نخواست که با پیغمبر صلی اللہ علیه و سلم

35
0:03:08,220 --> 0:03:11,160
حق را در میون نگذارد

36
0:03:11,160 --> 0:03:18,300
به حضرت ارز کرد اگر این جریان را اثمان به عرض شمارسون درست بود

37
0:03:18,300 --> 0:03:21,880
چون اثمان رمزعون تعهد کرد که مثلا

38
0:03:21,880 --> 0:03:26,380
اون چی که سنت پیغمبر است در مسائل خانوادگی به نکا

39
0:03:26,380 --> 0:03:27,280
اون را ترک کند

40
0:03:27,280 --> 0:03:33,280
هزارد اونها را خواست و این آیه نازر شد

41
0:03:33,280 --> 0:03:35,840
به این آیه را برانها تلاوت کرد

42
0:03:35,840 --> 0:03:39,200
اون گاه به صورت انتقاد غیر مستقیم

43
0:03:39,200 --> 0:03:42,500
مردم را دعوت کرد در مسجد

44
0:03:42,500 --> 0:03:44,360
و سخنرانی کرد

45
0:03:44,360 --> 0:03:46,700
هفت ما بالو اقوامین

46
0:03:46,700 --> 0:03:49,380
یفعالون کذاب و کذاب و کذاب

47
0:03:49,380 --> 0:03:52,220
همون چرا این چنین ادیه این چنین می کنن

48
0:03:52,220 --> 0:03:54,960
مستقیمن نام اینها را نبود

49
0:03:54,960 --> 0:03:56,260
و با اینها هم

50
0:03:56,380 --> 0:04:00,160
اتاب و خطاب حضوری به این صورت نداشت

51
0:04:00,160 --> 0:04:05,440
همون چرا یک اده حلال خدا را برخود حرام می کنن

52
0:04:05,440 --> 0:04:08,520
اون گاه با نازر شدن این آیه

53
0:04:08,520 --> 0:04:12,040
و قراعت این آیه و تفسیر این آیه

54
0:04:12,040 --> 0:04:15,640
بر این گروه اینا دست برداشتن

55
0:04:15,640 --> 0:04:18,320
البته بعضی ها کم و بیش

56
0:04:18,320 --> 0:04:23,120
اون خلق و خوی زاهدان زندگی کردن را حفظ کردن

57
0:04:23,120 --> 0:04:26,240
ولی بالاخره نوان دست برداشتن

58
0:04:26,240 --> 0:04:28,400
این رو در شعه نزول گفتن

59
0:04:28,400 --> 0:04:31,140
مطالبی که مربوط به آیه قبل است

60
0:04:31,140 --> 0:04:33,420
و همچنین این آیه چند است

61
0:04:33,420 --> 0:04:38,320
اولا رهبانیتی را که قرآن می ستاید

62
0:04:38,320 --> 0:04:41,780
یه رهبانیت محمود و ممدوه است

63
0:04:41,780 --> 0:04:47,260
منای انزبای از جامعه و انسانها نیست

64
0:04:47,260 --> 0:04:50,160
توضیح مطلب این است که گاهی

65
0:04:50,160 --> 0:04:53,060
رهبانیت به عنوان یک

66
0:04:53,060 --> 0:04:56,220
مقام ایمانی مطرح است

67
0:04:56,240 --> 0:04:59,840
گاهی بانوان یک پیشه و حرفه و امثال زن

68
0:04:59,840 --> 0:05:03,220
اونجا که به صورت یک مقام ایمانی مطرح است

69
0:05:03,220 --> 0:05:04,460
آن است که انسان

70
0:05:04,460 --> 0:05:08,880
همه احکام الهی را انجام می دهد

71
0:05:08,880 --> 0:05:12,300
یعنی واجب و مستحب را انجام می دهد

72
0:05:12,300 --> 0:05:14,520
حرام و مقرور ترک می کند

73
0:05:14,520 --> 0:05:19,720
اما منشه این امتصال عوامر و انتهای نواهی

74
0:05:19,720 --> 0:05:23,080
همون رهبت و خوف از خدا است

75
0:05:23,080 --> 0:05:26,080
چنین شخصی راهب و اصفی است

76
0:05:26,240 --> 0:05:27,780
خائف است

77
0:05:27,780 --> 0:05:32,500
همون است که خوفن من النار اینها عبادت می کند

78
0:05:32,500 --> 0:05:35,960
این یک مقامی از مقامات ایمانی است

79
0:05:35,960 --> 0:05:41,260
اما پیشه و حرفه و شغل و امثال زالک نیست

80
0:05:41,260 --> 0:05:43,980
همه دستورات را انجام می دهد

81
0:05:43,980 --> 0:05:47,240
منتها خوفن من الله خوفن من النار

82
0:05:47,240 --> 0:05:52,880
اگر اده این احکام را انجام دادن

83
0:05:52,880 --> 0:05:55,060
برای ترس از آتش

84
0:05:55,060 --> 0:05:56,060
اینای راهبه

85
0:05:56,240 --> 0:05:58,400
راهب زعیفی و متوسطی

86
0:05:58,400 --> 0:06:01,280
اگر این احکام را انجام دادن

87
0:06:01,280 --> 0:06:06,180
برای این که مبادا از لغای خدا محروم باشن

88
0:06:06,180 --> 0:06:09,600
اینای راهب قوی و عالی هستن

89
0:06:09,600 --> 0:06:12,920
اینا همون کسان استن که خداوند در باری اینا

90
0:06:12,920 --> 0:06:15,020
فمدویی یای فرحبون

91
0:06:15,020 --> 0:06:17,700
یا وطقونه یا اولالباب

92
0:06:17,700 --> 0:06:20,720
که اینا از خدا تقوی دارن

93
0:06:20,720 --> 0:06:24,380
اینا راهب خدا هستن

94
0:06:24,380 --> 0:06:25,440
حریم می گیرن

95
0:06:25,440 --> 0:06:26,220
از خدا می گیرن

96
0:06:26,240 --> 0:06:28,240
نه از جهنمی او

97
0:06:28,240 --> 0:06:32,800
نه تقوی اونها برای نجات از جهنم هست

98
0:06:32,800 --> 0:06:34,320
یه وقت فهمد که

99
0:06:34,320 --> 0:06:42,300
اینا تقوی راهبان درجی نازل هست

100
0:06:42,300 --> 0:06:44,760
تقوی خواهفان هست

101
0:06:44,760 --> 0:06:49,300
یه وقت هست که نه

102
0:06:49,300 --> 0:06:51,160
برترین تقوی هست

103
0:06:51,160 --> 0:06:54,240
فمد وطقونه یا اولالباب

104
0:06:54,240 --> 0:06:56,220
رهبتم این چیه؟

105
0:06:56,240 --> 0:06:56,720
این هست

106
0:06:56,720 --> 0:07:01,680
بعضی رهبتشون و حرازشون از جهنم هست

107
0:07:01,680 --> 0:07:07,160
بعضی رهبتشون و حرازشون از هجران لغای حق هست

108
0:07:07,160 --> 0:07:09,260
این که خدا فرمود

109
0:07:09,260 --> 0:07:11,980
و اییای فرحبون

110
0:07:11,980 --> 0:07:14,940
که رهبت را امزا کرد

111
0:07:14,940 --> 0:07:17,740
و منحصر کرد در بار خودش

112
0:07:17,740 --> 0:07:21,840
چون کلمه اییا را مقدم آورد بر ام

113
0:07:21,840 --> 0:07:25,840
این نشانه آن هست که اگر کسی خوفه هجرانه

114
0:07:26,240 --> 0:07:28,220
لغای حق داشته باشد

115
0:07:28,220 --> 0:07:32
این تقریبا آلی ترین مرحله رهبت را دارد

116
0:07:32 --> 0:07:33,600
اما این ها مقام هست

117
0:07:33,600 --> 0:07:37,540
هیچ کدوم پیشه و حرفه و امثال زالک نیست

118
0:07:37,540 --> 0:07:42,120
یه وقت کسی این رو شغل خود قرار میدهد

119
0:07:42,120 --> 0:07:44,820
از جامعه جدا میشود

120
0:07:44,820 --> 0:07:50,420
چنین کار محمود و ممدور نیست اصلا

121
0:07:50,420 --> 0:07:54,260
به قرآنم که این رهبانیت را ستود

122
0:07:54,260 --> 0:07:56,220
به وجود رهبان هستید

123
0:07:56,240 --> 0:07:58,840
این رهبان ها را پسندیدانه است

124
0:07:58,840 --> 0:08:02,160
برای آن هست که این ها تومتن جامعه هستند

125
0:08:02,160 --> 0:08:04,120
مردم را هدایت میکنند

126
0:08:04,120 --> 0:08:07,320
و در اثر این که اصوه مردمان

127
0:08:07,320 --> 0:08:09,880
تومتن زندگی مردمان

128
0:08:09,880 --> 0:08:14,320
اون مردم نسبت به مؤمنین و مسلمون ها

129
0:08:14,320 --> 0:08:16,280
محبت و مبدتی دارد

130
0:08:16,280 --> 0:08:18,960
قرآن کریم که فرمود

131
0:08:18,960 --> 0:08:24,040
و لتجدن اغربهم مبدتن للذین آمن و لذین

132
0:08:24,040 --> 0:08:25,880
قالوا انا نصارا

133
0:08:26,240 --> 0:08:28,260
چند دلیل ذکر

134
0:08:28,260 --> 0:08:32,080
یکی این که زالکه به اند منهم قسیسینه

135
0:08:32,080 --> 0:08:36,760
قسیسین که جمع قس هست به معنای کشیش

136
0:08:36,760 --> 0:08:40,180
اون آلم دینی به محقق دینیست

137
0:08:40,180 --> 0:08:44,080
که مسائل و معارف دین را برای اونها روشن میکند

138
0:08:44,080 --> 0:08:48,260
به نقشی دارد در ایمان اونها

139
0:08:48,260 --> 0:08:49,540
از راه علم

140
0:08:49,540 --> 0:08:54,080
زالکه به اند منهم قسیسینه و رهبانم

141
0:08:54,080 --> 0:08:55,600
خب

142
0:08:56,240 --> 0:08:59,780
چون راهبان در بین اینها هستند

143
0:08:59,780 --> 0:09:03,240
اینها نصفت و مسلمون ها علاقه دارند

144
0:09:03,240 --> 0:09:07
اگر راهب کسی بود که در دیر می نشست

145
0:09:07 --> 0:09:09,300
در سومعه ها به سر می بود

146
0:09:09,300 --> 0:09:11,960
ارتباطی با جامعه نداشت

147
0:09:11,960 --> 0:09:14,180
حضور و قیاب او یک سام بود

148
0:09:14,180 --> 0:09:18,260
او که نمی تمانست نقش تربیتی در جامعه داشته باشد

149
0:09:18,260 --> 0:09:23,800
قرآن اون رهبان ها و اون راهبان را می ستاید

150
0:09:23,800 --> 0:09:25,800
که از دنیا منظوره

151
0:09:26,240 --> 0:09:28,360
باشد نه از خلق خدا

152
0:09:28,360 --> 0:09:30,020
نه از جامعه

153
0:09:30,020 --> 0:09:33,940
از جامعه جدا شدن کار آسانیست

154
0:09:33,940 --> 0:09:38,320
اما از دنیا پاسل گرفتن کار سخت است

155
0:09:38,320 --> 0:09:42,860
انسان برای این که مشکلات جامعه را تحمل نکند

156
0:09:42,860 --> 0:09:45,360
بیمسئولیت زندگی کند

157
0:09:45,360 --> 0:09:49,140
ممکن است در سومعه یا دیری به سر ببرد

158
0:09:49,140 --> 0:09:50,680
این کار آسانیست

159
0:09:50,680 --> 0:09:55,920
ولی اگر بخواهد در محصن جامعه باشد

160
0:09:55,920 --> 0:09:56,220
همین کاری باشد

161
0:09:56,240 --> 0:10:26,220
این کاری باشد

162
0:10:26,240 --> 0:10:28,240
خب

163
0:10:28,240 --> 0:10:30,240
پس درنشینی

164
0:10:31,300 --> 0:10:33,660
و سومعه به سر بردن

165
0:10:33,660 --> 0:10:36,780
به معنای ترک مردم

166
0:10:36,780 --> 0:10:38,460
ممدوح نیست

167
0:10:38,460 --> 0:10:40,480
و قرآن هم این را نستود

168
0:10:40,480 --> 0:10:42,240
اونگاه اگر کنون که

169
0:10:42,860 --> 0:10:46,440
کسی اون وظیفه اصاسی را انجام ندهد

170
0:10:46,440 --> 0:10:49,660
بخواهد از جامعه جدا بشد

171
0:10:49,660 --> 0:10:51,240
چلین کار می شود بدهد

172
0:10:51,760 --> 0:10:54,240
یعنی یک نوعاوری مزموم

173
0:10:54,240 --> 0:10:55,240
خب

174
0:10:56,240 --> 0:10:58,900
دنیا همین مقامات احتباری

175
0:10:58,900 --> 0:11:00,420
که من مقامم این است

176
0:11:00,420 --> 0:11:01,860
این سمت مال من است

177
0:11:01,860 --> 0:11:02,880
من اعلمم

178
0:11:02,880 --> 0:11:03,860
من ازهدم

179
0:11:03,860 --> 0:11:05,140
من فلارف روم بخو

180
0:11:05,140 --> 0:11:07,780
من هرچی به این برمی گردد

181
0:11:07,780 --> 0:11:08,920
این خیرون من

182
0:11:08,920 --> 0:11:10
که حرف شیطان است

183
0:11:10 --> 0:11:10,620
این می شود دنیا

184
0:11:10,620 --> 0:11:11,900
من از او بهترم

185
0:11:11,900 --> 0:11:14,840
اگر کسی گفت من از او بهترم

186
0:11:14,840 --> 0:11:16,840
این پیام شیطان را داره می آمد

187
0:11:16,840 --> 0:11:18,820
بلکه یا دروغ بگوید

188
0:11:18,820 --> 0:11:21
یا اگر راست است نباید بگوید

189
0:11:21 --> 0:11:23,320
اگر بهتر نیست

190
0:11:23,320 --> 0:11:24,300
که می شود دروغ

191
0:11:24,300 --> 0:11:27,140
خب اگر هم واقعا بهتر است

192
0:11:27,140 --> 0:11:28,940
او وظیفه شیطان توازو کند

