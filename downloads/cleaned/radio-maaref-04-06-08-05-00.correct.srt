0:27:39,640 --> 0:27:42,420
برای این که صاحبان نعمت

684
0:27:42,420 --> 0:27:44,080
مورد حسد واقع میشن

685
0:27:44,080 --> 0:27:46,280
پس آیه قرآن میگه

686
0:27:46,280 --> 0:27:47,860
و اما به نعمت ربکه

687
0:27:47,860 --> 0:27:48,580
فهده است

688
0:27:48,580 --> 0:27:50,360
اما اینجا میگه

689
0:27:50,360 --> 0:27:53,600
نعمت ها رو کتمان کنید

690
0:27:53,600 --> 0:27:56,240
برای این که کلر نعمتن

691
0:27:56,240 --> 0:27:58,380
محصود مورد حسد

692
0:27:58,380 --> 0:27:59,260
واقع میشین

693
0:27:59,260 --> 0:28:02,880
برای این که مزاهمت براتون ایجاد نکنن

694
0:28:02,880 --> 0:28:03,820
استعینو

695
0:28:03,820 --> 0:28:06,280
نعمت ها رو پنهان کنید

696
0:28:06,280 --> 0:28:07,960
این تضادیست که

697
0:28:07,960 --> 0:28:10,020
در بد منظر ممکن است

698
0:28:10,020 --> 0:28:11,020
به فکر بیاد

699
0:28:11,020 --> 0:28:13,720
جواب این تضاد معلومه

700
0:28:13,720 --> 0:28:16,200
از همون کلمه محصود معلومه

701
0:28:16,200 --> 0:28:18
اونجایی که افراد

702
0:28:18 --> 0:28:20,080
حسودی دوره برن

703
0:28:20,360 --> 0:28:21,940
اونجا جایی کتمان

704
0:28:21,940 --> 0:28:25,100
اما اگر نه نعمتیست که من بگم

705
0:28:25,100 --> 0:28:26,900
افراد خوشحالم میجن

706
0:28:26,900 --> 0:28:29,540
خداوند این نعمتی رو که داده

707
0:28:29,540 --> 0:28:31,500
باعث خوشحالم و ناعم میشه

708
0:28:31,500 --> 0:28:34,540
مسلم اما به نعمت ربکه

709
0:28:34,540 --> 0:28:35,240
فهده است

710
0:28:35,240 --> 0:28:37,940
اصل بیان نعمت هاست

711
0:28:37,940 --> 0:28:39,220
که مردم

712
0:28:39,220 --> 0:28:41,920
بدانن خداوند

713
0:28:41,920 --> 0:28:43,720
کلان کسو مشمول نعمت کرده

714
0:28:43,720 --> 0:28:45,760
روایت داریم خدا وقتی نعمتی

715
0:28:45,760 --> 0:28:46,940
به کسی دهد

716
0:28:46,940 --> 0:28:49,540
دوست دارد آثارش در رو ظاهر باشد

717
0:28:50,360 --> 0:28:52,320
خداوند غنائی داده

718
0:28:52,320 --> 0:28:54,060
آثار فخر رو به خودش ببنده

719
0:28:54,060 --> 0:28:55,140
نه

720
0:28:55,140 --> 0:28:56,560
این درست نیست

721
0:28:56,560 --> 0:28:58,200
اصراف هم درست نیست

722
0:28:58,200 --> 0:28:59,900
ولی آثار نعمت رو باید

723
0:28:59,900 --> 0:29:01,160
دشان بده

724
0:29:01,160 --> 0:29:04,500
اما اگر دورورشی افراد حسودی

725
0:29:04,500 --> 0:29:06,620
اینجا استعینو

726
0:29:06,620 --> 0:29:08,480
علام امورکن بالکتمان

727
0:29:08,480 --> 0:29:10,200
فهد نکن لذی نعمتین

728
0:29:10,800 --> 0:29:12,580
محسود

729
0:29:12,580 --> 0:29:14,320
بر این که مورد حسد

730
0:29:14,320 --> 0:29:15,240
واقع نشین

731
0:29:15,240 --> 0:29:16,060
نکه دوم

732
0:29:16,060 --> 0:29:19,200
و اما یه نکه ثبوم مهم میهم

733
0:29:19,200 --> 0:29:20,200
به دلاله

734
0:29:20,360 --> 0:29:22
ایلتزامیه

735
0:29:22 --> 0:29:24,440
از این حدیث استفاده میشود

736
0:29:24,440 --> 0:29:26
به این نکته ثبوم هم

737
0:29:26 --> 0:29:28,020
توجهت بفرمایی

738
0:29:28,020 --> 0:29:31
وان این است که

739
0:29:31 --> 0:29:32,940
همانگونه که گناه

740
0:29:32,940 --> 0:29:33,840
بده

741
0:29:33,840 --> 0:29:36,600
فراهم آوردن

742
0:29:36,600 --> 0:29:39,200
زمینه گناه دیگرانم بده

743
0:29:39,200 --> 0:29:41,120
من نباد

744
0:29:41,120 --> 0:29:42,740
کار کنم مردم به گناه

745
0:29:42,740 --> 0:29:43,200
بیفتم

746
0:29:43,200 --> 0:29:44,820
گناه بده

747
0:29:44,820 --> 0:29:47,280
یا من که گناه نکردم

748
0:29:47,280 --> 0:29:50,140
تو چرا کاری میکنی که زمینه

749
0:29:50,140 --> 0:29:52,140
گناه دیگران فراهم بشه

750
0:29:52,140 --> 0:29:54,140
هینا مثل این است

751
0:29:54,140 --> 0:29:55,920
که من

752
0:29:55,920 --> 0:29:58,740
کاری کنم که مردم به قیبت خودم میاندازم

753
0:29:58,740 --> 0:29:59,980
کارهای
