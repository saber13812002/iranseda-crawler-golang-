1
0:00:00 --> 0:00:05,020
که در روی کره زمین با ارزشمندتر از انسان کسی نیست

2
0:00:05,020 --> 0:00:09,960
وقتی دو تا انسان که قلب‌هایشان را خدا طراحی کرده

3
0:00:09,960 --> 0:00:11,500
که به سوی خودشون باشه

4
0:00:11,500 --> 0:00:13,840
که یه بخشی از این به سوی خدا بودن

5
0:00:13,840 --> 0:00:16,340
توجه به قلب‌های دیگرانه

6
0:00:16,340 --> 0:00:18
توجه به قلب اطرافیانه

7
0:00:18,580 --> 0:00:19,780
توجه به مردمه

8
0:00:19,780 --> 0:00:21,120
توجه به والدینه

9
0:00:21,120 --> 0:00:23,780
توجه به همسر و بچه و دیگرانه

10
0:00:23,780 --> 0:00:28
وقتی دو تا قلبی که باید با توجه کردن به همدیگه

11
0:00:28 --> 0:00:30,240
رو به خدا بشن

12
0:00:30,240 --> 0:00:35,100
الان یه مقداری زاویه گرفتن و خدایی نکرده دارن میرن به سمت شیطان

13
0:00:35,100 --> 0:00:37
انقدر این انسان مهمه

14
0:00:37,640 --> 0:00:40,560
که نمیتونه بی‌تفاوت باشه

15
0:00:40,560 --> 0:00:43
میگه این انسان گناهکارترینشون

16
0:00:43,860 --> 0:00:45,260
گناهکارترینشون

17
0:00:45,260 --> 0:00:46,720
باید هم عزیزه

18
0:00:46,720 --> 0:00:48,280
باید من کاری کنم

19
0:00:48,280 --> 0:00:52,920
که قلب‌ها به هم نزدیک شدن به خدا برسن

20
0:00:52,920 --> 0:00:55,320
ما ترابان روایات بریم که

21
0:00:55,320 --> 0:00:57,760
وقتی مؤمنین همو بغل میکنن

22
0:00:57,760 --> 0:00:59,240
دست به همو میگیرند

23
0:00:59,240 --> 0:01:01,260
وقتی احوال‌پرسی کنن

24
0:01:01,260 --> 0:01:03,040
شیطان نعره میزنه

25
0:01:03,040 --> 0:01:04,980
و وقتی اینا دست به هم نمیدن

26
0:01:04,980 --> 0:01:06,680
روشون از هم بر میگردونن

27
0:01:06,680 --> 0:01:08,500
شیطان خنده میکنه

28
0:01:08,500 --> 0:01:09,640
قهقه میکنه

29
0:01:09,640 --> 0:01:13,640
این شیطان لعین دوتا آدمو از هم جدا نکرده

30
0:01:13,640 --> 0:01:16,320
دوتا آدمو از خدا جدا کرده

31
0:01:16,320 --> 0:01:17,480
این دست کنیتا

32
0:01:17,480 --> 0:01:19,780
وقتی دوتا آدم قهر میکنن

33
0:01:19,780 --> 0:01:21,540
از هم جدا نشدن

34
0:01:21,540 --> 0:01:23,300
برن از خدا جدا میشن

35
0:01:23,300 --> 0:01:25,280
و شیطان کیف میکنه

36
0:01:25,280 --> 0:01:28,800
به انسان مومن این سحنه براش خیلی دردابره

37
0:01:28,800 --> 0:01:33,080
به خاطر همین اگر خودشون یک دعوا باشند

38
0:01:33,080 --> 0:01:36
حتما کار میکنن که با طرف آشتی کنن

39
0:01:36 --> 0:01:37,480
چنان که طور باید داریم

40
0:01:37,480 --> 0:01:39,420
وقتی امام حسین علیه السلام

41
0:01:39,420 --> 0:01:43,320
با محمد بن حنفیه برادر ناتنیش به یک مشکلی برخورد

42
0:01:43,320 --> 0:01:44,760
یک مشکل کلامی داشتن

43
0:01:44,760 --> 0:01:46,500
از هم ناراحت شدن

44
0:01:46,500 --> 0:01:49,620
خب توی یک اختلافی که یه طرف امام معصومه

45
0:01:49,620 --> 0:01:51,800
یه طرف غیر معصومه

46
0:01:51,800 --> 0:01:53,160
کی حقه

47
0:01:53,160 --> 0:01:54,840
خب مشخص امام معصوم

48
0:01:54,840 --> 0:01:57,640
کسی که ماینتقا ان الحوا

49
0:01:57,640 --> 0:01:59,680
کسی که بر اساس هواهوت

50
0:01:59,680 --> 0:02:01,500
و خطا حرف نمیزنه

51
0:02:01,500 --> 0:02:02,520
عمل نمی کنه

52
0:02:02,520 --> 0:02:05,100
خب امام حسین بزرگتره

53
0:02:05,100 --> 0:02:06,940
محمد بن حنفیه کوچیکتره

54
0:02:06,940 --> 0:02:08,840
چه اتفاقی افتاد

55
0:02:08,840 --> 0:02:11,160
وقتی محمد بن حنفیه از امام حسین

56
0:02:11,160 --> 0:02:12,400
با ناراحتی جدا شد

57
0:02:12,400 --> 0:02:13,860
رفت خونه نامه نوشت

58
0:02:13,860 --> 0:02:15,560
خب حسین تو از من بزرگتری

59
0:02:15,560 --> 0:02:17,660
تو از من کریمتری

60
0:02:17,660 --> 0:02:18,400
مهربانتری

61
0:02:18,400 --> 0:02:20,280
نگذار من به سمت تو بیام

62
0:02:20,280 --> 0:02:21,320
برای آشتی کردن

63
0:02:21,320 --> 0:02:24,300
تو بیا ای بابا هم کوچیکتره

64
0:02:24,300 --> 0:02:25,840
هم مقصدرتره

65
0:02:25,840 --> 0:02:27,560
به برادر بزرگش

66
0:02:27,560 --> 0:02:29,480
که حق همه هست میگه تو بیا

67
0:02:29,480 --> 0:02:31,300
امام حسین تا نامه رو شنید

68
0:02:31,300 --> 0:02:33,300
ایلا فاصله بلند شد رفت

69
0:02:33,300 --> 0:02:34,620
گذارن آقا اون مقصده

70
0:02:34,620 --> 0:02:37,700
مقصدر باشه من بزرگترم

71
0:02:37,700 --> 0:02:38,820
من کریمترم

72
0:02:38,820 --> 0:02:40,260
این سیر مهمه

73
0:02:40,260 --> 0:02:42,640
اگه یه دعوی خودش باشه

74
0:02:42,640 --> 0:02:44,240
که حتما این کارو میکنه

75
0:02:44,240 --> 0:02:46,500
اگر خودش یه ذل دعوی نباشه

76
0:02:46,500 --> 0:02:48,060
میبینی دو نفر دارن دعوی میکنن

77
0:02:48,060 --> 0:02:49,800
دوتا برادر دوتا رفیق

78
0:02:49,800 --> 0:02:50,900
میاد ورسد

79
0:02:50,900 --> 0:02:53,860
یادآوری زیبایی های انسان ها رو میکنه

80
0:02:53,860 --> 0:02:55,600
یادآوری خوبی هایی که با هم بودن

81
0:02:55,600 --> 0:02:58,260
بعد همتا کمک میکنه که چی؟

82
0:02:58,260 --> 0:03:00,180
از خودش بزن من آدم میشناختم

83
0:03:00,180 --> 0:03:02,340
که یه هزینه مالی

84
0:03:02,340 --> 0:03:03,960
به یه نفرداد

85
0:03:03,960 --> 0:03:05,520
که اون مشکل مالیش حل بشه

86
0:03:05,520 --> 0:03:07,740
تو داداشش رفیق بشه

87
0:03:07,740 --> 0:03:09,560
ببین خیلی مهم نور

88
0:03:09,560 --> 0:03:12,300
یه نفرداد هزینه مالی خودش خرد کرد

89
0:03:12,300 --> 0:03:13,820
که دعوی مالی

90
0:03:13,820 --> 0:03:15,740
دوتا برادر رو چرا کنه

91
0:03:15,740 --> 0:03:17,020
حل بکنه

92
0:03:17,020 --> 0:03:18,440
این علاوه ایمانه

93
0:03:18,440 --> 0:03:21,200
این یعنی میفهمه دوتا مؤمن

94
0:03:21,200 --> 0:03:24,080
چقدر حوای همدیگر رو داشته باشن

95
0:03:24,080 --> 0:03:26,020
درسته خیلی ممنونم

96
0:03:26,020 --> 0:03:27,660
خیلی متشکرم از شما

97
0:03:27,660 --> 0:03:29,560
و الهی که

98
0:03:30,320 --> 0:03:31,560
به واسطه

99
0:03:32,200 --> 0:03:34,360
ایامی که پیش رو داریم

100
0:03:34,360 --> 0:03:35,600
خبرهای خوش

101
0:03:35,600 --> 0:03:37,220
در خانواده هایی بپیچه

102
0:03:37,220 --> 0:03:38,900
که مدتیه شاید

103
0:03:38,900 --> 0:03:41,140
شیشه قلبشون

104
0:03:41,140 --> 0:03:42,340
کدورت گرفته

105
0:03:42,340 --> 0:03:45,200
و حالا احوال دوستی

106
0:03:45,200 --> 0:03:47,020
و رفاقت و با هم بودن

107
0:03:47,020 --> 0:03:48,400
در خانواده هاش باشه

108
0:03:48,400 --> 0:03:49,600
بفرماییم

109
0:03:49,600 --> 0:03:51,200
سلام

110
0:03:51,200 --> 0:03:52,860
امام باقر علیه السلام

111
0:03:52,860 --> 0:03:55,020
باید خونه شدید کنید

112
0:03:55,020 --> 0:03:56,660
بچه رو برده بالا پشت بود

113
0:03:56,660 --> 0:03:58,900
با این که امام قبلن نهیش کرده بود

114
0:03:58,900 --> 0:04:00,640
بچه از بالا افتاده بود

115
0:04:00,640 --> 0:04:01,880
ضرب مغزی شده بود

116
0:04:01,880 --> 0:04:02,720
فوت کرده بود

117
0:04:02,720 --> 0:04:06,020
تا امام باقر رو دید این آیه رو خوند

118
0:04:06,020 --> 0:04:07,400
ول کازمین القیس

119
0:04:07,400 --> 0:04:09,120
خشمشون و مؤمنه فرو میخورن

120
0:04:09,120 --> 0:04:10,540
از از فرمون من خشم ندارم

121
0:04:10,540 --> 0:04:12,380
فرمون ول آفین ان اناست

122
0:04:12,380 --> 0:04:13,840
از از فرمون بخشیده من

123
0:04:13,840 --> 0:04:16,600
گفت انالله یهب بل محسنی

124
0:04:16,600 --> 0:04:18,380
گفت در راه خدا

125
0:04:18,380 --> 0:04:19,300
آزادت کردم

126
0:04:19,300 --> 0:04:20,820
ببین بچه شو کشته

127
0:04:20,820 --> 0:04:22,540
خشمشون نمی کنه

128
0:04:22,540 --> 0:04:25,060
در درونم میبخشه و آزادش میکنه

129
0:04:25,060 --> 0:04:27,360
مومد انقدر مهربان باشیم

130
0:04:27,360 --> 0:04:29
نسبت به اطرافیان ما

131
0:04:29 --> 0:04:31,800
خیلی ممنونم و چکرم از طرف ما هم

132
0:04:31,800 --> 0:04:34,100
سلام بدید به آقا امام رزا

133
0:04:34,100 --> 0:04:35,680
امام مهربانی ها

134
0:04:35,680 --> 0:04:37,540
خدا نگهدارتون باشه

135
0:04:37,540 --> 0:04:38,800
و

136
0:04:38,800 --> 0:04:41,120
یه تبریک ویژه

137
0:04:41,120 --> 0:04:43,180
به مناسبت دهه کرامت

138
0:04:43,180 --> 0:04:44,900
ولادت آقا امام رزا

139
0:04:44,900 --> 0:04:47,200
