ا انکم ملاقوه و بشر المؤمنین زنان شما کشتزار شمایند هر جا و هر گاه که بخواهید بکشت زار خود درائید و با آنان آمیزش نمایید و با پرورش فرزندان صالح اثر نینکی برای خود از پیش بفرستید و از مخالفت فرمان خدا پروا کنید و بدانید که او را ملاقات خواهید کرد و به مؤمنان بشارت ده و خدا را دستاویز سوگندهای خود قرار مدهید تا بدین بهانه از نیکوکاری و پرهیزکاری و سازشدارن میان مردم شان خالی کنید همانا خداوند شنواف و داناست لا یواخذكم الله باللغو فی ایمانیکم ولیکن یواخذكم بما کسبت قلوبكم و الله غفور حلیم خداوند شما را به خاطر سوگندهای بیهوده و بدون قصد بازخواست نمی کند اما به آن که دلهای شما از روی اراده و آگاهی قصد کرده بازخواست می کند و خداوند آمرزنده و بردبار است لِلَّذِينَ يُعْلُونَ مِنْ نِسَائِهِمْ تَرَبُّصُ اَرْبَعَةِ اَشْهُرٍ فَإِنْ فَاءُوا فَإِنَّ اللَّهَ غَفُورٌ رَحِيمٌ وَإِنْ عَزَمُوا الطَّلَاقَ فَإِنَّ اللَّهَ سَمِيعٌ عَلِيمٌ کسانی که به قصد آزار همسر سوگند می خورند که با زنان خیش نیا می زند باید چهار ماه انتظار بکشند پس اگر از سوگند خود دست برداشته و به آشتی برگشتند چیزی برانها نیست و خداوند آمرزنده و مهربان است و اگر تصمیم به طلاق گرفتند بدانند که خدا شنواب و داناست موسیقی در موسیقی درسته زنان طلاق داده شده باید تا سه مرتب عادت ماهان دیدن و پاک شدن انتظار بکشند و عده نگه دارند. و اگر به خدا و روز رستاخیز ایمان دارند برای آنها ربا نیست که آنچرا خدا در رحم آنها آفریده است کتمان کنند. و شوهرانشان اگر سر آشتی دارند به بازاوردن آنها در این مدت از دیگران سزابارترند و برای زنان در برابر وظایفی که بر احد دارند حقوق شایستهی مقرر گردیده است و برای مردان نسبت به آنان وظایف و حقوقی افزونتر است و خداوند تبانا و حکیم است راست گفت خداوند والای بزرگ شنوندگان عزیز در برنامه امروز تنین وحی شنونده تلاوت و ترجمه آیات شریفه دویست و هجده تا دویست و بیست و هشت سوره مبارکه بغره بودید شما میتونین نرمفضار و صوت کامل این برنامه رو از ویبگاه تنین وحی نقطه کام و یا کانال رادیو معارف در فضای مجازی دریافت کنید تا فردا خدا نگهدار