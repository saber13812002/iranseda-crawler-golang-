0:07:59,900 --> 0:08:01,740
پایین. مثلا شما تصور

43
0:08:01,740 --> 0:08:04,180
بکن یه مادری که افسرده است

44
0:08:04,180 --> 0:08:05,660
کارایی جسمیش میاد پایین

45
0:08:05,660 --> 0:08:07,100
آتفیش میاد پایین

46
0:08:07,100 --> 0:08:09,560
فکریش میاد پایین

47
0:08:09,560 --> 0:08:11,060
حتی کلامیش میاد پایین

48
0:08:11,060 --> 0:08:13,600
اجتماعیش میاد پایین

49
0:08:13,600 --> 0:08:15,200
یعنی یه فردی که دوچار آسیب روحی میشه

50
0:08:15,200 --> 0:08:17,700
کارایی‌ش میاد پایین

51
0:08:17,700 --> 0:08:19
خب نمی‌تونه نقش تربیتی خوبی رو

52
0:08:19 --> 0:08:21,740
ایفا بکنه

53
0:08:21,740 --> 0:08:22,980
من یه نکته‌ای رو حالا تو جنبه‌ای

54
0:08:22,980 --> 0:08:25,160
این دوتا عرصه بکنم

55
0:08:25,160 --> 0:08:27,580
ولی باز برمی‌گیم با اینا کار داریم

56
0:08:27,580 --> 0:08:29,260
شما می‌دونید ما در روایت داریم

57
0:08:29,260 --> 0:08:30,820
قاضی وقتی می‌خواد بر مسند

58
0:08:30,820 --> 0:08:33,120
قضاوت بنشینه

59
0:08:33,120 --> 0:08:34,020
یعنی فقط می‌خواد قضاوت، کار تربیتی هم

60
0:08:34,020 --> 0:08:36,920
نمی‌خواد بکنه

61
0:08:36,920 --> 0:08:39,440
یعنی دریافتایی داشته، این دریافتا رو

62
0:08:39,440 --> 0:08:40,880
تحلیل بکنه، از اینا برای‌گیری

63
0:08:40,880 --> 0:08:43,660
بکنه، یه حکمی ساده

64
0:08:43,660 --> 0:08:45,040
می‌گه مسانت پره، نباید بری بشینه

65
0:08:45,040 --> 0:08:46,420
بر مسند قضاوت

66
0:08:46,420 --> 0:08:49,540
تأثیر می‌سازه

67
0:08:49,540 --> 0:08:50,780
این عمر کچی

68
0:08:50,780 --> 0:08:52,400
که باید قد ممکنه ما

69
0:08:52,400 --> 0:08:54,920
بی‌تفاوت باشیم

70
0:08:54,920 --> 0:08:57,320
حالا مادری که به مراتب

71
0:08:57,320 --> 0:08:59,580
کارش عرضش منتر از ای قاضیه

72
0:08:59,580 --> 0:09:00,700
داره کار تربیت انجام میده

73
0:09:00,700 --> 0:09:02,600
حالا شما می‌دونید

74
0:09:02,600 --> 0:09:04,720
مادر به جسمش نرسه

75
0:09:04,720 --> 0:09:05,760
مادر به روح و روان

76
0:09:05,760 --> 0:09:08,140
خودش نرسه

77
0:09:08,140 --> 0:09:09,720
خب نمی‌تونه نشاف‌رینی بکنه

78
0:09:09,720 --> 0:09:12,680
و اینه که ما می‌گیم

79
0:09:12,680 --> 0:09:14,100
قدیم مادرها شاید خیلی توجه

80
0:09:14,100 --> 0:09:16,340
مرزواد نداشتن

81
0:09:16,340 --> 0:09:17,960
آخه برقی این رو زیادم ما می‌پرسن

82
0:09:17,960 --> 0:09:19,660
من خب مادرهای قدیم هم

83
0:09:19,660 --> 0:09:21,460
بچه‌هاشون تربیت میشنن

84
0:09:21,460 --> 0:09:23,340
من یه تعبیری دارم

85
0:09:23,340 --> 0:09:25,360
حالا اینم باز نیازه به یک

86
0:09:25,360 --> 0:09:28,360
موشکافانه بررسی بکنیم

87
0:09:28,360 --> 0:09:30,460
و باز بکنیم برای شنواندگان دارم

88
0:09:30,460 --> 0:09:32,260
قدیم سبک زندگی

89
0:09:32,260 --> 0:09:34,300
میومد به کمک تربیت

90
0:09:34,300 --> 0:09:35,580
ما چون سبک زندگی رو هم

91
0:09:35,580 --> 0:09:38,460
دستکاری کردیم

92
0:09:38,460 --> 0:09:39,440
املا از اون فرصه سبک زندگی

93
0:09:39,440 --> 0:09:41,320
داریم

94
0:09:41,320 --> 0:09:43,540
محروم میشیم

95
0:09:43,540 --> 0:09:45,180
اتوان داره آنتیشم عمل میکنه

96
0:09:45,180 --> 0:09:47,180
زدشم عمل میکنه

97
0:09:47,180 --> 0:09:48,600
مثلا چطورا دیگه نمونه

98
0:09:48,600 --> 0:09:50,500
دم دستی بگم

99
0:09:50,500 --> 0:09:53,920
برای شنواندگان خب

100
0:09:53,920 --> 0:09:54,140
مثلا این سیرویس‌های بهداشه قدیم بود کنار حیات بود

101
0:09:54,140 --> 0:09:57,180
بله

102
0:09:57,180 --> 0:09:58,300
میدونی اینا چقدر آثار تربیتی داشت به خودی خود

103
0:09:58,300 --> 0:10:00,600
اجا

104
0:10:00,600 --> 0:10:02,320
بله بچه‌ها رو شجابار میابرد

105
0:10:02,320 --> 0:10:04,640
تاباورشون رو میبرد بالا

106
0:10:04,640 --> 0:10:06,620
یه جایی مثلا همین آفتابه‌ها

107
0:10:06,620 --> 0:10:08,860
که میخواستن خودشون رو باشد بشونن

108
0:10:08,860 --> 0:10:10,560
تمرکزشون رو میبرد بالا

109
0:10:10,560 --> 0:10:12,660
دقتشون رو میبرد بالا

110
0:10:12,660 --> 0:10:14,920
یعنی شما توی یه سبک زندگی

111
0:10:14,920 --> 0:10:16,940
خودش آثار تربیتی داشت

112
0:10:16,940 --> 0:10:18,460
ولی الان ما توالت‌ها رو برداشتیم

113
0:10:18,460 --> 0:10:21,020
او بردیم تو اتاق‌ها قرار داریم

114
0:10:21,020 --> 0:10:24,080
اتاق مصدر برای بچه درست میکنیم

115
0:10:24,080 --> 0:10:25,760
باشه‌ها تو تخ میذاریم تو سیرویس بهداشتیم

116
0:10:25,760 --> 0:10:27,920
میدونی نه دیگه اون شجاعته رو داره

117
0:10:27,920 --> 0:10:29,460
نه اون تاباوریه رو داره

118
0:10:29,460 --> 0:10:31,140
نه دقت و تمرکز داره

119
0:10:31,140 --> 0:10:33,060
ولی قدیم اینجوری

120
0:10:33,060 --> 0:10:34,160
حالا مثلا بچه شلنگ آب تو توبه داره

121
0:10:34,160 --> 0:10:36,600
در دیوار میکاشی

122
0:10:36,600 --> 0:10:38,640
یعنی تمنخوضش هم به هم میریزه

123
0:10:38,640 --> 0:10:40,600
ولی قدیم اوقعا اینجوری نبوده

124
0:10:40,600 --> 0:10:43,360
بچه‌ها متمرکز میشدن

125
0:10:43,360 --> 0:10:45,440
همین اخیرم من این بحثی رو یه جایی میگفتم

126
0:10:45,440 --> 0:10:46,980
در میبهدنگ بابا جا خیلی دقیق

127
0:10:46,980 --> 0:10:49,580
شما گفتیم راست میگیم

128
0:10:49,580 --> 0:10:51,260
ما میشه هستیم توی سیرویس بهداشتیم

129
0:10:51,260 --> 0:10:53,700
موبایل اینا که به خودم نمیبارد

130
0:10:53,700 --> 0:10:54,560
یه مرچه کفی مزایق داشت

131
0:10:54,560 --> 0:10:57,180
حرکت میکن

132
0:10:57,180 --> 0:10:58,760
تمام دقت همون میرن روی این

133
0:10:58,760 --> 0:11:00,580
که این داره چی کار میکنه

134
0:11:00,580 --> 0:11:01,920
اما اگه یه آبی میرخیم دورش ببینیم

135
0:11:01,920 --> 0:11:03,820
و سرم چجوری میتونه

136
0:11:03,820 --> 0:11:07,020
آثار داشت

137
0:11:07,020 --> 0:11:09,040
ما اینا رو حسبش کریم از زندگی‌های بچه‌ها

138
0:11:09,040 --> 0:11:11,240
اینجاست که اون وقت

139
0:11:11,240 --> 0:11:12,700
ما نیاز داریم پدر و مادر

140
0:11:12,700 --> 0:11:14,660
روی کردشون

141
0:11:14,660 --> 0:11:16,380
نسبت به قبل تغییر بدن

142
0:11:16,380 --> 0:11:17,980
خب اینجاست که ما میگیم

143
0:11:17,980 --> 0:11:20,280
مادر باید عبر مادر بشه

144
0:11:20,280 --> 0:11:22,880
میگیم سلامت جسمش رو باید داشته باشه

145
0:11:22,880 --> 0:11:25,120
سلامت روی و روانیش رو باید داشته باشه

146
0:11:25,120 --> 0:11:26,540
یعنی همه اون بار سبک زندگی

147
0:11:26,540 --> 0:11:27,800
که الان دیگه نیست

148
0:11:27,800 --> 0:11:29,600
و تغییر کرده

149
0:11:29,600 --> 0:11:33,020
باید پدر و مادر جبران بکنه

150
0:11:33,020 --> 0:11:34,960
یعنی امرو ببینیم مادر باید این مادر خوشفکر باشه

151
0:11:34,960 --> 0:11:36,680
که بتونه امرو

152
0:11:36,680 --> 0:11:39,020
تاباوری و چربه بره بالا

153
0:11:39,020 --> 0:11:39,940
چرا تو اون سیرویس بهترشی هر دیگه نداریم

154
0:11:39,940 --> 0:11:42,040
کنار حیاتی

155
0:11:42,040 --> 0:11:44,600
امرو باید جور فکریش

156
0:11:44,600 --> 0:11:46,360
و تولید مهدوار مادر بکشه

157
0:11:46,360 --> 0:11:47,880
خب ببینیم

158
0:11:47,880 --> 0:11:49,760
یا موارد دیگه

159
0:11:49,760 --> 0:11:51,420
مثلا بچه‌ها قدیم میرفتن

160
0:11:51,420 --> 0:11:54,760
واقعا بازی میکردن

161
0:11:54,760 --> 0:11:56,360
نمیدونم حالا شما هیدرزاد سنه چندید

162
0:11:56,360 --> 0:11:57,340
به سنه ما میخورید

163
0:11:57,340 --> 0:12:00,520
نه مطمئن نه

164
0:12:00,520 --> 0:12:01,340
ما از تجربیات شما استفاده میکنیم

165
0:12:01,340 --> 0:12:03,600
مثلا ما قدیم

166
0:12:03,600 --> 0:12:06,100
کتونی چینی‌ها برامون میفردید

167
0:12:06,100 --> 0:12:10,700
شما پس سنتون نزدیکه

168
0:12:10,700 --> 0:12:11,560
یعنی اینقدر باید میدویدیم

169
0:12:11,560 --> 0:12:13
بازی میکردیم

170
0:12:13 --> 0:12:13,580
سر هفته نشد

171
0:12:13,580 --> 0:12:14,840
دو هفته نشد

172
0:12:14,840 --> 0:12:19,100
کفه سراخ میشد

173
0:12:19,100 --> 0:12:22,180
بچه‌ها کتونی‌ها کچیکشون میشه

174
0:12:22,180 --> 0:12:23,060
نو میشه کلکسیون ازش تشکیل داد

175
0:12:23,060 --> 0:12:24,400
حالا ببینیم

176
0:12:24,400 --> 0:12:25,480
اون بچهی که قدیم میرفت

177
0:12:25,480 --> 0:12:27,820
بودو بودون میکن

178
0:12:27,820 --> 0:12:29,640
راحت هم بود مادر هم کمردر

179
0:12:29,640 --> 0:12:32,080
کنار خونه خابیته بود

180
0:12:32,080 --> 0:12:33,740
بسیار سفکی زندگی داشت کمک ندارد

181
0:12:33,740 --> 0:12:35,140
بلی اعلام چی مادره میدید

182
0:12:35,140 --> 0:12:36,400
که بچهی نمیره بازی کنه

183
0:12:36,400 --> 0:12:38,180
باید پا به پا این بچه

184
0:12:38,180 --> 0:12:40,160
بچه رو روزانه ببره پارک

185
0:12:40,160 --> 0:12:41,360
بشینه اونجا این بچه بره

186
0:12:41,360 --> 0:12:42,500
چرخبلک سوارشه

187
0:12:42,500 --> 0:12:43,480
سور سوارشه

188
0:12:43,480 --> 0:12:44,700
تاب سوارشه

189
0:12:44,700 --> 0:12:45,220
بودو بودو بکنه

190
0:12:45,220 --> 0:12:47,180
یعنی ببینیم

191
0:12:47,180 --> 0:12:49,220
مادر جسمش حالا ملازم داره

192
0:12:49,220 --> 0:12:51,040
که بیاد به کمک تربیت بچه

193
0:12:51,040 --> 0:12:53,580
بلی مادر قدیم نه

194
0:12:53,580 --> 0:12:54,820
فرش دوازانتی هم شب دستباب میداخت

195
0:12:54,820 --> 0:12:56,340
کف حیات میشست

196
0:12:56,340 --> 0:12:59,160
پهنم میکرد

197
0:12:59,160 --> 0:13:01,060
اکمردردم تا شیش ماه

198
0:13:01,060 --> 0:13:03,140
خدمت شما هر کام داشت می نالید

199
0:13:03,140 --> 0:13:05,020
بلی بچه سبک زندگی داشت

200
0:13:05,020 --> 0:13:06,500
کمکش میکرد تربیت میکرد

201
0:13:06,500 --> 0:13:08,340
این دوست هم چون بعدن

202
0:13:08,340 --> 0:13:10,300
نیاز به راهکارم داره

203
0:13:10,300 --> 0:13:11,740
باید من اشاره بکنم انشالله

204
0:13:11,740 --> 0:13:14,520
و در برنامه برنامه

205
0:13:14,520 --> 0:13:17,120
خیلی ممنونم از شما جماعه بستاد

206
0:13:17,120 --> 0:13:18,740
نکته‌ها فکر میکنم خیلی هم کار بردیه

207
0:13:18,740 --> 0:13:21,480
یعنی خانواده‌ها

208
0:13:21,480 --> 0:13:23,280
اگر پیگیری کنن برنامه پرسنوان تربیتی

209
0:13:23,280 --> 0:13:24,940
رو میتونن از راهکاره

210
0:13:24,940 --> 0:13:26,900
که شما میگید به صورت

211
0:13:26,900 --> 0:13:29,060
عملی استفاده بکنن چیزی نیست که روی

212
0:13:29,060 --> 0:13:30,280
کاغذ باشه و حالا تو گفتگو

213
0:13:30,280 --> 0:13:32
فقط مطرح شده باشه

