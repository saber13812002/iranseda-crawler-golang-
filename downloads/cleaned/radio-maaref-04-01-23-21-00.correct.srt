0:25:34,200 --> 0:25:35,460
سحنه اول

367
0:25:35,460 --> 0:25:37,900
رامین با دیدن خبری در تلویزیون

368
0:25:37,900 --> 0:25:41,040
در باری فقر و گروسنگی در برخی کشورها

369
0:25:41,040 --> 0:25:42,900
روبه پدرش میکنه و میپرسه

370
0:25:43,480 --> 0:25:47,900
بابا جون چرا خدا روزی بعضی ها رو اینقدر کم در نظر گرفته

371
0:25:47,900 --> 0:25:52,180
ولی برای بعضی ها دیگه چندین برابرش رو در نظر گرفته

372
0:25:52,180 --> 0:25:55,420
حالا بازم هی بگو که خدا آدله و ادالت داره

373
0:25:55,420 --> 0:25:56,500
سحنه دوم

374
0:25:56,500 --> 0:25:57,900
بابای رامین پامیشه

375
0:25:57,900 --> 0:25:59,680
گوشی همراهش رو میاره

376
0:25:59,680 --> 0:26:02,660
و همچنان که با گوشی داره ورمیره

377
0:26:02,660 --> 0:26:03,920
به رامین میگه

378
0:26:03,920 --> 0:26:04,880
ببین پسرم

379
0:26:04,880 --> 0:26:06,580
استاد محمدی شاهرودی

380
0:26:06,580 --> 0:26:10,100
توی یه دقیقه به سؤال تو جواب دادن

381
0:26:10,100 --> 0:26:10,960
بیا اینجا بشین

382
0:26:10,960 --> 0:26:13,280
بیا کنار من بشین با هم گوش بدیم

383
0:26:13,280 --> 0:26:14,520
چند نکته هست نکته

384
0:26:14,520 --> 0:26:17,480
اولین که روزی اینها رو یه عده دیگه

385
0:26:17,480 --> 0:26:18,960
به ناحق از اونها گرفتن

386
0:26:18,960 --> 0:26:21,600
روزی افریقایی رو اروپایی و امریکایی

387
0:26:21,600 --> 0:26:23,580
قصف کردن به زور از اونها گرفتن

388
0:26:23,580 --> 0:26:26,740
با قطعی فلحیل و با استعمار

389
0:26:26,740 --> 0:26:27,740
استسمار

390
0:26:27,740 --> 0:26:30,340
روزی اونها رو گرفتن و اونها رو محروم کردن

391
0:26:30,340 --> 0:26:31,860
از اون که خدا باشن قدر کردن

392
0:26:31,860 --> 0:26:33,500
هر اون چی که در دنیا هست

393
0:26:33,500 --> 0:26:34,500
همش محدوده

394
0:26:34,500 --> 0:26:35,260
و میشه این

395
0:26:35,260 --> 0:26:40,660
چی که نازر شده با قدر معلوم هست

396
0:26:40,660 --> 0:26:42,020
جهت دومی این که

397
0:26:42,020 --> 0:26:44,260
خب گاهی ممکنه خود اون کسانی که

398
0:26:44,260 --> 0:26:45,800
بزرگ نامناسبی دارن

399
0:26:45,800 --> 0:26:47,600
فقر و فلاکت دارن

400
0:26:47,600 --> 0:26:49,060
خاطر کتایی خودشونه

401
0:26:49,060 --> 0:26:50,440
حقشون رو استفاده نکردن

402
0:26:50,440 --> 0:26:51,560
حقشون رو نگرفتن

403
0:26:51,560 --> 0:26:52,460
کار نکردن

404
0:26:52,460 --> 0:26:54,760
بله خداوند روزی مقدر کرده

405
0:26:54,760 --> 0:26:56,640
اما گفتی باید بید دنبالش

406
0:26:56,640 --> 0:26:57,820
نقطه آخر این که

407
0:26:57,820 --> 0:27:00,840
روزی رو فقط به روزی مادی ما منحصر نبین

408
0:27:00,840 --> 0:27:03,660
ممکنه بعض از افراد روزی مادیشون کم باشه

409
0:27:03,660 --> 0:27:05,420
ولی روزی معنویشون خیلی زیاد هست

410
0:27:05,420 --> 0:27:07,920
کسانی ممکنه که سروتمند باشن

411
0:27:07,920 --> 0:27:09,580
اما روزی معنوی ندارن

412
0:27:09,580 --> 0:27:10,920
سروت زیاد داره

413
0:27:10,920 --> 0:27:12,620
اما حتی توفیق یک بار

414
0:27:12,620 --> 0:27:14,400
به حج رفتن رو هم پیدا نمیکنه

415
0:27:14,400 --> 0:27:15,880
سحنه آخر

416
0:27:15,880 --> 0:27:18,180
رامین با تعجب میگه

417
0:27:18,180 --> 0:27:20,640
اه بابا چقدر جوابش راحت بوده

418
0:27:20,640 --> 0:27:22,080
من فکر میکردم که

419
0:27:22,080 --> 0:27:24,620
خیلی جواب دادن به این سوال باید سخت باشه

420
0:27:24,620 --> 0:27:26,100
حالا اینجوری هم نیست پسرم

421
0:27:26,100 --> 0:27:27,260
از قدیم گفتن

422
0:27:27,260 --> 0:27:30,240
ما اما چون حل شود آسان شود

423
0:27:30,240 --> 0:27:32,880
نشانی

424
0:27:32,880 --> 0:27:38,040
تلفون همراه شما

425
0:27:38,040 --> 0:27:39,200
رادیوی شما

426
0:27:39,200 --> 0:27:42,600
دریافت پانکه

427
0:27:42,620 --> 0:28:08,820
شبتون بخیر باشه دوستان شنونده

428
0:28:08,820 --> 0:28:10,140
ممنونم از این که

429
0:28:10,140 --> 0:28:11,800
همچنان همراه هستید با

430
0:28:11,800 --> 0:28:14,300
شبکه رادیوی معارف

431
0:28:14,300 --> 0:28:16,640
ساعت 21 و 27 دقیقه است

432
0:28:16,640 --> 0:28:19,540
دوستان حضرت امیر المؤمنین

433
0:28:19,540 --> 0:28:20,660
علی علیه السلام

434
0:28:20,660 --> 0:28:22,820
در نصیحت به فرزندشون

435
0:28:22,820 --> 0:28:24,800
آقای محمد حسن مشتبه علیه السلام

436
0:28:24,800 --> 0:28:26,580
میفرمایند که

437
0:28:26,580 --> 0:28:29,260
فرزندم در روابط اجتماعی

438
0:28:29,260 --> 0:28:31,380
خیشتن خیش را

439
0:28:31,380 --> 0:28:33,260
معیار سنجش

440
0:28:33,260 --> 0:28:34,020
قرارده

441
0:28:34,020 --> 0:28:36,260
و با دیگران چنان باش

442
0:28:36,260 --> 0:28:38,640
که انتظار داری با تو باشند

443
0:28:38,640 --> 0:28:41,020
آنچه برای دیگران میپسندی

444
0:28:41,800 --> 0:28:43,620
برای خود بپسند

445
0:28:43,620 --> 0:28:47,180
و آنچه برای خود ناپسند میبینی

446
0:28:47,180 --> 0:28:49,780
برای آنان نیز مپسند

447
0:28:49,780 --> 0:28:52,820
همانگونه که ظلم به خود را

448
0:28:52,820 --> 0:28:54,400
روانه میداری

449
0:28:54,400 --> 0:28:57,480
هرگز دست به ستم مگوشا

450
0:28:57,480 --> 0:28:59,300
نیکی کن

451
0:28:59,300 --> 0:29:01,440
همانگونه که دوست داری

452
0:29:01,440 --> 0:29:03,200
بر تو نیکی کنند

453
0:29:03,200 --> 0:29:05,260
و آنچه بر دیگران

454
0:29:05,260 --> 0:29:07,060
زشت شماری

455
0:29:07,060 --> 0:29:09,540
بر خود نیز زشت شمار

456
0:29:09,540 --> 0:29:11,300
بر مردمان

457
0:29:11,800 --> 0:29:12,920
سخت مگیر

458
0:29:12,920 --> 0:29:15,100
چنان که دوست نداری

459
0:29:15,100 --> 0:29:16,760
بر تو سخت گیرند

460
0:29:16,760 --> 0:29:18,980
و آنچه خوش نداری

461
0:29:18,980 --> 0:29:20,420
درباره ات بگویند

462
0:29:20,420 --> 0:29:23,640
درباره دیگران مگوی

463
0:29:23,640 --> 0:29:26,500
درود و سلام میفرستیم به

464
0:29:26,500 --> 0:29:28,960
روح متحر آقاب و مولامون

465
0:29:28,960 --> 0:29:30,840
حضرت امیر المؤمنین

466
0:29:30,840 --> 0:29:33,260
و از خدا میخواییم که انشالله

467
0:29:33,260 --> 0:29:35,280
ما رو جزوه پیروان حقیقی

468
0:29:35,280 --> 0:29:37,380
اون حضرت قرار بده

469
0:29:37,380 --> 0:29:38,700
و در مسیر روشن

470
0:29:38,700 --> 0:29:41,480
اهل بیت علیه مسلم حرکت بکنیم

471
0:29:41,480 --> 0:29:43,420
ممنونم از این که

472
0:29:43,420 --> 0:29:45,480
در کنار ما بودید

473
0:29:45,480 --> 0:29:47,040
رادیو معرف رو شنیدید

474
0:29:47,040 --> 0:29:49,120
در بخش دوم برامه ها که از ساعت

475
0:29:49,120 --> 0:29:50,880
چهارده امروز

476
0:29:50,880 --> 0:29:53,440
آغاز شده و به فرجام خودش

477
0:29:53,440 --> 0:29:54,340
نزدیک میشه

478
0:29:54,340 --> 0:29:57,200
من رضا هدایتفر افتخار داشتم

479
0:29:57,200 --> 0:29:59,220
به اتفاق همکارانم تیه کننده

480
0:29:59,220 --> 0:30:00,080
آقای محمد حسین
