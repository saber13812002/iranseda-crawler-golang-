364
0:21:21,060 --> 0:21:29,060
اونجا مسئله تخفیف را مسئله گزشت را هر دو را ذکر فرمود هموند

365
0:21:29,060 --> 0:21:35,060
هم تصدق را هم تخفیف را هم عف را

366
0:21:35,060 --> 0:21:39,060
آیه ۱۷۸ سور امبارک بغره این بود که

367
0:21:39,060 --> 0:21:43,060
یا ایوها الَّذین آمَنُوا كُتِبِ عَلَيْكُمْ مَنِ قِصْطَاصُوفِ الْغَتْلَاءِ

368
0:21:43,060 --> 0:21:48,060
الْحُرُّ بِالْحُرِّ وَالْعَبْدُ بِالْعَبْدِ وَالْعُنْثَى بِالْعُنْثَى

369
0:21:48,060 --> 0:21:57,060
فَمَنْ عُفِيَ لَهُ مِنْ اَخِيهِ شَيْئُونَ فَاتِّبَاعٌ بِالْمَعَرُوفِ وَاَدَاعٌ اِلِيهِ بِاحْسَانٍ

370
0:21:57,060 --> 0:22:00,060
وَآلَكَ تَخْفیفٌ مِنْ رَبِّكُمْ وَرَحْمَةٌ

371
0:22:00,060 --> 0:22:07,060
خداوند در این حال که قصاص را جعل کرده است تخفیف هم داده است و اون گزشت است

372
0:22:07,060 --> 0:22:14,060
حالا یا گزشت کلی یا تبدیل به مال و تخفیف در مال به مانند آن

373
0:22:14,060 --> 0:22:25,060
چه اینکه در بحث های قصاص طرف هم در سوره مبارکه ماعده سخن از تصدق دادن مطرح است

374
0:22:25,060 --> 0:22:31,060
آیه 45 سوره ماعده این است و کتب دعا علیهم فیها

375
0:22:31,060 --> 0:22:37,060
اَنَّ النَّفْسَ بِالنَّفْسِ وَالْعَيْنَ بِالْعَيْنِ وَالْعَنْفِ بِالْعَنْحِ وَالْعُذُونَ بِالْعُذُونَ

376
0:22:37,060 --> 0:22:43,060
وَالسِّنَّ بِالسِّنِّ وَالْجُرُوحِ قِصَاصٍ فَمَنْ تَسْقَدْ دَغِبِهِ

377
0:22:43,060 --> 0:22:50,200
فَاوَایِ کَفَّارَتُنْ لَهُ اَگَرْ کِسِی سَدْقِهِ بِدَهَدْ اَفْكُنَدْ اَزْ جَانِی

378
0:22:50,200 --> 0:22:52,140
این کفاره محصوب میشود

379
0:22:52,140 --> 0:23:01,280
حالا در همه این موارد چون که در زیل آیه پایانی سوره نهر آمده

380
0:23:01,280 --> 0:23:05,980
یا آیه سوره قصاص طرف قصاص نفس آمده

381
0:23:05,980 --> 0:23:10,720
همه این موارد احسان است یا نه

382
0:23:10,720 --> 0:23:12,940
در همه موارد گذارده

383
0:23:13,060 --> 0:23:14,700
احسان نیست

384
0:23:14,700 --> 0:23:18
ذات اقدس ایلاد در همین آیه

385
0:23:18 --> 0:23:21,080
اون محیار اصلی رو روشن کد

386
0:23:21,080 --> 0:23:22,100
فرمود

387
0:23:22,100 --> 0:23:27,060
لا يُحِبُّ اللهُ الجَهْرِ بِسُوءِ مِنَ الْغُولِ

388
0:23:27,660 --> 0:23:32
اِلَّا مَنْ ظُلِمْ وَكَانَ اللَّهُ سَمِیًا عَلِيمًا

389
0:23:32 --> 0:23:33,140
بعد ثمود

390
0:23:33,140 --> 0:23:35,080
اِنْ تُبْدُوا خَيْرًا

391
0:23:35,080 --> 0:23:37,180
اَوْ تُخْفُوهُ

392
0:23:37,180 --> 0:23:41,060
اَوْ تَعَفُوا عَنْ سُوءِنْ

393
0:23:41,060 --> 0:23:43,060
فِاِنَّ اللَّهَ

394
0:23:43,060 --> 0:23:45,060
کَانَ عَفَوًّا

395
0:23:45,060 --> 0:23:46,240
قَدِيرًا

396
0:23:46,240 --> 0:23:49,680
اِنْ فِاِنَّ اللَّهَ کَانَ عَفَوًّا قَدِيرًا

397
0:23:49,680 --> 0:23:55,160
با اون بحث کلی اخلاقی که تخلق و به اخلاق الله همهنگ است

398
0:23:55,160 --> 0:23:57,260
یعنی ذات اقدس ایلاد

399
0:23:57,260 --> 0:24:00,300
اوصاف کمالی را برای خود ذکر میکند

400
0:24:00,300 --> 0:24:03,360
بعد در روایات به ما دستور دادن

401
0:24:03,360 --> 0:24:06,580
که شما به اخلاق الهی متخلق بشدید

402
0:24:06,580 --> 0:24:08,380
خدا فرمود

403
0:24:08,380 --> 0:24:09,800
افهو است

404
0:24:09,800 --> 0:24:10,840
میگذرد

405
0:24:10,840 --> 0:24:12,580
صرف

406
0:24:12,580 --> 0:24:15,120
گذشت کمال نیست

407
0:24:15,120 --> 0:24:18,240
گاه انسان در اثر تنبالی

408
0:24:18,240 --> 0:24:20,460
در اثر بیتفاوتی

409
0:24:20,460 --> 0:24:22,400
در اثر بیارغی

410
0:24:22,400 --> 0:24:23,740
میگذرد

411
0:24:23,740 --> 0:24:25,660
این که احسان نیست

412
0:24:25,660 --> 0:24:28,640
برای اون جانی حسن است

413
0:24:28,640 --> 0:24:33,120
ولی برای مجنی و علی احسان نیست

414
0:24:33,120 --> 0:24:36,500
اون افوی کمال است

415
0:24:36,500 --> 0:24:38,380
چه روی قدرت باشد

416
0:24:38,380 --> 0:24:41,300
فرمود شما به قدرت برسید

417
0:24:41,300 --> 0:24:42,280
از موزه

418
0:24:42,580 --> 0:24:44,640
قدرت بگذرید

419
0:24:44,640 --> 0:24:45,640
اون کمال است

420
0:24:45,640 --> 0:24:49,540
پس تا زلیل و زعیفید

421
0:24:49,540 --> 0:24:52,220
یه همچه افی مندو نیست

422
0:24:52,220 --> 0:24:54,520
بعد انتقام بگیرید

423
0:24:54,520 --> 0:24:58,400
که مبادا ظالم تجریب پیدا کند

424
0:24:58,400 --> 0:25:01,800
وقتی به مقام قدرت رسیدید

425
0:25:01,800 --> 0:25:03,860
قدیر شدید

426
0:25:03,860 --> 0:25:07,200
اف قدیرانه احسان است

427
0:25:07,200 --> 0:25:09,440
نه اف زلیلانه

428
0:25:09,440 --> 0:25:11,260
حالا اگر کسی

429
0:25:11,260 --> 0:25:12,560
چون دست قدرت رسیدید

430
0:25:12,580 --> 0:25:15,020
از شما بر نیامت گفت من گذشت کردم

431
0:25:15,020 --> 0:25:18,180
یا میترسد میگد من گذشت کردم

432
0:25:18,180 --> 0:25:21,300
این اون اف ممدوح و مطلوب نیست

433
0:25:21,300 --> 0:25:24,280
لذا ذات اقدس اله خود را

434
0:25:24,280 --> 0:25:27,580
به عنوان افو به قدیر معرفی کرد

435
0:25:28,160 --> 0:25:31,200
بعد فرمود شما اگر اف بکنید

436
0:25:31,200 --> 0:25:33,080
خدا افو به قدیر است

437
0:25:33,080 --> 0:25:35,540
یعنی کار الهی رو بکنید

438
0:25:35,540 --> 0:25:37,320
خدا هم قدرت دارد

439
0:25:37,320 --> 0:25:39
از شما انتقام بگیرد

440
0:25:39 --> 0:25:40,060
ولی نمیگیرد

441
0:25:40,060 --> 0:25:42,980
شما هم که قدرت انتقام دارید

442
0:25:42,980 --> 0:25:44,020
اف کنید

443
0:25:44,020 --> 0:25:46,260
پس معلوم میشود که

444
0:25:46,260 --> 0:25:50,540
جایی جهر بسو محبوب است

445
0:25:50,540 --> 0:25:52,560
که انسان برای دفاعی از حق

446
0:25:52,560 --> 0:25:54,640
و انتقام از مظلوم باشد

447
0:25:54,640 --> 0:25:55,220
یک

448
0:25:55,220 --> 0:25:58,900
و وقتی سکوت

449
0:25:58,900 --> 0:26:01,800
احسن از انتقام است

450
0:26:01,800 --> 0:26:04,620
سبر احسن از انتقام است

451
0:26:04,620 --> 0:26:08,440
که مقتدرانه باشد

452
0:26:08,440 --> 0:26:09,220
نه مظلومانه

453
0:26:10,060 --> 0:26:14,440
و از اون چه که در این کریمه آمده است

454
0:26:14,440 --> 0:26:17,900
اف به مقتدرانه است

455
0:26:17,900 --> 0:26:20,720
نه اف به بی تفاوتی

456
0:26:20,720 --> 0:26:25,700
و کان الله و افو به قدیرن

457
0:26:25,700 --> 0:26:30,680
شما هم مظهر افو به قدیر باشید

458
0:26:30,680 --> 0:26:32,900
اف کنید روی اقتدار

459
0:26:32,900 --> 0:26:34,060
اینم این مطلب

460
0:26:34,060 --> 0:26:36,140
اما این که فرمود

461
0:26:36,140 --> 0:26:39,220
انتوب دو خیرن

462
0:26:39,220 --> 0:26:40,040
او تو خواهید

463
0:26:40,060 --> 0:26:42,200
افوهو و تعفوانسو

464
0:26:42,200 --> 0:26:46,240
این دارد رابطه افراد را با احتیار بیام کند

465
0:26:46,240 --> 0:26:48,760
بفرماد شما با مردم

466
0:26:48,760 --> 0:26:52,240
باید یه رابطه خسنه برقرار کنید

467
0:26:52,240 --> 0:26:54,980
یا نسبت به اونها نیکی کنید

468
0:26:54,980 --> 0:26:57,660
یا از بدی اونها سرف نظر کنید

469
0:26:57,660 --> 0:27:00,840
و هر دو حال این مایه تحکیم رابطه است

470
0:27:00,840 --> 0:27:03,060
تحکیم ارتباط مردمی

471
0:27:03,660 --> 0:27:07,060
یا به این از که نسبت مردم کار خیر انجام بدید

472
0:27:07,060 --> 0:27:10,060
یا بدی اونها را تحمل کنید

473
0:27:10,060 --> 0:27:13,380
تو روایات حسن جوار آمد است که

474
0:27:13,380 --> 0:27:18,420
همسایه خوب همسایه این نیست که به همسایش آزار نکند

475
0:27:18,420 --> 0:27:23,500
همسایه خوب همسایه است که آزار همسایه را تحمل بکند

476
0:27:23,500 --> 0:27:25,840
این معنای حسن جوار است

477
0:27:25,840 --> 0:27:31,360
خب اگر ما رابطه مردمیمون باید تحکیم بشود

478
0:27:31,360 --> 0:27:33,080
این دو تا راه دارد

479
0:27:33,080 --> 0:27:36,940
یا به مردم خیر برسانیم فی سر و العالم

480
0:27:36,940 --> 0:27:39,940
یا اگر خیری به اونها ندارد

481
0:27:40,060 --> 0:27:43,420
رسوندیم از شر اونها بگذاریم

482
0:27:43,420 --> 0:27:44,620
عفو کنیم

483
0:27:44,620 --> 0:27:51,340
حالا این ابداع خیر

484
0:27:51,340 --> 0:27:53,740
در حقیقت معناش این است که

485
0:27:53,740 --> 0:28:03,180
این دراه برای تحکیم روایات اجتماعی معسیر است

486
0:28:03,180 --> 0:28:06,140
حالا که میخواید کار خیر انجام بدید

487
0:28:06,140 --> 0:28:08,640
یا حرف خیر بزنید

488
0:28:08,640 --> 0:28:10,040
این یا ابداع خیر

489
0:28:10,060 --> 0:28:11,520
یا ابداع از یا اخفا

490
0:28:11,520 --> 0:28:14,500
اون جایی هم که میخواید عفو کنید

491
0:28:14,500 --> 0:28:16,620
اون هم یا ابداع از یا اخفا

492
0:28:16,620 --> 0:28:19,020
اون دیگه به صورت اجمال ذکر شده است

493
0:28:19,020 --> 0:28:22,060
شما یه وقتی در جمع از کسی میگذارید

494
0:28:22,600 --> 0:28:26,560
یه وقتی در خفا هم از اون میگذارید

495
0:28:26,560 --> 0:28:29,280
اون نگرانی که در قلب داشتید

496
0:28:29,280 --> 0:28:30,060
اون رو از میگذارید

497
0:28:30,780 --> 0:28:34,320
تو دعاهای شبهاتون اون رو هم فراموش نمی کنید

498
0:28:34,320 --> 0:28:37,900
این در حقیقت عفو مخفیانه است

499
0:28:37,900 --> 0:28:42,040
یه وقتی در علن کسی به شما بد گفته است

500
0:28:42,040 --> 0:28:44,760
شما در حضور دیگران از اون میگذارید

501
0:28:44,760 --> 0:28:46,860
این عفو آشکار است

502
0:28:46,860 --> 0:28:50,140
یه وقتی در خفا به شما ستمی کرده است

503
0:28:50,140 --> 0:28:53,140
شما در خفا در شد در حال نیایش

504
0:28:53,140 --> 0:28:55,900
اون رو از خیرتون برخوردار میکنید

505
0:28:56,680 --> 0:28:59,180
این عفو مخفیانه است

506
0:28:59,180 --> 0:29:00,980
به هر تقدیر

507
0:29:00,980 --> 0:29:03,760
یا خیر به دیگران میرسانید

508
0:29:03,760 --> 0:29:06,800
یا از شر دیگران سرهزر میکنید

509
0:29:06,800 --> 0:29:07,800
حالا یا

510
0:29:07,800 --> 0:29:10,520
دیگران که به شما خیر رسوندن

511
0:29:10,520 --> 0:29:12,600
اون خیر را عشقار میکنید

512
0:29:12,600 --> 0:29:20,880
یا به این معنی است که خیری که دیگران به شما رسوندند

513
0:29:20,880 --> 0:29:22,800
اون را علن میکنید

514
0:29:23,500 --> 0:29:24,800
تشکر میکنید

515
0:29:25,500 --> 0:29:27,800
و این مقدار حمت دارید

516
0:29:28,660 --> 0:29:31,660
که هم از گر کسی نسبت به شما محبت کرد

517
0:29:31,660 --> 0:29:32,800
تشکر بکنید

518
0:29:32,800 --> 0:29:35,740
و هم این حمت را دارید

519
0:29:35,740 --> 0:29:37,760
که بدانید او رسول الله

520
0:29:37,760 --> 0:29:39,280
از طرف خدا آمده

521
0:29:39,280 --> 0:29:40,820
همونطوری که

522
0:29:40,820 --> 0:29:43,760
المسکین رسول الله

523
0:29:43,760 --> 0:29:46,920
المعطی هم رسول الله است

524
0:29:46,920 --> 0:29:48,940
اگر کسی چیزی به شما داد

525
0:29:48,940 --> 0:29:51,180
احسانی به شما کرد

526
0:29:51,180 --> 0:29:52,760
نباید تشکر کرد

527
0:29:53,440 --> 0:29:55,080
نباید دعا کرد

528
0:29:55,080 --> 0:29:56,220
نباید تقدیر کرد

