0:22:28,960 --> 0:22:31,040
برستیم

449
0:22:31,040 --> 0:22:32,300
فضله

450
0:22:32,300 --> 0:22:35,680
اما واجب نیست

451
0:22:35,680 --> 0:22:36,940
حالا

452
0:22:36,940 --> 0:22:38,140
بعدشو میفهمیم

453
0:22:38,280 --> 0:22:38,780
میفهمید که

454
0:22:38,780 --> 0:22:41,180
مثال میزنه

455
0:22:41,180 --> 0:22:43,140
جواب

456
0:22:43,140 --> 0:22:44,560
میفهمید که مثل

457
0:22:44,560 --> 0:22:46,820
الوجف ایلام الاطفال

458
0:22:46,820 --> 0:22:49,640
و جهت المصلحه في رمی الجمار

459
0:22:49,640 --> 0:22:51,820
میفهمید که در عالم تشریح

460
0:22:51,820 --> 0:22:54,280
خیلی از این نقاط هست که ما نمیدونیم

461
0:22:54,840 --> 0:22:57,220
و ما اشبه ذلك من العبادات

462
0:22:57,220 --> 0:22:58,280
على التفصیل والتعیید

463
0:22:58,880 --> 0:23:02,280
فَاِنَّا اِذَا عَوَّلْنَا

464
0:23:02,860 --> 0:23:05,780
عَلَى حِكْمَةِ الْقَدِيمِ

465
0:23:05,780 --> 0:23:06,280
یعنی چی؟

466
0:23:06,280 --> 0:23:08,280
ما میدونیم

467
0:23:08,280 --> 0:23:10,500
قدیم این خداوند عزوجل

468
0:23:10,500 --> 0:23:13,280
میدونیم خداوند عزوجل چیه؟

469
0:23:13,880 --> 0:23:14,320
حکیم

470
0:23:14,320 --> 0:23:20,180
وَاَنَّهُ لَا يَجُوزُ اَنْ يَفْعَلَ قَبِيحًا

471
0:23:20,180 --> 0:23:22,580
هیچ وقت

472
0:23:22,580 --> 0:23:26,700
قبیه خدا انجام نمیده

473
0:23:26,700 --> 0:23:28,260
پس

474
0:23:28,260 --> 0:23:31,560
این کارهایی که در حج

475
0:23:31,560 --> 0:23:32,780
هست

476
0:23:32,780 --> 0:23:34,760
همه چی داره؟

477
0:23:34,760 --> 0:23:35,600
حکمت دارد

478
0:23:35,600 --> 0:23:38,260
فَلَابُدْ دَعَنْدَهُمْ

479
0:23:38,280 --> 0:23:42,280
وَاَنَّهُمْ وَفَلَابُدْدَ مِنْ وَجْهٍ عَسَنٍ

480
0:23:42,280 --> 0:23:43,620
فی جمع ادامه

481
0:23:43,620 --> 0:23:47,040
هر چی خدا دستور داده

482
0:23:47,040 --> 0:23:47,800
واجهی دارد

483
0:23:47,800 --> 0:23:49,580
واجهش هم چیه؟

484
0:23:49,580 --> 0:23:50,380
حسن هست

485
0:23:50,380 --> 0:23:54,100
وَاِنْ جَهِلْنَاهُ بِعَيْنِهِ

486
0:23:54,100 --> 0:23:55,260
نمیدونیم

487
0:23:55,260 --> 0:23:58,240
نمیدونیم که معادل تغییر

488
0:23:58,240 --> 0:23:59,900
نمیده

489
0:23:59,900 --> 0:24:04,200
فَلَيْسَ يَجِبْ عَلَيْنَا بَيَانْ ذَلِكَ الْوَجْهِ

490
0:24:04,200 --> 0:24:07,400
واجب هست با این

491
0:24:07,400 --> 0:24:09,540
پیدنکت چه بهتر؟

492
0:24:09,540 --> 0:24:11,680
پیدنکت بر شما الزامی؟

493
0:24:11,680 --> 0:24:12,340
نیست

494
0:24:12,340 --> 0:24:14,760
وَفِیْهَادَا

495
0:24:14,760 --> 0:24:17,500
سَدْدُلْبَابِ عَلَى مُخَالِفِينَا

496
0:24:17,500 --> 0:24:20,680
ایشون چی میگن

497
0:24:20,680 --> 0:24:23,900
به اصلا دست بالا گرف

498
0:24:23,900 --> 0:24:27,540
شما میگی چرا امام زمان غائبه؟

499
0:24:29,680 --> 0:24:31,540
ما هزاران چرا؟

500
0:24:33,560 --> 0:24:35,540
در برابرتون میریزیم به جوابش بدید

501
0:24:35,540 --> 0:24:39,540
هر وقت اونها را جواب دادید این را ما جواب بدید

502
0:24:39,540 --> 0:24:41,540
لذا میفرماید

503
0:24:41,540 --> 0:24:43,540
من اینجوری نقض جواب میدم

504
0:24:43,540 --> 0:24:47,540
که درب چرا بسته بشه

505
0:24:47,540 --> 0:24:56,540
سَدُّلْبَابِ عَلَى مُخَالِفِينَا فِی سُؤَالَتِهِمْ

506
0:24:56,540 --> 0:24:59,540
وَقَطْعُوا التَّطْوِیلَاتَ عَنْهُمْ

507
0:24:59,540 --> 0:25:01,540
از اینها حرف ها چی میگن؟

508
0:25:01,540 --> 0:25:09,540
هر فراموش دل مرغانه چمن بسیار است

509
0:25:09,540 --> 0:25:12,540
ما اینجوری به این را نقض میکنیم

510
0:25:12,540 --> 0:25:15,540
که دیگر حرف تمام بشه

511
0:25:15,540 --> 0:25:16,540
چرا؟

512
0:25:16,540 --> 0:25:18,540
چون خودشون هم در برابر این سوالات

513
0:25:18,540 --> 0:25:20,540
و بیش از این قرار گرفتند

514
0:25:20,540 --> 0:25:24,540
سوال فقط راجع به علت غیبت امام زمان نیست

515
0:25:24,540 --> 0:25:26,540
هزاران هزار باید شما جواب بدید

516
0:25:26,540 --> 0:25:29,540
اونها را جواب بدید ما این را انشاءالله جواب بدیم

517
0:25:29,540 --> 0:25:30,540
خب

518
0:25:30,540 --> 0:25:32,540
بعد میفهمد که

519
0:25:32,540 --> 0:25:35,540
اِلاَنَّا نَتَبَرَّع

520
0:25:35,540 --> 0:25:37,540
بعد میفهمد خیلی سید

521
0:25:37,540 --> 0:25:39,540
رشنگ وارد شد

522
0:25:39,540 --> 0:25:41,540
به مرگ به اسطلاح امروز چی میگن؟

523
0:25:41,540 --> 0:25:43,540
به مرگ گرفت

524
0:25:43,540 --> 0:25:44,540
که به

525
0:25:44,540 --> 0:25:46,540
تب قبول کنید

526
0:25:46,540 --> 0:25:48,540
دست بالا گرفت

527
0:25:48,540 --> 0:25:50,540
شما از ما چرای اینه میپرسید؟

528
0:25:50,540 --> 0:25:52,540
ما از شما چرای

529
0:25:52,540 --> 0:25:54,540
هزاران

530
0:25:54,540 --> 0:25:56,540
چرایی داریم

531
0:25:56,540 --> 0:25:58,540
اونها را جواب بدید این را ما جواب بدیم

532
0:25:58,540 --> 0:26:00,540
و گفتم به شما بودم

533
0:26:00,540 --> 0:26:02,540
خدا حکیمه

534
0:26:02,540 --> 0:26:05,540
حکمت خداوند از زوجن

535
0:26:05,540 --> 0:26:09,540
اقتضام کند که این کارش قبیح

536
0:26:09,540 --> 0:26:11,540
یعنی این کارش روی چیه؟

537
0:26:11,540 --> 0:26:13,540
روی حکمت

538
0:26:13,540 --> 0:26:15,540
روی حکمت

539
0:26:15,540 --> 0:26:17,540
چون خدا کار قبیح هم جا نمیده

540
0:26:17,540 --> 0:26:19,540
اما اون حکمت چیه نمیدون؟

541
0:26:19,540 --> 0:26:22,540
بعد میفهمد که حالا که ما اینجوری جواب دادیم

542
0:26:22,540 --> 0:26:24,540
نَتَبَرَّع

543
0:26:24,540 --> 0:26:26,540
تبرع

544
0:26:26,540 --> 0:26:28,540
یعنی چی؟ دوتلب

545
0:26:28,540 --> 0:26:29,540
دوتلب میشیم که

546
0:26:29,540 --> 0:26:31,540
یه جواب بدیم

547
0:26:31,540 --> 0:26:33,540
به ایراد لجفی غیبتهی

548
0:26:33,540 --> 0:26:35,540
چرا آقا غائب شده هم؟

549
0:26:35,540 --> 0:26:40,540
على سبیل الاستظهار

550
0:26:40,540 --> 0:26:44,540
و بیان الاقتدار

551
0:26:44,540 --> 0:26:46,540
ما میخواهم بگیم که بلد خره؟

552
0:26:46,540 --> 0:26:49,540
میتونیم

553
0:26:49,540 --> 0:26:53,540
و انکان ذالک غیر واجب علینا

554
0:26:53,540 --> 0:26:57,540
بر ما لازم نیست ما جواب رو بدیم

555
0:26:57,540 --> 0:26:59,540
ولی میخواهم بگیم

556
0:26:59,540 --> 0:27:00,540
لازم نیست

557
0:27:00,540 --> 0:27:03,540
معناش اینست که خدرت نداریم

558
0:27:03,540 --> 0:27:05,540
توانش رو نداریم

559
0:27:05,540 --> 0:27:07,540
فَنَقُول

560
0:27:07,540 --> 0:27:12,540
الْوَجْفِ غَيْبَتِهِ هُوَ خَوْفُ عَلَى نَفْسِهِ

561
0:27:12,540 --> 0:27:13,540
اه

562
0:27:13,540 --> 0:27:15,540
میگن میشه؟ میگه بله

563
0:27:15,540 --> 0:27:17,540
بعد توضیح میدن

564
0:27:17,540 --> 0:27:19,540
وجه غیبت اشتباه نشه

565
0:27:19,540 --> 0:27:25,540
نه تنها وجه علت منحصره نیست

566
0:27:25,540 --> 0:27:28,540
وجه در غیبت حضرت خوفشه بر خودش

567
0:27:28,540 --> 0:27:35,540
وَمَنْ خَافَ عَلَى نَفْسِهِ احتاجه یا استطاع

568
0:27:35,540 --> 0:27:41,540
هر کس بر خودش به ترس محتاجه به مخفی کذن خودش هست

569
0:27:41,540 --> 0:27:48,540
اَمَّا لَوْ كَانَ خَوْفُهُ عَلَى مَنِهِ اَوِ الْعَذَافِ نَفْسِهِ

570
0:27:48,540 --> 0:27:50,540
وَخُوف بر نفس قتله

571
0:27:50,540 --> 0:27:54,540
یعنی خوف بر نفس ازیادش میکنه

572
0:27:54,540 --> 0:27:56,540
اموال چه میبرن؟

573
0:27:56,540 --> 0:28:01,540
اگه این باشد لا استطاع ندارد

574
0:28:01,540 --> 0:28:03,540
باید تحمل کنه

575
0:28:03,540 --> 0:28:08,540
لَوَجَبَ عَلَيْهِ اَنْ يَحْمِلَ ذَلِكَ كُلَّهِ

576
0:28:08,540 --> 0:28:13,540
لِيَرُوحْ عَلَيْهِ الْمُكَلَّفُونَ فِي تَكْلِيفِهِمْ

577
0:28:13,540 --> 0:28:15,540
تا بلاخره مکلفین

578
0:28:15,540 --> 0:28:18,540
یعنی این سختی رو به خودش تحمل بکنه

579
0:28:18,540 --> 0:28:21,540
زراده مواجهه تحمل بکنه

580
0:28:21,540 --> 0:28:24,540
از جرح و نمدن زرب رو تحمل بکنه

581
0:28:24,540 --> 0:28:26,540
که مکلفینه باشه

582
0:28:26,540 --> 0:28:29,540
برسند به تکالیفشون

583
0:28:29,540 --> 0:28:32,540
بعد میفهمید که همونطور که پیمبر اکرم

584
0:28:32,540 --> 0:28:35,540
هوا هادا کما نقولو فی النبی

585
0:28:35,540 --> 0:28:40,540
فی انهو یجب علیه ان یحمل کل ادا فی نفسه

586
0:28:40,540 --> 0:28:44,540
شقدر پیمبر اکرم ازیت تحمل کرده

587
0:28:44,540 --> 0:28:46,540
خب این آیت کنید

588
0:28:46,540 --> 0:28:51,540
پیمبر اکرم ازیتها را تحمل کرده

589
0:28:51,540 --> 0:28:55,540
حتی يصح منه الادا الى الخلق ماهو لطف لهم

590
0:28:56,540 --> 0:28:59,540
یوزی که لطف برای اونها باشد

591
0:28:59,540 --> 0:29:04,540
یا ارائه طریقه یا ایثار الال مطلوب از هر چی هست

592
0:29:04,540 --> 0:29:06,540
اینا لطفه

593
0:29:06,540 --> 0:29:11,540
تحمل کردن که این لطف به مردم برسند خوب

594
0:29:11,540 --> 0:29:16,540
و انما یجب علیه الظهور

595
0:29:16,540 --> 0:29:20,540
و این ادا الى قتله

596
0:29:20,540 --> 0:29:25,540
کما ظهر کثیر من الانبیاء

597
0:29:26,540 --> 0:29:29,540
به قتل ام برسد

598
0:29:29,540 --> 0:29:33,540
ظهور بر نبی لازم است

599
0:29:33,540 --> 0:29:37,540
همونطوری که برای انبیاء دیگر بود

600
0:29:37,540 --> 0:29:39,540
و الحمدلله رب العالمين

601
0:29:39,540 --> 0:29:53,540
موسیقی

602
0:29:56,540 --> 0:29:59,540
موسیقی

