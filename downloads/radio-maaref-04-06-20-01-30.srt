روی خاک تفتیده یک کبیر پیش میرفت

452
0:17:18,580 --> 0:17:20,560
یه مردی به اون رسید و خودش رو فرستاده

453
0:17:20,560 --> 0:17:22
یه مام رزا معرفی کرد

454
0:17:22 --> 0:17:23,800
و مشک آبی به اون داد

455
0:17:23,800 --> 0:17:26,540
بعد مسیری رو به امران نشون داد

456
0:17:26,540 --> 0:17:28,580
و گفت اگه به دنبال آب حیاته

457
0:17:28,580 --> 0:17:30,040
باید چهل قدم پیش بره

458
0:17:30,040 --> 0:17:32,880
تا به خونه پین دوزی روشن زمیر برسه

459
0:17:32,880 --> 0:17:34,760
و از اون نشونی چشمه

460
0:17:34,760 --> 0:17:36,080
آب حیات رو بگیره

461
0:17:42,760 --> 0:17:45,240
امران مرحم مالید و اونا رو بست

462
0:17:45,240 --> 0:17:46,720
بعد با امران حرف زد

463
0:17:46,720 --> 0:17:48,240
و فهمید که اون خدا باوره

464
0:17:48,240 --> 0:17:50,800
اما به دین و آینی متقد نیست

465
0:17:50,800 --> 0:17:52,760
و فقط به دنبال پیدا کردن

466
0:17:52,760 --> 0:17:54,200
چشمه آب حیاته

467
0:17:54,200 --> 0:17:55,860
حاج کریم پین دوز

468
0:17:55,860 --> 0:17:59,520
از اعتقادش به خدا و ولایت امام رزا گفت

469
0:17:59,520 --> 0:18:01,160
تا شاید امران به راه بیاد

470
0:18:01,160 --> 0:18:02,660
اما اون همچنان اسرار داشت

471
0:18:02,660 --> 0:18:03,920
که میخواد به شمال بره

472
0:18:03,920 --> 0:18:06,160
و چشمه آب حیات رو پیدا کنه

473
0:18:06,160 --> 0:18:07,700
حاج کریم به امران گفت که

474
0:18:07,700 --> 0:18:10,060
چشمه آب حیات حقیقی در خراسان

475
0:18:10,060 --> 0:18:11,640
و خونه امام رزا میجوشه

476
0:18:11,640 --> 0:18:13,620
اما امران اسرار داشت

477
0:18:13,620 --> 0:18:16,060
به دنبال چشمه آب حیات خیالی بره

478
0:18:16,060 --> 0:18:17,600
روز بعد حاج کریم

479
0:18:17,600 --> 0:18:19,540
امران رو به کاروان سرای برد

480
0:18:19,540 --> 0:18:21,420
و کاروانی رو که راهی شمال بود

481
0:18:21,420 --> 0:18:22,360
به اون نشون داد

482
0:18:22,360 --> 0:18:26,240
بعد هم خودش و دخترش راهله به سمت خراسان راه افتدن

483
0:18:26,240 --> 0:18:27,760
حاج کریم و امران راهله

484
0:18:27,760 --> 0:18:29,780
در بیابون پیش میرفتند که مردی

485
0:18:29,780 --> 0:18:31,740
هیزان به دوش به اونها نزدیک شد

486
0:18:31,740 --> 0:18:32,400
و آب خواست

487
0:18:32,400 --> 0:18:35,340
امران از مشکی که همراهش بود به اون آب داد

488
0:18:35,340 --> 0:18:37,800
مرد غریبه به سمت روستایی که خونهاش

489
0:18:37,800 --> 0:18:39,480
از دور پیدا بود راه افتد

490
0:18:39,480 --> 0:18:41,340
حاج کریم به امید خریدن

491
0:18:41,340 --> 0:18:43,460
اسبی در روستا همراه مرد غریبه

492
0:18:43,460 --> 0:18:44,040
راه افتد

493
0:18:44,040 --> 0:18:47,080
مرد به حاج کریم قول داد اگه به سوالاتش

494
0:18:47,080 --> 0:18:49,380
جواب بده اسبی با قیمتی مناسب

495
0:18:49,380 --> 0:18:51,260
در روستا براش پیدا میکنه

496
0:18:51,260 --> 0:18:53,540
در برنامه قبل تا جایی شنیدید که

497
0:18:53,540 --> 0:18:55,300
حاج کریم و راهل و امران

498
0:18:55,300 --> 0:18:57,600
به خونه مرد غریبه در روستا رفتن

499
0:18:57,600 --> 0:18:59,540
کمی که گذشت در خونه با لگد

500
0:18:59,540 --> 0:19:01,560
محکمی باز و مردی

501
0:19:01,560 --> 0:19:03,360
شمشیر به دست وارد خونه شد

502
0:19:03,360 --> 0:19:05,200
حاج کریم و همراهانش فهمیدن که

503
0:19:05,200 --> 0:19:07,260
مرد شمشیر به دست رفیق و همدست

504
0:19:07,260 --> 0:19:09
مرد غریبه است و اسمش

505
0:19:09 --> 0:19:10,860
اشعسه و حالا

506
0:19:10,860 --> 0:19:13,240
ادامه روایت کتاب اقیانوس

507
0:19:13,240 --> 0:19:15,540
مشرق در قسمت پانزدهان

508
0:19:23,540 --> 0:19:31,320
ترس و وحشت تو خونه مخروبه

509
0:19:31,320 --> 0:19:32,220
حاکم شده بود

510
0:19:32,220 --> 0:19:34,500
اشعس شمشیر به دست

511
0:19:34,500 --> 0:19:37,040
به سمت حاج کریم پین دوز رفت

512
0:19:37,040 --> 0:19:39,620
حاج کریم دست دخترش راهل رو گرفت

513
0:19:39,620 --> 0:19:40,340
و اقب رفت

514
0:19:40,340 --> 0:19:43,420
بعد روبه مرد غریبه کرد و گفت

515
0:19:43,420 --> 0:19:45,520
از نامت مربان است و رفیق

516
0:19:45,520 --> 0:19:47,400
این مرد شمشیر به دستی

517
0:19:47,400 --> 0:19:49,440
این رسم مردانگی نیست

518
0:19:49,440 --> 0:19:51,380
ما صادقانه از روی

519
0:19:51,380 --> 0:19:53,160
مهر در بیابان تشنگی

520
0:19:53,160 --> 0:19:55,260
ترا رفت کردیم و تو ما را به اینجا

521
0:19:55,260 --> 0:19:57,120
کشاندی و حال رفیقت

522
0:19:57,120 --> 0:19:58,840
به روی ما شمشیر کشیده است

523
0:19:58,840 --> 0:20:00,160
از ما چه میخواهید؟

524
0:20:00,160 --> 0:20:01,980
قبل از اینکه مربان حرفی بزنه

525
0:20:01,980 --> 0:20:03,420
اشعس گفت

526
0:20:03,420 --> 0:20:04,780
بیرانه گو پیره من

527
0:20:04,780 --> 0:20:07,980
من حسلی سخنان پوچ و بیهوده

528
0:20:07,980 --> 0:20:08,920
ی ترا ندارم

529
0:20:08,920 --> 0:20:11,760
حسلی این شمشیر از حسلی من

530
0:20:11,760 --> 0:20:12,540
کمتر است

531
0:20:12,540 --> 0:20:15,040
و بادا از کور در برود

532
0:20:15,040 --> 0:20:17,900
و برای بوسیدن گردن تو حجوم آورد

533
0:20:17,900 --> 0:20:20,380
حاج کریم پین دوز حرفی نزد

534
0:20:20,380 --> 0:20:21,920
اشعس ادامه داد

535
0:20:21,920 --> 0:20:24,200
گویا تا به حال در عمرت راست

536
0:20:24,200 --> 0:20:25,700
ندیده ای که اینگونه

537
0:20:25,700 --> 0:20:27,820
با بط تماشا می کنی

538
0:20:27,820 --> 0:20:29,180
و اندرس می دهی

539
0:20:29,180 --> 0:20:31,600
هرچه داری بیرون بریز

540
0:20:31,600 --> 0:20:34,060
و جان خودت را بخرد

541
0:20:34,060 --> 0:20:35,340
حاج کریم پین دوز

542
0:20:35,340 --> 0:20:37,880
سر برگردون دونیم نگاهی به دخترش

543
0:20:37,880 --> 0:20:39,060
راهله کرد و گفت

544
0:20:39,060 --> 0:20:41,240
نه ترس دخترم نه ترس

545
0:20:41,240 --> 0:20:44,240
حاج کریم پین دوز روبه اشعس کرد و گفت

546
0:20:44,240 --> 0:20:45,700
مسافران دیار خراسانیم

547
0:20:46,460 --> 0:20:48,040
به دیدار علی ابن موسر

548
0:20:48,040 --> 0:20:49,920
رزا می رویم از ما چه می خواهید

549
0:20:49,920 --> 0:20:51,860
سکه های تلا

550
0:20:51,860 --> 0:20:53,540
کدام سکه تلا

551
0:20:53,540 --> 0:20:56,460
شاید ما را با دیگران اشتباه گرفته اید

552
0:20:56,460 --> 0:20:57,560
ما مسافریم

553
0:20:57,560 --> 0:21:00,300
اهل تجارت و داد و ستد نیستیم

554
0:21:00,300 --> 0:21:02,460
نه پیشتر مالی داشته ایم

555
0:21:02,460 --> 0:21:03,960
نه اکنون مالی داریم

556
0:21:03,960 --> 0:21:05,780
اگر برای سروتن گفته ما

557
0:21:05,780 --> 0:21:08
شمشیر کشیده اید اشتباه کرده اید

558
0:21:08 --> 0:21:09,680
میان دستهای خالی شما

559
0:21:09,680 --> 0:21:11,980
و دستهای خالی ما فرق زیادی نیست

560
0:21:11,980 --> 0:21:13,420
با کمی فاصله امران

561
0:21:13,420 --> 0:21:15,340
مقابل مروان ایستاده بود

562
0:21:15,340 --> 0:21:16,920
و با نفرت به اون نگاه می کرد

563
0:21:16,920 --> 0:21:20,020
حاج کریم روبه مروان و رفیقش

564
0:21:20,020 --> 0:21:21,620
اشعز کرد و گفت

565
0:21:21,620 --> 0:21:23,040
دستان ما تویست

566
0:21:23,040 --> 0:21:25,760
بی سبب خودتان را به زحمت انداخته اید

567
0:21:25,760 --> 0:21:27,760
از ما چیزی به شما نخواهد رسید

568
0:21:27,760 --> 0:21:30,120
چشمانتان را باز کنیند و ببینیند

569
0:21:30,120 --> 0:21:31,440
ما مسافریم و غریب

570
0:21:31,440 --> 0:21:32,480
دستان ما خالی است

571
0:21:32,480 --> 0:21:34,840
کجای دنیا به روی مسافرانی غریب

572
0:21:34,840 --> 0:21:36,820
که نه تاجرند و نه سروتمند

573
0:21:36,820 --> 0:21:37,900
شمشیر می کشند

574
0:21:37,900 --> 0:21:40,900
مروان با چوب دستی بلندی ایستاده

575
0:21:40,900 --> 0:21:42,500
و آماده ی حمله بود

576
0:21:42,500 --> 0:21:44,460
اشعز هم شمشیر به دست

577
0:21:44,460 --> 0:21:46,140
و با خشم نگاه می کرد

578
0:21:46,140 --> 0:21:47,200
حاج کریم ادامه داد

579
0:21:47,200 --> 0:21:50,480
ما نه جنگاوریم و نه اهل شمشیر و نیزه و خنجر

580
0:21:50,480 --> 0:21:52,400
اینگونه که شما با قذب

581
0:21:52,400 --> 0:21:53,760
بر ما شمشیر کشیده اید

582
0:21:53,760 --> 0:21:55,660
هر کس نداند گمان می کند

583
0:21:55,660 --> 0:21:58,340
بر دلاوران سرزمینی شمشیر کشیده اید

584
0:21:58,340 --> 0:22:00,120
که خون پدرانتان را ریختند

585
0:22:00,120 --> 0:22:02,200
آیا در سرزمین شما مسلمان

586
0:22:02,200 --> 0:22:04,120
را بر مسلمان رحمی نیست؟

587
0:22:04,120 --> 0:22:06,680
کدا مسافر بی توشیه

588
0:22:06,680 --> 0:22:08,320
را به مقصدی دور می روید

589
0:22:08,320 --> 0:22:09,220
هم؟

590
0:22:09,220 --> 0:22:11,060
به ما دروخ نگویید

591
0:22:11,060 --> 0:22:12,320
هر چه سکه دارید

592
0:22:12,320 --> 0:22:14,500
چه کم و چه زیاد بیرون بریزید

593
0:22:14,500 --> 0:22:16,680
آنچند دخته ماست به قدری نیست

594
0:22:16,680 --> 0:22:18,520
که دردی از شما دبا کند

595
0:22:18,520 --> 0:22:21,420
به اندازه یه سفری کتاه به خراسان است

596
0:22:21,420 --> 0:22:24,060
آن مقدار نیست که بابتش خونی ریخت شود

597
0:22:24,060 --> 0:22:25,600
یا آب روی به باد روید

598
0:22:25,600 --> 0:22:27,880
به ما رحم کنید و بگذارید برویم

599
0:22:27,880 --> 0:22:31,400
امران استاده بود و با خشم به مروان نگاه می کرد

600
0:22:31,400 --> 0:22:34,160
مروان به چشمای اون خیره شد و گفت

601
0:22:34,160 --> 0:22:35,840
نشنیدی رفیقم چه گفت؟

602
0:22:35,840 --> 0:22:38,160
همان قد که دارید ما به همان راضی می شوییم

603
0:22:38,160 --> 0:22:40,340
به شرطان که هیله در کار نباشد

604
0:22:40,340 --> 0:22:42,560
و حتی سکه ای را از ما پنها نکنید

605
0:22:42,560 --> 0:22:44,980
همین تو که مروان با امران حرف می زد

606
0:22:44,980 --> 0:22:49,020
اشعص به هاشکریم پین دوز نزدیک شد و گفت

607
0:22:49,020 --> 0:22:50,860
بگو مانم شیعیت

608
0:22:50,860 --> 0:22:55,560
هاری لابد شیعی که به دیدار علی ابن موسر رزا می روید

609
0:22:55,560 --> 0:22:59,400
ادعا نکنید که عشق به علی ابن موسر رزا

610
0:22:59,400 --> 0:23:02
سروت شما شیعیان است که من

611
0:23:02 --> 0:23:05,340
این سخن را بارها و بارها

612
0:23:05,340 --> 0:23:08,660
زبان شیعیانی چون شما شنیدم

613
0:23:08,660 --> 0:23:12,100
اشعص شمشیرشو تو هوا تکندد و فریاد زد

614
0:23:12,100 --> 0:23:15,020
این شمشیر برای بیرون کشیدن

615
0:23:15,020 --> 0:23:18,660
همین سروت از قلبهای شما کافی است

616
0:23:18,660 --> 0:23:20,640
اشعص اینو گفت و همینطور که

617
0:23:20,640 --> 0:23:23,640
به حاج کریم پین دوز نزدیک تر می شد فریاد زد

618
0:23:23,640 --> 0:23:26,560
هر چم را دارید بیرون بریزید

619
0:23:26,560 --> 0:23:30,320
تمام دارایتان تا آخرین سکه را

620
0:23:30,320 --> 0:23:35,520
حتی جامعه هایتان و پا پوش هایتان همه را

621
0:23:35,520 --> 0:23:38,720
آیا در تو حیایی نیست؟

622
0:23:38,720 --> 0:23:39,960
اشعص خندید

623
0:23:39,960 --> 0:23:41,820
بعد روبه امران کرد و گفت

624
0:23:41,820 --> 0:23:43,840
با تو نیستم جوانک

625
0:23:43,840 --> 0:23:47,760
تمام دارایت را بی کم و کاس بیرون بریز

626
0:23:47,760 --> 0:23:50,100
اشعص با شمشیرش بس به امران

627
0:23:50,100 --> 0:23:51,860
که کنار هیزوم ها استاده بود

628
0:23:51,860 --> 0:23:53,480
اشعره کرد و ادامه داد

629
0:23:53,480 --> 0:23:57,640
این اصفانیز منبانه حدیه شما می پذیرم

630
0:23:57,640 --> 0:24:02,660
مروانبال کلام رفیقش اشعص را گرفت و گفت

631
0:24:02,660 --> 0:24:04,820
هرچند پیر و فردوت است

632
0:24:04,820 --> 0:24:06,020
اما چون حدیه است

633
0:24:06,020 --> 0:24:07,900
رسم عدب را رایت می کنیم

634
0:24:07,900 --> 0:24:10,980
و اترازی نداریم

635
0:24:10,980 --> 0:24:15,700
حاج کریم پین دوز و امران به هم نگاه کردن

636
0:24:15,700 --> 0:24:18,340
و بعد آرون بین وسائلشون گشتن

637
0:24:18,340 --> 0:24:19,340
اشعص شمشیرشو

638
0:24:20,100 --> 0:24:22,380
به سمت حاج کریم گرفت و بخش گفت

639
0:24:22,380 --> 0:24:25,400
بهتر از زودتر مرا رازی کنی پیر مرد

640
0:24:25,400 --> 0:24:29,120
زودتر از آنکه کاسه کوچه که سبرم لبریز شود

641
0:24:29,120 --> 0:24:31,620
که اگر این کاسه لبریز شود

642
0:24:31,620 --> 0:24:34,840
و هنوز دستایم از سکای تو خالی باشد

643
0:24:34,840 --> 0:24:38,600
این شمشیر از اغلم نافرمانی می کند

644
0:24:38,600 --> 0:24:43,640
و خودش با زمانی دیگر با تو سخن می گوید

645
0:24:43,640 --> 0:24:44,940
ببینم

646
0:24:44,940 --> 0:24:49,540
تو که دوست نداری شمشیر به سخن درایت ها؟

647
0:24:49,540 --> 0:24:50,080
راهله

648
0:24:50,100 --> 0:24:52,660
در پناه پدرش ایستاده و از ترس

649
0:24:52,660 --> 0:24:54,100
بازوی پدرشو گرفته بود

650
0:24:54,100 --> 0:24:57,560
اشعص با نکه شمشیرش به راهله اشاره کرد و گفت

651
0:24:57,560 --> 0:24:59,480
آن دختر نمی بیند؟

652
0:24:59,480 --> 0:25:00,880
حاج کریم جوابی نداد

653
0:25:00,880 --> 0:25:03,280
اشعص روبه راهله کرد و پرسید

654
0:25:03,280 --> 0:25:07,780
اقای دختر آیا چشمانت کوچه دند و نمی بینی؟

655
0:25:07,780 --> 0:25:10,600
امران همینطور که بین وسائلش می گشت

656
0:25:10,600 --> 0:25:12,940
نگاهی به راهله و اشعص کرد

657
0:25:12,940 --> 0:25:17,820
حاج کریم پیندوز همینطور که زیر شالش دنبال چیزی می گشت گفت

658
0:25:17,820 --> 0:25:21,840
ما دستان ما خالیست و شما شمشیر و چماغ در دست دارید

659
0:25:21,840 --> 0:25:24,080
هرچه می خواهید بستانید

660
0:25:24,080 --> 0:25:26,340
ما از دارای خود دریغ نمی کنیم

661
0:25:26,340 --> 0:25:29,940
در عبا از شما نیز از محدوده ادب تجابز نکنید

662
0:25:29,940 --> 0:25:32,940
ادب؟

663
0:25:33,580 --> 0:25:36,320
به من درس ادب می دهید؟

664
0:25:36,320 --> 0:25:40,180
اشعص سرشو به سمت رفیقش مروان گردوند و با خنده گفت

665
0:25:40,180 --> 0:25:41,940
می بینی مروان؟

666
0:25:41,940 --> 0:25:42,440
می بینیم؟

667
0:25:42,440 --> 0:25:48,860
می بینی این پیرمرد نادان از شمشیر برهنهی که در دستان من هست

668
0:25:48,860 --> 0:25:51,080
ادب می طلبد

669
0:25:51,080 --> 0:25:54,980
اشعص روبه حاج کریم ادامه داد

670
0:25:54,980 --> 0:25:57,020
دگران نباش پیرمرد

671
