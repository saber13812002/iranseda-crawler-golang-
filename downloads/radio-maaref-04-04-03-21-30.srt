صلی اللہ علیه و سلام را رسید است که

655
0:27:08,660 --> 0:27:10,660
لو کوش فل قطام از دتو یقینا

656
0:27:10,660 --> 0:27:12,660
این ارشاده به نفع

657
0:27:12,660 --> 0:27:14,660
موضوع است

658
0:27:14,660 --> 0:27:16,660
نه معناش این است که بین من

659
0:27:16,660 --> 0:27:18,660
و اصرار قیامت پرده ای هست

660
0:27:18,660 --> 0:27:20,660
و اگر قیامت

661
0:27:20,660 --> 0:27:22,660
قیام کرد و این پرده

662
0:27:22,660 --> 0:27:24,660
کنار رفت

663
0:27:24,660 --> 0:27:26,660
بین من افزوده نمیشود

664
0:27:26,660 --> 0:27:28,660
این نیست چون اگر بین اون حضرت

665
0:27:28,660 --> 0:27:30,660
و بین اصرار قیامت

666
0:27:30,660 --> 0:27:32,660
پرده باشد وقتی

667
0:27:32,660 --> 0:27:34,660
کشف قطاع بشود یقینا

668
0:27:34,660 --> 0:27:36,660
یقین افزوده میشود

669
0:27:36,660 --> 0:27:38,660
این ارشاده به نفع موضوع است

670
0:27:38,660 --> 0:27:40,660
یعنی اون چه که برای دیگران

671
0:27:40,660 --> 0:27:42,660
پوشیده است

672
0:27:42,660 --> 0:27:44,660
پرده است برای من بیپرده است

673
0:27:44,660 --> 0:27:46,660
نه این که

674
0:27:46,660 --> 0:27:48,660
الان بین من و اصرار قیامت

675
0:27:48,660 --> 0:27:50,660
سطری است و اگر

676
0:27:50,660 --> 0:27:52,660
این سطح کنار رفت باز برای من

677
0:27:52,660 --> 0:27:54,660
بیتفاوت است این نیست

678
0:27:54,660 --> 0:27:56,660
لوک و شفقتهای

679
0:27:56,660 --> 0:27:58,660
دیگران برای من تواوت

680
0:27:58,660 --> 0:28:00,660
ندارد ارشاده به نفع

681
0:28:00,660 --> 0:28:02,660
موضوع است اما حالا به سراغ

682
0:28:02,660 --> 0:28:04,660
این مسئله بریم که

683
0:28:04,660 --> 0:28:06,660
این شهید به معنای شاهد

684
0:28:06,660 --> 0:28:08,660
است یا من مشهود بیانه

685
0:28:08,660 --> 0:28:10,660
که بعضی از بزرگان دارند

686
0:28:10,660 --> 0:28:12,660
باید به معنای مشهود

687
0:28:12,660 --> 0:28:14,660
باشد به قرینه کلمه علا

688
0:28:14,660 --> 0:28:16,660
و اما با تعلیلی

689
0:28:16,660 --> 0:28:18,660
که وجود مبارک مسیح سلام

690
0:28:18,660 --> 0:28:20,660
الله علیه آورده است باید معنای شاهد

691
0:28:20,660 --> 0:28:22,660
باشد اونا که گفتند و

692
0:28:22,660 --> 0:28:24,660
انتعلا کلشه این شهید

693
0:28:24,660 --> 0:28:26,660
نزیر اون که

694
0:28:26,660 --> 0:28:28,660
در زیل بعضی از هوامیم آمده است

695
0:28:28,660 --> 0:28:30,660
اولا یک فیبرت بکنه

696
0:28:30,660 --> 0:28:32,660
و علا کلشه این شهید

697
0:28:32,660 --> 0:28:34,660
اونجا یقینا شهید

698
0:28:34,660 --> 0:28:36,660
به معنای مشهود است نه شهید به معنای شاهد

699
0:28:36,660 --> 0:28:38,660
چرا؟ شون برحان

700
0:28:38,660 --> 0:28:40,660
این است که خدایی

701
0:28:40,660 --> 0:28:42,660
که همه جا مشهود است

702
0:28:42,660 --> 0:28:44,660
چگونه میشه باید کافی نباشد

703
0:28:44,660 --> 0:28:46,660
و ما برای او دلیل دیگر بیاریم

704
0:28:46,660 --> 0:28:48,660
اگر اونجا شهید به معنای

705
0:28:48,660 --> 0:28:50,660
شاهد باشد نه معنای مشهود

706
0:28:50,660 --> 0:28:52,660
خب خدا به کلشه این

707
0:28:52,660 --> 0:28:54,660
علیم است به چه دلیل

708
0:28:54,660 --> 0:28:56,660
کافی باشد که ما با اون علم

709
0:28:56,660 --> 0:28:58,660
پیدا کنیم مشهود ما باشد؟

710
0:28:58,660 --> 0:29:00,660
زیرا این است که اولا یک فیبرت

711
0:29:00,660 --> 0:29:02,660
بکنه حالا چه نیازی

712
0:29:02,660 --> 0:29:04,660
داریم به آیات آفاقی و آیات

713
0:29:04,660 --> 0:29:06,660
انفسی خود حق

714
0:29:06,660 --> 0:29:08,660
کافی است چرا خود حق کافی است؟

715
0:29:08,660 --> 0:29:10,660
برای اینکه هر چیزی را که

716
0:29:10,660 --> 0:29:12,660
شما نگاه میکنیم مشهود

717
0:29:12,660 --> 0:29:14,660
هر چیزی او است

718
0:29:14,660 --> 0:29:16,660
بالای هر چیزی مشهود

719
0:29:16,660 --> 0:29:18,660
او است شما اگر بخواهید

720
0:29:18,660 --> 0:29:20,660
یک شیعی را

721
0:29:20,660 --> 0:29:22,660
یک شخصی را یک جرمی را

722
0:29:22,660 --> 0:29:24,660
ببینی قبل از او

723
0:29:24,660 --> 0:29:26,660
فوق او در

724
0:29:26,660 --> 0:29:28,660
تلیح او اون هوا ال اول

725
0:29:28,660 --> 0:29:30,660
را میبینی اگر

726
0:29:30,660 --> 0:29:32,660
اونجا شهید به معنای شاهد

727
0:29:32,660 --> 0:29:34,660
باشد این دو تا جمعه با هم

728
0:29:34,660 --> 0:29:36,660
ناهمه هنگ است اما در

729
0:29:36,660 --> 0:29:38,660
این آیه محل بحث سوره

730
0:29:38,660 --> 0:29:40,660
ماعد اینجا شهید باید معنای شاهد باشد

731
0:29:40,660 --> 0:29:42,660
برای اینکه دارد برهان

732
0:29:42,660 --> 0:29:44,660
قام میکنند میگوید

733
0:29:44,660 --> 0:29:46,660
تو همه چیز را میدانی

734
0:29:46,660 --> 0:29:48,660
تو میدانی اونا چه

735
0:29:48,660 --> 0:29:50,660
کردن و من چه گفتم

736
0:29:50,660 --> 0:29:52,660
چرا چون بر هر چیزی تو

737
0:29:52,660 --> 0:29:54,660
شاهدی اما اگر اینجا

738
0:29:54,660 --> 0:29:56,660
به معنای مشهود باشد

739
0:29:56,660 --> 0:29:58,660
دیگه با اون برهان سازگاه نیست

740
0:29:58,660 --> 0:30:00,660
با اون مدعا سازگاه نیست

