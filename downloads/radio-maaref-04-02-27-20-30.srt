گفت ما مسلمون هستیم

634
0:24:24,620 --> 0:24:27,200
گفتم نمیخوام پس منو بذارید

635
0:24:27,200 --> 0:24:29,140
آخر گفتم پس منو بذارید

636
0:24:29,140 --> 0:24:30,580
گفتم یه بلنگ هارده چی دید اینا

637
0:24:30,580 --> 0:24:31,920
گفت مو موجود نیست

638
0:24:31,920 --> 0:24:35,400
آخر دوباره منو بلنگ کردن دو نفر دید

639
0:24:35,400 --> 0:24:38,260
یه نفر وقتی پای من پای من استخونه بهم میخود

640
0:24:38,260 --> 0:24:39,700
گفتم تو رو خدا

641
0:24:39,700 --> 0:24:41,960
دازدرم نهره زدن بذارید

642
0:24:41,960 --> 0:24:43,500
منو گذاشتند

643
0:24:43,500 --> 0:24:45,540
آخر گفتم من اینجا بمونم شما برد

644
0:24:49,880 --> 0:24:52,520
از این پای شکسته منو رو پای سالم من بذارید

645
0:24:52,520 --> 0:24:54
منو بکشید رو زمین

646
0:24:54 --> 0:24:55,040
همین کار کردن

647
0:24:55,040 --> 0:24:57,080
منو کشیدن روی زمین

648
0:24:57,080 --> 0:24:59,620
تا فاکرزشون حدود دیویس مدرا بود

649
0:24:59,620 --> 0:25:02,700
یه ستر مدرایی که منو رو زمین دو نفر می کشیدن

650
0:25:02,700 --> 0:25:03,680
همزور می بردن

651
0:25:03,680 --> 0:25:05,660
آخر یه رفعه دیدیم

652
0:25:05,660 --> 0:25:07,680
یک ماشین جیب با سرعت

653
0:25:07,680 --> 0:25:09,760
از طرف خاکی زینه آمد طرف ما

654
0:25:09,760 --> 0:25:11,660
دیگه منو بلنگ کردن

655
0:25:11,660 --> 0:25:13,160
پرد کردن تو ماشین

656
0:25:13,160 --> 0:25:14,800
من افتادم رو سندلی

657
0:25:14,800 --> 0:25:16,660
اون طرف تر یه مجرو دیگه بود

658
0:25:16,660 --> 0:25:19,760
به نام حجتلا رزایی بچه عراش بود

659
0:25:19,760 --> 0:25:22,120
این پرد کردن افتاد جلو پا ما

660
0:25:22,120 --> 0:25:24,600
ماشین اومد حرکت کنه

661
0:25:24,600 --> 0:25:25,680
چی شد؟

662
0:25:25,680 --> 0:25:28,320
نیروهای ایرانی ماشین رو گرفتن زیر خونپاره

663
0:25:28,320 --> 0:25:30,360
چونکه نور افتاد تو شیشه ماشین

664
0:25:30,360 --> 0:25:31,520
صبح زودم بود

665
0:25:31,520 --> 0:25:34,680
ما با ایرانی هدود 400-500 متر کمتر فاصله داشتیم

666
0:25:34,680 --> 0:25:36,180
اینا می دادن

667
0:25:36,180 --> 0:25:38,580
راننده ماشین به جان بچه

668
0:25:38,580 --> 0:25:40,280
ماشین خلاس می کرد

669
0:25:40,280 --> 0:25:41,960
ویل می کرد می پرد تو خاکیز

670
0:25:41,960 --> 0:25:44,260
که این ترکش ها و خونپارینا بشنه خوره

671
0:25:44,260 --> 0:25:46,680
بعد راننده اومد دور پشت ماشین

672
0:25:46,680 --> 0:25:48,380
ده پومزد و خونپاره زد

673
0:25:48,380 --> 0:25:50,420
ترکش ها به ماشین همه می خورد

674
0:25:50,420 --> 0:25:52
بردمون اون طرف خاکیز

675
0:25:52 --> 0:25:54,760
خاکیز های اینا دجی خیلی پهنی داشتن

676
0:25:54,760 --> 0:25:55,740
دحمت خاکیز

677
0:25:55,740 --> 0:25:58,960
توی خاکیز از اون طرف مثل قار درست کرده بودن

678
0:25:58,960 --> 0:26:00,520
یعنی ایران خونپاره تو

679
0:26:00,520 --> 0:26:01,720
برد چی می داد انگاه مثل

680
0:26:01,720 --> 0:26:03,340
پشه به گاب بزنه

681
0:26:03,340 --> 0:26:04,800
هیچ اتفاقی نمی افتاد

682
0:26:25,680 --> 0:26:29,880
برنامه یه حکایت آزادگی رو دنبال می کنید از رادیو معارف

683
0:26:29,880 --> 0:26:33,040
و در این بخش می خواهیم کتابی به شما معرفی کنیم

684
0:26:33,040 --> 0:26:33,320
در حوضیتی که این بخشید

685
0:26:33,320 --> 0:26:35,700
در حوضی دفاع مقدس و آزادگی

686
0:26:35,700 --> 0:26:37,820
به نام پاییز آمد

687
0:26:37,820 --> 0:26:40,640
که خانوم گلستان جعفریان اونو نوشته

688
0:26:40,640 --> 0:26:44,420
و انتشارات سوری محر هم اونو چاب کرده

689
0:26:44,420 --> 0:26:46,540
کتاب پاییز آمد

690
0:26:46,540 --> 0:26:50,300
بخشی از زندگی نامه یه سردار شهید احمد یوسفی

691
0:26:50,300 --> 0:26:54,140
از زبان همسرشون فخرستادات موسبیه

692
0:26:54,140 --> 0:26:56,060
سردار احمد یوسفی

693
0:26:56,060 --> 0:26:59,540
از شهده دفاع مقدسه که اهل زنجان بود

694
0:26:59,540 --> 0:27:01,960
و زندگی رو شهیدگونه می دید

695
0:27:01,960 --> 0:27:03,020
و در نهایت

696
0:27:03,020 --> 0:27:04,600
شهید هم شد

697
0:27:04,600 --> 0:27:06,560
در قسمتی از این کتاب

698
0:27:06,560 --> 0:27:09,600
وسیعتنامه شهید احمد یوسفی اومده

699
0:27:09,600 --> 0:27:12,260
که با خط خودش نوشته شده

700
0:27:12,260 --> 0:27:16,720
خوندن این کتاب رو به همه شما بزرگواران پیشنهاد می کنید

701
0:27:33,020 --> 0:27:37,020
موسیقی

702
0:27:37,020 --> 0:27:39,420
همراه با شما عزیزان شنونده

703
0:27:39,420 --> 0:27:43,240
همچنان پای صحبتهای جناب آقای رجبی نشستیم

704
0:27:43,240 --> 0:27:47,220
و در مورد خاطرات اصارت و آزادگیشون

705
0:27:47,220 --> 0:27:49,200
با شما صحبت می کنید

706
0:27:49,200 --> 0:27:51,120
نگاه کردم دیدم یا علی

707
0:27:51,120 --> 0:27:53,200
امکانات به اینا دادن

708
0:27:53,200 --> 0:27:56
بیش از هزاران تانج و توپ و نفر

709
0:27:56 --> 0:27:58,880
و همین طور مثل بیابون پرستان

710
0:27:58,880 --> 0:28:01,160
انگار این از تو زرورق در می داد

711
0:28:01,160 --> 0:28:03
اون زمان اتحاد جماعی رو شدیدیم

712
0:28:03,020 --> 0:28:05,260
شعوردی بیش از شست درستد

713
0:28:05,260 --> 0:28:07,380
که ریجمبرش گرباچوف بود

714
0:28:07,380 --> 0:28:09,080
سلاهای اراقو تحچیز می کرد

715
0:28:09,080 --> 0:28:10,280
بیش از شست درستد

716
0:28:10,280 --> 0:28:12,080
بهترین هواپیما ها

717
0:28:12,080 --> 0:28:14,280
هواپیما میگی بیس و پنگ میگی بیس و نو

718
0:28:14,280 --> 0:28:15,400
هواپیمای سخو

719
0:28:15,400 --> 0:28:17,560
بهترین تانکا تانکای تیه افتاد

720
0:28:17,560 --> 0:28:18,680
و بهترین موشکا

721
0:28:18,680 --> 0:28:20,560
همه چی در اختیار سددام بود

722
0:28:20,560 --> 0:28:22,500
بیش از شهت افتاد کشور جهان

723
0:28:22,500 --> 0:28:25
بهترین امکاناتشون به سددام می دادن

724
0:28:25 --> 0:28:26,460
اول چیزی که خواستم

725
0:28:26,460 --> 0:28:28,520
صبح ساعت پنج و نیم شیش بود

726
0:28:28,520 --> 0:28:29,580
افتاد تازه زده بود

727
0:28:29,580 --> 0:28:31,160
گفتم آب میخوام

728
0:28:31,160 --> 0:28:32,220
آب یخ برمانیم

729
0:28:32,220 --> 0:28:33,220
حالا ما تو جبه همون

730
0:28:33,220 --> 0:28:35,220
سنگرامون ساعت تا بعد از برم

731
0:28:35,220 --> 0:28:36,100
آب یخ نداشت

732
0:28:36,100 --> 0:28:37,180
اینا صبح زود

733
0:28:37,180 --> 0:28:39,140
هنو ساعت پنج خورده آب یخ

734
0:28:39,140 --> 0:28:40,660
آب یخ خورد به من دار

735
0:28:40,660 --> 0:28:41,640
من آب خوردم

736
0:28:41,640 --> 0:28:43,860
بعد حالا سری سری بازجی

737
0:28:43,860 --> 0:28:45,320
یه سری سآلات و اینه هم من کرد

738
0:28:45,320 --> 0:28:47,540
من همیشه سعی میکنم تو بازجی ها

739
0:28:47,540 --> 0:28:49,600
نیروهای ایران رو زیاد جلبه بدم

740
0:28:49,600 --> 0:28:51,800
اینا از نیروهای ایران وحشتی داشته باش

741
0:28:51,800 --> 0:28:53,060
از تعداد نفرات

742
0:28:53,060 --> 0:28:54,020
تعداد لشکرات

743
0:28:54,020 --> 0:28:54,660
تعداد تیپا

744
0:28:54,660 --> 0:28:56,560
چون که من سربازی رفته بودم

745
0:28:56,560 --> 0:28:58,740
بعد از خدمت سربازی اومدم بسیج اینا

746
0:28:58,740 --> 0:29:01,680
و خلاصه این بود که همه اطلاعاتی زیاد راجبه

747
0:29:01,680 --> 0:29:03,700
هر سه شوینا داشتم نیرای جاندان بدینا

748
0:29:03,700 --> 0:29:04,640
بعد از اون

749
0:29:04,640 --> 0:29:07,140
خلاصه یه سری بازجی هم ما کردن

750
0:29:07,140 --> 0:29:08,700
ما رو توی ماشینی گذاشتن

751
0:29:08,700 --> 0:29:09,600
ماشینی جیپی

752
0:29:17,540 --> 0:29:31,780
به پایان برنامه گیمشبه حکایت آزادگی رسیدیم

753
0:29:31,780 --> 0:29:33,460
انشالله در برنامه بعد

754
0:29:33,460 --> 0:29:36,940
با ادامه خاطرات جناب آقای عبدالله رجبی

755
0:29:36,940 --> 0:29:40,120
آزاده عزیزمون در خدمت شما خواهیم بود

756
0:29:40,120 --> 0:29:42,900
اگر نظر و نقد و پیشنهادی دارید

757
0:29:42,900 --> 0:29:44,780
حتما با ما درمیون بگذارید

758
0:29:45,340 --> 0:29:46,460
سی سد و بیست و نوه

759
0:29:46,460 --> 0:29:47,520
در پان سد و پنجه

760
0:29:47,520 --> 0:29:49,780
و یک و دو پیش شماره سفر

761
0:29:49,780 --> 0:29:51,940
ویست و پنج در خدمت شماست

762
0:29:51,940 --> 0:29:54,540
که راه های ارتباطی با این برنامه است

763
0:29:54,540 --> 0:29:56,020
تا فرصتی دوباره

764
0:29:56,020 --> 0:29:57,940
خدای مهربان یار و نگهدارتون

