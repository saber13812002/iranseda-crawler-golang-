0:26:00,040 --> 0:26:02,160
مدده عزیز ما هم

403
0:26:02,160 --> 0:26:03,880
میخواد از اون تقلید بکنه

404
0:26:03,880 --> 0:26:04,740
و

405
0:26:04,740 --> 0:26:06,300
در مجلس امام حسین کارو میکنه

406
0:26:06,300 --> 0:26:07,480
این از دو حال خارج نیست

407
0:26:07,480 --> 0:26:10,040
یا قناه است

408
0:26:10,040 --> 0:26:12,180
و میخاند

409
0:26:12,180 --> 0:26:14,320
یعنی نحوه خاندن

410
0:26:14,320 --> 0:26:16,080
سبک خوندن آواز

411
0:26:16,080 --> 0:26:18,180
آواز لحویه که اینو انشالله

412
0:26:18,180 --> 0:26:19,460
تو جلساتو باید توضیح میدیم

413
0:26:19,460 --> 0:26:20,840
این که حرامه این هیچی

414
0:26:20,840 --> 0:26:22,820
این اصلا میخواد تو روزه باشه نباشه

415
0:26:22,820 --> 0:26:25,680
اصلا قرارات قرآن هم با قناه باشه خواهیم گفت

416
0:26:25,680 --> 0:26:28,320
این هیچی نه یه وقت اصلا قناه نیست

417
0:26:28,320 --> 0:26:30,260
ولی همینیست که ارز کردم

418
0:26:30,260 --> 0:26:32,280
شباهتی پیدا میکنه

419
0:26:32,280 --> 0:26:33,480
با اون لحن

420
0:26:33,480 --> 0:26:34,440
با اون سبک

421
0:26:34,440 --> 0:26:36,860
و شنونده اصلا ذهنش میره سمت

422
0:26:36,860 --> 0:26:38,120
یه خاننده

423
0:26:38,120 --> 0:26:40
ارز میشه باید غربیه

424
0:26:40 --> 0:26:41,740
یا نه خاننده

425
0:26:41,740 --> 0:26:43,300
وطنیه

426
0:26:43,300 --> 0:26:45,800
ولی خب مثلا یه اشعار آشقانه

427
0:26:45,800 --> 0:26:48,780
مبتزل ارز میشه باید که

428
0:26:48,780 --> 0:26:50,600
بی اساسی خونده با اون سبک

429
0:26:50,600 --> 0:26:52,540
مسرطه این اشعارم با یه جمله

430
0:26:52,540 --> 0:26:53,800
ارتباطی میخواد اینو

431
0:26:53,800 --> 0:26:56,200
ربطش بده به واقعی کربلا

432
0:26:56,200 --> 0:26:58
و یه جوری بقوله معروف که بگه

433
0:26:58 --> 0:27:00,020
این مرتبطه با این موضوع

434
0:27:00,020 --> 0:27:02,300
خب این قناه هم که نباشه

435
0:27:02,300 --> 0:27:03,700
جایز نیست چرا؟

436
0:27:03,700 --> 0:27:06,080
به خاطر این که این در شعن

437
0:27:06,080 --> 0:27:07,980
مجلس امام حسین نیست

438
0:27:07,980 --> 0:27:10,580
در شعن خود سید و شهده هم نیست

439
0:27:10,580 --> 0:27:11,960
که شما روزه امام حسین

440
0:27:11,960 --> 0:27:13,760
با این سبک بخونید پس بنابراین

441
0:27:13,760 --> 0:27:15,740
نکته اول اینست که رعایت بکنن

442
0:27:15,740 --> 0:27:18,140
و به این سبک

443
0:27:18,140 --> 0:27:19,800
هرچند قناه هم نباشه

444
0:27:19,800 --> 0:27:22,080
به این سبک نخونن اینشه وحنه

445
0:27:22,080 --> 0:27:23,280
یعنی این سبکی

446
0:27:23,280 --> 0:27:25,540
مجلس سید و شهده هست

447
0:27:25,540 --> 0:27:27,540
و اون شخص

448
0:27:27,540 --> 0:27:28,800
نباید این کار بکنه

449
0:27:28,800 --> 0:27:31,780
و افرادم اگر بدانن که این مجلس

450
0:27:31,780 --> 0:27:33,700
به این شکل داره برگذار میشه

451
0:27:33,700 --> 0:27:35,160
تو استفتاءات آیونه

452
0:27:35,160 --> 0:27:37,440
از نظر خود افراد هم

453
0:27:37,440 --> 0:27:39,660
شرکت تو این مجلس جایز نیست

454
0:27:39,660 --> 0:27:41,040
نباید شرکت بکنن

455
0:27:41,040 --> 0:27:43,660
خب این یه طرف بحثه

456
0:27:43,660 --> 0:27:45,320
بحث بعدی اینست که نه

457
0:27:45,320 --> 0:27:47,980
اصلا وارد فاز قناه میشود

458
0:27:47,980 --> 0:27:49,320
قناه چیه؟

459
0:27:49,320 --> 0:27:51,620
قناه آوازیست که

460
0:27:51,620 --> 0:27:53,980
مناسب مجالس خوشگذران هاست

461
0:27:53,980 --> 0:27:56,060
مناسب مجالس فساقه

462
0:27:56,060 --> 0:27:57,940
مناسب مجالس

463
0:27:57,940 --> 0:27:59,520
اهل گناهه

464
0:27:59,520 --> 0:28:00,620
از قدیم هم بوده

465
0:28:00,620 --> 0:28:03,380
این سبک سبک خوندن

466
0:28:03,380 --> 0:28:05,600
مناسب مجالس

467
0:28:05,600 --> 0:28:06,480
لحو لعیب هست

468
0:28:06,480 --> 0:28:08,360
اینو بیایی تو مجلس ما موسیم بخونی

469
0:28:08,360 --> 0:28:10,720
حرام هست که اینم در جلسه

470
0:28:10,720 --> 0:28:12,440
بعد توضیحش رو خواهیم داد

471
0:28:12,440 --> 0:28:14,240
خیلی متشکر از جنابالی

472
0:28:14,240 --> 0:28:16,480
اصدقی وحید پوره عزیز با شما بزرگ باران هستیم

473
0:28:17,040 --> 0:28:18,460
شنواندگان زمزم

474
0:28:18,460 --> 0:28:20,120
محکام بخش استفتاء

475
0:28:20,120 --> 0:28:21,900
تا پاس صبح سالهای شریع شما

476
0:28:21,900 --> 0:28:24,480
سبحان الله

477
0:28:24,480 --> 0:28:26,480
والحمدلله

478
0:28:27,380 --> 0:28:31,140
ولا اله الا الله

479
0:28:31,140 --> 0:28:33,700
والله اکبر

480
0:28:33,700 --> 0:28:36,460
اگر در منش بازی

481
0:28:36,460 --> 0:28:38,880
که با اعضای خانواده خودمون انجام میشه

482
0:28:38,880 --> 0:28:40,340
شرط بذاریم که

483
0:28:40,340 --> 0:28:42,700
بازنده برای افراد بازی

484
0:28:42,700 --> 0:28:44,400
چیزی رو خریداری کنه

485
0:28:44,400 --> 0:28:46,640
آیا این کار با این روشی

486
0:28:46,640 --> 0:28:48,340
که توضیح دادیم از نظر شریعی

487
0:28:48,460 --> 0:28:50,300
اشکال داره و

488
0:28:50,300 --> 0:28:52,160
مرتکب گناه میشین

489
0:28:52,160 --> 0:28:54,340
پاسخه حجتال اسلام و المسلمین

490
0:28:54,340 --> 0:28:56,140
فرلا زده به این سآل طبق فتوه

491
0:28:56,140 --> 0:28:57,660
حضرت آیتولا خامنی

492
0:28:57,660 --> 0:28:59,920
به نظر حضرت آقا

493
0:28:59,920 --> 0:29:02,240
در بازی با

494
0:29:02,240 --> 0:29:03,440
ابزار قمار

495
0:29:03,440 --> 0:29:05,420
چه شرطه

496
0:29:05,420 --> 0:29:08,300
بردباخت باشد چه نباشد

497
0:29:08,300 --> 0:29:09,920
بلو بره سرگرمی باشد

498
0:29:09,920 --> 0:29:12,160
و با ابزاری که وسیل قمار

499
0:29:12,160 --> 0:29:14,380
بازی نیست اگر شرط

500
0:29:14,380 --> 0:29:16,460
بگذارن که بازنده

501
0:29:16,460 --> 0:29:18,460
به برنده یا به ورندگانه

502
0:29:18,460 --> 0:29:19,960
یا بازی کنندگان

503
0:29:19,960 --> 0:29:21,960
پولی بدهد چیزی بدهد

504
0:29:21,960 --> 0:29:23,300
یا خدمتی برساند

505
0:29:23,300 --> 0:29:25,900
یا مثلا همچنین که اشاره کردن

506
0:29:25,900 --> 0:29:27,920
چیزی بره اونها بخرد بسنی بخرد

507
0:29:27,920 --> 0:29:29,600
نهار بخرد امثال اینها

508
0:29:29,600 --> 0:29:31,940
این جایز نیست و

509
0:29:31,940 --> 0:29:34,420
حرام است و قمار محسوب میشه

510
0:29:34,420 --> 0:29:36,040
و این که

511
0:29:36,040 --> 0:29:37,960
اعضای خانواده باشند و

512
0:29:37,960 --> 0:29:40,060
از قوم خیشای خودمون باشند

513
0:29:40,060 --> 0:29:41,600
یا غیر قریبه باشند

514
0:29:41,600 --> 0:29:43,820
در این مسئله تأثیری ندارد

515
0:29:43,820 --> 0:29:46,260
اگر بعد از وضوع جایی از بدن

516
0:29:46,260 --> 0:29:48,400
خون بیاد باید دوباره وضوع گرفت

517
0:29:48,400 --> 0:29:50,700
مرجع تقلید هم از رت آیتالله شبهری

518
0:29:50,700 --> 0:29:51,580
زنجانی هستن

519
0:29:51,580 --> 0:29:54,320
او جتال اسلام و المسلمین جباهری در پاسخ کفتن

520
0:29:54,320 --> 0:29:56,320
اگر شخصی وضوع بگیره

521
0:29:56,320 --> 0:29:58,500
و بعد از وضوع گرفتن

522
0:29:58,500 --> 0:30:00,260
خون از بدنش خارج بگیره

