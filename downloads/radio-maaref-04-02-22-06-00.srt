623
0:25:48,700 --> 0:25:50,060
این سه مطلب در میاد

624
0:25:50,060 --> 0:25:52,280
همه این های تشریح کرد در باری

625
0:25:52,280 --> 0:25:54,540
کسرت سآل هم فرمود این آیه است

626
0:25:54,540 --> 0:25:57,360
که لا تسعروان اشیا انتو بلکم تسعکم

627
0:25:57,360 --> 0:25:59,420
فرمود هر چیزی سآل نکنید

628
0:25:59,420 --> 0:25:59,980
بلاخره

629
0:25:59,980 --> 0:26:01,640
افهالله انها

630
0:26:01,640 --> 0:26:03,900
والله قفور حلیمون

631
0:26:03,900 --> 0:26:07,200
خب هم از گذشته های شما

632
0:26:07,200 --> 0:26:08,080
میگذرد

633
0:26:08,080 --> 0:26:11,620
و هم از این بیهوسدگی های شما

634
0:26:11,620 --> 0:26:12,800
او تحمل دارد

635
0:26:12,800 --> 0:26:13,760
و حلم دارد

636
0:26:13,760 --> 0:26:15,340
بردبار است خلاصه

637
0:26:15,340 --> 0:26:17,620
معمولا اگر

638
0:26:17,620 --> 0:26:19,740
مقفرت با حلم

639
0:26:19,740 --> 0:26:21,760
یا مقفرت با رحمت

640
0:26:21,760 --> 0:26:24,160
امثال ذارک در قرآن کریم زکر بشود

641
0:26:24,160 --> 0:26:25,560
اول مقفرت است

642
0:26:25,560 --> 0:26:26,760
بعد رحمت

643
0:26:26,760 --> 0:26:30,620
چون مقفرت برای اون لکیگیری و شستشوست

644
0:26:30,620 --> 0:26:31,960
بعد اون رحمت

645
0:26:31,960 --> 0:26:34,500
برای اون سبقی الهی بخشیدن است

646
0:26:34,500 --> 0:26:36,220
و بلاخره لباس یا دیوار

647
0:26:36,220 --> 0:26:38
یا یکی کسی باید رنگ خوب بزند

648
0:26:38 --> 0:26:40,680
اول اون لکه ها را میزوداید

649
0:26:40,680 --> 0:26:42,420
قبار روبی می کند

650
0:26:42,420 --> 0:26:44,060
بعد رنگش می کند

651
0:26:44,060 --> 0:26:46,200
این مقفرت اون قبار روبی

652
0:26:46,200 --> 0:26:47,440
و لکیگیری است

653
0:26:47,440 --> 0:26:49,820
بعد اون سبقی الهی دادن است

654
0:26:49,820 --> 0:26:52,340
وگرنه سبقی الهی که به من احسن

655
0:26:52,340 --> 0:26:53,460
امینالله سبقی

656
0:26:53,460 --> 0:26:55,640
روی انسانی که

657
0:26:55,640 --> 0:26:57,740
رانه علاقه روبه ماکانو

658
0:26:57,740 --> 0:26:59,200
یک سوون اگر بیاید

659
0:26:59,200 --> 0:27:01,180
بلاخره اثر سوی دارد

660
0:27:01,180 --> 0:27:02,920
این زم خبیس و تیب

661
0:27:02,920 --> 0:27:04,600
اون تیب را هم خبیس می کند

662
0:27:04,600 --> 0:27:06,940
خبیس کارش این محلق است بلاخره

663
0:27:06,940 --> 0:27:09,620
تا مقفرت نباشد لکیگیری نشود

664
0:27:09,620 --> 0:27:11,580
گناهان زدوده نشود

665
0:27:11,580 --> 0:27:13,680
اون رحمت نمی آید

666
0:27:13,680 --> 0:27:16,120
گای انسان وقتی وارد مکه شد

667
0:27:16,120 --> 0:27:17,420
چون مستحب است

668
0:27:17,420 --> 0:27:19,960
اولین باری که انسان وارد مکه می شود

669
0:27:19,960 --> 0:27:21,080
و دهم

670
0:27:21,080 --> 0:27:22,340
مسئله حرام می شود

671
0:27:22,340 --> 0:27:25,240
سجده کند و از ذات اقبس اله

672
0:27:25,240 --> 0:27:26,380
قفران طلب کند

673
0:27:26,380 --> 0:27:31,280
شد خیلی ها تحجب بکنند

674
0:27:31,280 --> 0:27:33,980
که ما الان چرا از خدا مقفرت طلب میکنیم

675
0:27:33,980 --> 0:27:36,240
در حالی که اگر حساب ها بررسیب می شود

676
0:27:36,240 --> 0:27:37,960
خیلی ها مشکل داریم

677
0:27:37,960 --> 0:27:39,560
وقتی فیوزات این

678
0:27:39,560 --> 0:27:41,980
زیف الرحمانی نصیب انسان می شود

679
0:27:41,980 --> 0:27:43,280
که لکیگیری بشود

680
0:27:43,280 --> 0:27:45,240
اولین کاری که

681
0:27:45,240 --> 0:27:46,780
حاجیب معتمیر میکند

682
0:27:46,780 --> 0:27:48,340
وقتی وارد مستحب حرام شد

683
0:27:48,340 --> 0:27:50,220
بیت الهی را دید

684
0:27:50,220 --> 0:27:51,460
به خاک می افتد

685
0:27:51,460 --> 0:27:56,280
بعد از این که مقفرت شد

686
0:27:56,280 --> 0:27:58,460
اونگاه رحمت است و ماننده

687
0:27:58,460 --> 0:27:59,520
معمولا این

688
0:27:59,520 --> 0:28:02,120
السلام علیکم و رحمت الله و برکاتم

689
0:28:02,120 --> 0:28:02,800
همین است

690
0:28:02,800 --> 0:28:05,200
چه در دعاها چه در زیارتها

691
0:28:05,200 --> 0:28:06,840
این السلام علیکم

692
0:28:06,840 --> 0:28:09,300
یه دعاست که قلب سالم بشود

693
0:28:09,300 --> 0:28:10,940
اون شکستگیه ها

694
0:28:10,940 --> 0:28:11,960
اون لکیگیری ها

695
0:28:11,960 --> 0:28:13,400
اونها تمنی بشود

696
0:28:13,400 --> 0:28:15,380
حالا که دل سالم شد

697
0:28:15,380 --> 0:28:16,880
مثل زرف سالم

698
0:28:16,880 --> 0:28:19,640
زرف سالم را آدم برای زرفیتش

699
0:28:19,640 --> 0:28:22,040
که نمیخواد برای مذروفش طلب میکند

700
0:28:22,040 --> 0:28:23,900
اون و رحمت الله که

701
0:28:23,900 --> 0:28:25,940
می آید برای مذروف

702
0:28:25,940 --> 0:28:27,460
بودن این زرف است

703
0:28:27,460 --> 0:28:30,580
این که میگونم السلام علیکم و رحمت الله

704
0:28:30,580 --> 0:28:31,780
این سلام

705
0:28:31,780 --> 0:28:33,960
همون سلامت قلب را طلب میکنیم

706
0:28:34,580 --> 0:28:36,280
حالا یا دعاست یا تحییت

707
0:28:36,280 --> 0:28:38,280
بعد از این که سلامت قلب

708
0:28:38,280 --> 0:28:39,280
تمنی شد

709
0:28:39,280 --> 0:28:41,400
که یک زرف خوبی است

710
0:28:41,400 --> 0:28:43,880
مذروف خوب را هم طلب میکنیم

711
0:28:43,880 --> 0:28:45,320
که رحمت خدا

712
0:28:45,320 --> 0:28:47,220
در قلب سالم بریزد

713
0:28:47,220 --> 0:28:49,320
وگرنه قلبی که مریض باشد

714
0:28:49,320 --> 0:28:51,460
یا ناقص باشد

715
0:28:51,460 --> 0:28:53,440
این زرفیتش خوب نیست

716
0:28:53,440 --> 0:28:54,880
که اینها زهل غروب

717
0:28:54,880 --> 0:28:56,800
اویف خیروها او آها

718
0:28:56,800 --> 0:28:58,560
این ها مال مغفرت و رحمت

719
0:28:58,560 --> 0:29:00,040
اما مغفرت و حلم

720
0:29:00,040 --> 0:29:03,040
ذات اقدس اله حلیم است

721
0:29:03,040 --> 0:29:05,080
حلیم از اون کلمات

722
0:29:05,080 --> 0:29:06,920
برجسته عربی است

723
0:29:06,920 --> 0:29:09,040
که شاد معادل فارسی نداشته باشد

724
0:29:09,040 --> 0:29:10,740
ما در فارسی ناچاریم

725
0:29:10,740 --> 0:29:13,160
دوتا کلمه را کنار هم زک بکنیم

726
0:29:13,160 --> 0:29:14,860
با یه پس بند و پیش بندی

727
0:29:14,860 --> 0:29:16,580
ای رو مراکب بکنیم تا

728
0:29:16,580 --> 0:29:19,580
محتوی حلیم را تفهیم کند

729
0:29:19,580 --> 0:29:20,980
میگیم بردبار

730
0:29:20,980 --> 0:29:22,440
بردبار یعنی که این که

731
0:29:22,440 --> 0:29:25,460
بار مسیبت را یا بارهای دیگر را میبرد

732
0:29:25,460 --> 0:29:26,960
این بار را به زمین

733
0:29:26,960 --> 0:29:28,300
نمیگذارد

734
0:29:28,300 --> 0:29:31,140
ولی در عربی این کلمه بسیط

735
0:29:31,140 --> 0:29:32,780
اون معنا را تفهیم میکند

736
0:29:32,780 --> 0:29:33,840
حلیم است

737
0:29:33,840 --> 0:29:37,200
دیگران تحمل ندارن بعضی از مسائب را

738
0:29:37,200 --> 0:29:38,480
و بعضی از مشکلات را

739
0:29:38,480 --> 0:29:40,500
این بار را به زمین میزنن

740
0:29:40,500 --> 0:29:43,520
ولی اده این بار را به مقصد میرسانن

741
0:29:43,520 --> 0:29:44,800
بلاخره بردبار

742
0:29:44,800 --> 0:29:46,580
حالا ذات اقدسیلا

743
0:29:46,580 --> 0:29:48,300
هر باری را که

744
0:29:48,300 --> 0:29:51,240
از اشخاص باشد او تحمل میکند

745
0:29:51,240 --> 0:29:52,360
او حلم دارد

746
0:29:52,360 --> 0:29:55,460
همین قدرت ها مال ذات اقدسیلا است

747
0:29:55,460 --> 0:29:57,460
بعد این خطر را هم گوشتد

748
0:29:57,460 --> 0:29:59,880
که فهمید قد سعال ها قومون من قبل

