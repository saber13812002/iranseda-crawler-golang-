623
0:26:06,240 --> 0:26:08,480
با این وسط رسانه های گروهی

624
0:26:08,480 --> 0:26:09,640
کار سختی نیست

625
0:26:09,640 --> 0:26:12,400
اما چهار قرن قبل کسی بخواد

626
0:26:12,400 --> 0:26:14,160
صد هزار نفر را هدایت کند

627
0:26:14,160 --> 0:26:16,420
خیلی باید اینسان بارسته باشد

628
0:26:16,420 --> 0:26:18,660
او مرجع تقلید بود امام جمعه بود

629
0:26:18,660 --> 0:26:20,680
امام جمعه بود مدرس بود

630
0:26:20,680 --> 0:26:22,720
زعیم اوزه علمی اسفهان بود

631
0:26:22,720 --> 0:26:24,180
به هر تقدیر اون

632
0:26:24,180 --> 0:26:26,440
توانه صد هزار نفر را هدایت کند

633
0:26:26,440 --> 0:26:29,120
فرمود من صد هزار نفر را هدایت کردم

634
0:26:29,120 --> 0:26:31,060
اما یک نفر از کسانی که

635
0:26:31,060 --> 0:26:33,180
این راه را تقید کند من پیدا نکردن

636
0:26:33,180 --> 0:26:34,840
اون کار آسانی نیست

637
0:26:34,840 --> 0:26:37,300
لذا قرآن با اکثری مردم

638
0:26:37,300 --> 0:26:38,820
که سخن میگوید مرحله

639
0:26:38,820 --> 0:26:41,420
من خشی الرحمان بلغیب هست

640
0:26:41,420 --> 0:26:43,340
لیونزر من کان کذا هست

641
0:26:43,340 --> 0:26:45,620
یؤمنون بلغیب هست

642
0:26:45,620 --> 0:26:47,620
لیعلم الله من یخافه

643
0:26:47,620 --> 0:26:49,380
و بلغیب هست نماننده ها

644
0:26:49,380 --> 0:26:51,460
فرمود خدا میاز ماید

645
0:26:51,460 --> 0:26:52,660
تا معلوم بشه

646
0:26:52,660 --> 0:26:55,140
تو بحثای امتحانی هم مرازه فرمودید

647
0:26:55,140 --> 0:26:56,740
که این علم علم فعیلیست

648
0:26:56,740 --> 0:26:59,080
و گهنم علم ذاتی

649
0:26:59,080 --> 0:27:00,900
اقدسه اله که در ازل بود

650
0:27:00,900 --> 0:27:01,920
اون همباره هست

651
0:27:01,920 --> 0:27:04,160
فرمود یعلم خائنه تل ایون

652
0:27:04,160 --> 0:27:05,360
و ما تخفی صدو

653
0:27:05,360 --> 0:27:07,900
چه بگوید چه نگوید خدا میداند

654
0:27:07,900 --> 0:27:10,060
وعلما اندلا یعلم ما

655
0:27:10,060 --> 0:27:11,600
فی انفوس کن فهزرو

656
0:27:11,600 --> 0:27:14,380
اینه حشداریست

657
0:27:14,380 --> 0:27:17,060
فرمود اونی که در نهانخانه شماست

658
0:27:17,060 --> 0:27:18,560
و حتی احیانا

659
0:27:18,560 --> 0:27:20,300
بر خود شما مخفیست

660
0:27:20,300 --> 0:27:22,880
و شما ناخداباز زیر فرمان

661
0:27:22,880 --> 0:27:24,620
و اون خود خود

662
0:27:24,620 --> 0:27:26,780
در اون درون در اون کار میکنید

663
0:27:26,780 --> 0:27:27,900
خدا اونه میگوند

664
0:27:27,900 --> 0:27:33,940
فرمود اگه حرفتون جهر بود

665
0:27:33,940 --> 0:27:35,840
نه تنها جهر را خدا میداند

666
0:27:35,840 --> 0:27:37,880
خب جهر را دیگری هم میشنبه

667
0:27:37,880 --> 0:27:39,680
سر را هم میداند

668
0:27:39,680 --> 0:27:41,560
نه تنها سر را میداند

669
0:27:41,560 --> 0:27:41,580
سر را هم میداند

670
0:27:41,580 --> 0:27:43,060
سر را خب شما هم میدانید

671
0:27:43,060 --> 0:27:46,060
اخفای از سر که بر خود شما مخفیست

672
0:27:46,060 --> 0:27:47,680
و هم یه سبون هم هم

673
0:27:47,680 --> 0:27:49,740
یه حسن و سنه ها اون رو خدا میداند

674
0:27:49,740 --> 0:27:51,660
خیلی از موارد است که انسان

675
0:27:51,660 --> 0:27:54,060
در خیشتن فرو برود

676
0:27:54,060 --> 0:27:55,220
با خبر میشه برد

677
0:27:55,220 --> 0:27:57,580
اما یه خودی در درون خود اوست

678
0:27:58,560 --> 0:27:59,900
که با خبر نیست

679
0:27:59,900 --> 0:28:01,640
اون خود خود میشه

680
0:28:01,640 --> 0:28:03,220
اخفای از سر

681
0:28:03,220 --> 0:28:05,120
لذا خیلی از موارد انسان

682
0:28:05,120 --> 0:28:07,760
گاهی کار رو بیس سال سی سال چهر سال

683
0:28:07,760 --> 0:28:09,780
انجام میده بعد معلوم شد دستش خالیه

684
0:28:09,780 --> 0:28:11,880
این که بعد معلوم شد

685
0:28:11,880 --> 0:28:13,500
دستش خالیه برای این که

686
0:28:13,500 --> 0:28:15,920
این خود اول با مرز و پیری

687
0:28:15,920 --> 0:28:17,440
و همه این ها از بین رفته

688
0:28:17,440 --> 0:28:20,180
اون خود خود اون درون خودشی نشون داد

689
0:28:20,180 --> 0:28:21,820
اینه که در اواخر عمر

690
0:28:21,820 --> 0:28:24,180
ما دیدیم کسانی که

691
0:28:24,180 --> 0:28:25,900
یه وقتی میگفت من پنجاه هزار

692
0:28:25,900 --> 0:28:27,780
کتاب رو معرفی کردم در کمال

693
0:28:27,780 --> 0:28:29,520
غروب همین اواخر گفت من

694
0:28:29,520 --> 0:28:32,200
بوی بردم خب اینا هست

695
0:28:32,200 --> 0:28:33,940
انسان وقتی این

696
0:28:33,940 --> 0:28:35,700
هجاب را دارد

697
0:28:35,700 --> 0:28:37,700
از اون خود خود بیخبر هست

698
0:28:37,700 --> 0:28:40,100
حالا وسیل مرز به وسیل پیری

699
0:28:40,100 --> 0:28:41,620
همه این ها

700
0:28:41,620 --> 0:28:44,240
فروکش کرده اون خود خود

701
0:28:44,240 --> 0:28:45,380
خودشی نشون میده

702
0:28:45,380 --> 0:28:47,800
اون اخهای

703
0:28:47,800 --> 0:28:50,140
از راز خودشی نشون میده

704
0:28:50,140 --> 0:28:52,060
اینه که انسان به هم یه حسبون

705
0:28:52,060 --> 0:28:53,780
و انه هم یه حسن و سنان

706
0:28:53,780 --> 0:28:56,160
تو اواخر عمر معلوم میشه

707
0:28:56,160 --> 0:28:57,200
به تو برزخ و مر

708
0:28:57,200 --> 0:29:00,100
ذات اقدس الان فرموندی چیزایی که

709
0:29:00,660 --> 0:29:01,740
شما به عنوان

710
0:29:01,740 --> 0:29:03,800
اصرار در دل زخیره کردید

711
0:29:03,800 --> 0:29:04,600
ما میدانیم

712
0:29:04,600 --> 0:29:07,560
چیزهایی که شما را زخیره کرده

713
0:29:07,560 --> 0:29:09,120
به شما از اونها بیخبرید

714
0:29:09,120 --> 0:29:11,520
و در فرمان اونا دارید کار میکنید

715
0:29:11,520 --> 0:29:13,060
اونا را ما میدانیم

716
0:29:13,060 --> 0:29:15,320
خب اون مربوط به علم ذات اقدس الان هست

717
0:29:15,320 --> 0:29:16,820
اما این که فرموند

718
0:29:16,820 --> 0:29:20,800
این علم فعیلیست

719
0:29:20,800 --> 0:29:22,140
علم فعیلی

720
0:29:22,140 --> 0:29:23,940
صفت فعیل خداست

721
0:29:23,940 --> 0:29:24,820
این یه مقدمه

722
0:29:24,820 --> 0:29:27,960
فعیل خداست خارج از ذات خداست

723
0:29:27,960 --> 0:29:28,480
این دو

724
0:29:28,480 --> 0:29:30,280
گاهی هست گاهی نیست

725
0:29:30,280 --> 0:29:32,180
حادث هست امکان دارد

726
0:29:32,180 --> 0:29:34,580
و همه احکام خلق برو باره

727
0:29:34,600 --> 0:29:36,600
این علم هست که علم فعیلیست

728
0:29:36,600 --> 0:29:38,600
که فرموند ما میازمائیم

729
0:29:39,140 --> 0:29:40,740
تا این روشن بشود

730
0:29:40,740 --> 0:29:42,960
که این علم فعیلیست صفت مخلوق

731
0:29:42,960 --> 0:29:45,020
در حقیقت این مخلوق هست

732
0:29:45,020 --> 0:29:47,380
صفت فعیلی خالق هست

733
0:29:47,380 --> 0:29:49,280
یعنی این فعیل خالق هست

734
0:29:49,280 --> 0:29:51,140
فعیل خالق یعنی مخلوق

735
0:29:51,140 --> 0:29:52,900
وگه انا خودش اعلام کرد

736
0:29:52,900 --> 0:29:54,680
فمود بعلمو انالله

737
0:29:54,680 --> 0:29:57,240
یعلم ما فی انفسکم فحذرو

738
0:29:57,240 --> 0:29:59,380
خب چنین ذات اقدس اله

739
0:29:59,380 --> 0:29:59,880
نیازی

