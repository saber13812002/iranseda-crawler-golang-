0:27:08,020 --> 0:27:10,020
مدت عمر از گلو بریخد

651
0:27:10,020 --> 0:27:12,020
خود را توحیز خون دل

652
0:27:12,020 --> 0:27:14,020
چند ساله کرد

653
0:27:14,020 --> 0:27:16,020
وسیعت گردن

654
0:27:16,020 --> 0:27:18,020
حسن جان

655
0:27:18,020 --> 0:27:20,020
بعد از شهادت منو ببرید

656
0:27:20,020 --> 0:27:22,020
کنار حرم رسول الله

657
0:27:22,020 --> 0:27:24,020
فقد لعجد

658
0:27:24,020 --> 0:27:26,020
ده به احدا

659
0:27:26,020 --> 0:27:28,020
با جدم رسول خدا تجدید احد بکنم

660
0:27:28,020 --> 0:27:30,020
برگردونید

661
0:27:30,020 --> 0:27:32,020
کنار قبر جده ام فقط

662
0:27:32,020 --> 0:27:34,020
فاطمه بن تعصد تو بقی دفن کنید

663
0:27:34,020 --> 0:27:36,020
حسن جان

664
0:27:36,020 --> 0:27:38,020
وقتی منو میبرید ممکنه اینا فکر کرد

665
0:27:38,020 --> 0:27:40,020
میخواید منو اونجا دفن کنید

666
0:27:40,020 --> 0:27:42,020
میان مانع میشن

667
0:27:42,020 --> 0:27:44,020
اگه مانع شدن

668
0:27:44,020 --> 0:27:46,020
من دوست ندارم در تشریج رازی من

669
0:27:46,020 --> 0:27:48,020
خونی ریخته بشه دوایی بشه

670
0:27:48,020 --> 0:27:50,020
برگردونید

671
0:27:50,020 --> 0:27:52,020
حالا آشقان کربلا

672
0:27:52,020 --> 0:27:54,020
آشقان قبر قریب

673
0:27:54,020 --> 0:27:56,020
و مظلوم

674
0:27:56,020 --> 0:27:58,020
امام مشتبه در بقی

675
0:27:58,020 --> 0:28:00,020
بدن امام مشتبه رو برداشتن

676
0:28:00,020 --> 0:28:02,020
شما شنیدید دیگه پنجتن آل عبا

677
0:28:02,020 --> 0:28:04,020
ای خمسه تیوه

678
0:28:04,020 --> 0:28:06,020
هیچ کدومشون تشریج جنازه

679
0:28:06,020 --> 0:28:08,020
نداشتن جز امامستن مشتبه

680
0:28:08,020 --> 0:28:10,020
پیغمبر تشریج جنازه

681
0:28:10,020 --> 0:28:12,020
نداشتن همونجای که

682
0:28:12,020 --> 0:28:14,020
همون اتاقی که از زمین رفتن

683
0:28:14,020 --> 0:28:16,020
تو همون غرفه دفن شدن

684
0:28:16,020 --> 0:28:18,020
زهرای اطهر

685
0:28:18,020 --> 0:28:20,020
تشریج جنازه نداشتن یا اگه داشتن

686
0:28:20,020 --> 0:28:22,020
شبانه بوده

687
0:28:22,020 --> 0:28:24,020
رسمی نبوده

688
0:28:24,020 --> 0:28:26,020
امام امیر المومنین تشریج

689
0:28:26,020 --> 0:28:28,020
جنازه رسمی نداشتن

690
0:28:28,020 --> 0:28:30,020
شبانه بدنشون قریبانه

691
0:28:30,020 --> 0:28:32,020
توسط فرزندانشون

692
0:28:32,020 --> 0:28:34,020
برداشته شد

693
0:28:34,020 --> 0:28:36,020
بفرمایید آیا حسین ابن علی تشریج

694
0:28:36,020 --> 0:28:38,020
جنازه داشت؟

695
0:28:38,020 --> 0:28:40,020
امام سجاد آمد فهمود بني اصد

696
0:28:40,020 --> 0:28:42,020
یه قطعه حسیر برام بیاری

697
0:28:42,020 --> 0:28:44,020
تو امون گوده قتلگاه

698
0:28:44,020 --> 0:28:46,020
نازلین بدن بابا رو

699
0:28:46,020 --> 0:28:48,020
در خانه قبر گذاشت

700
0:28:48,020 --> 0:28:50,020
از این پنج وجود مقدس

701
0:28:50,020 --> 0:28:52,020
یه نفر تشریج جنازه

702
0:28:52,020 --> 0:28:54,020
براش برگذار شد

703
0:28:54,020 --> 0:28:56,020
کاش برایشونم برگذار نمیشد

704
0:28:56,020 --> 0:28:58,020
چرا؟

705
0:28:58,020 --> 0:29:00,020
چون و شهیدن فوقال جنازه

706
0:29:00,020 --> 0:29:02,020
تقد شکت

707
0:29:02,020 --> 0:29:04,020
بسهامه اکفانو

708
0:29:04,020 --> 0:29:06,020
یعنی آه برادران و خوهران

709
0:29:06,020 --> 0:29:08,020
جنازه امام مشتبه

710
0:29:08,020 --> 0:29:10,020
تیر باران شد

711
0:29:10,020 --> 0:29:12,020
تابوت امام حسین مشتبه

712
0:29:12,020 --> 0:29:14,020
تیر باران شد

713
0:29:14,020 --> 0:29:16,020
هفتا تیر

714
0:29:16,020 --> 0:29:18,020
بر تابوت

715
0:29:18,020 --> 0:29:20,020
و چه بسا بعضی از این تیرها

716
0:29:20,020 --> 0:29:22,020
بر بدن شریف امام مشتبه

717
0:29:22,020 --> 0:29:24,020
صلوالله علیکم

718
0:29:24,020 --> 0:29:26,020
یا

719
0:29:26,020 --> 0:29:28,020
احلا بیت نبوه

720
0:29:28,020 --> 0:29:32,020
اللهم عجل لبلی کالفرج

721
0:29:32,020 --> 0:29:36,020
والعافیت و النصر

722
0:29:36,020 --> 0:29:38,020
عرض سلام و ارادت

723
0:29:38,020 --> 0:29:40,020
و تسلیت ما را

724
0:29:40,020 --> 0:29:42,020
به محضر مبارک امام زمانمون

725
0:29:42,020 --> 0:29:44,020
ابلاق بفرما

726
0:29:44,020 --> 0:29:46,020
قلب مقدسشون را از ما راضی خوشنود

727
0:29:46,020 --> 0:29:48,020
بفرما

728
0:29:48,020 --> 0:29:50,020
شهدا امام انباتمون

729
0:29:50,020 --> 0:29:52,020
قریغ رحمتت بفرما

730
0:29:52,020 --> 0:29:54,020
کشور ما ملت ما

731
0:29:54,020 --> 0:29:56,020
نظام ما رحبر عزیز ما در این محضر مبارک امام زمانمون را ابلاغ بفرما

732
0:29:56,020 --> 0:29:58,020
در کنف حمایت امام زمان

733
0:29:58,020 --> 0:30:00,020
بحافظت بفرما

