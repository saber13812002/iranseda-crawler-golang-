620
0:27:15,260 --> 0:27:16,280
این کدوم خود هست

621
0:27:16,280 --> 0:27:18,700
اون خود انسانی که

622
0:27:18,700 --> 0:27:20,420
حسیه مرکزیست او که

623
0:27:20,420 --> 0:27:22,240
دفن شده و از یاد رفته

624
0:27:22,240 --> 0:27:25,100
این خود حیوانیست

625
0:27:25,100 --> 0:27:26,620
این که میگوید

626
0:27:26,620 --> 0:27:28,940
من هرچی میخواهم میکنم

627
0:27:28,940 --> 0:27:30,540
هر جا بخواهم میروم

628
0:27:30,540 --> 0:27:32,660
این از حیوان دارد

629
0:27:32,660 --> 0:27:34,260
حرف میزند نه از انسان

630
0:27:34,260 --> 0:27:37,160
اگر رسید به جایی که

631
0:27:37,160 --> 0:27:38,920
این هم الا کل الام ورهم

632
0:27:38,920 --> 0:27:39,900
از اللو سبیلا

633
0:27:39,900 --> 0:27:42,660
این از خود حیوانی

634
0:27:42,660 --> 0:27:43,620
سخن میگوید

635
0:27:43,620 --> 0:27:46
بر تقدیر الان چند بحث مهم

636
0:27:46 --> 0:27:46,520
مونده

637
0:27:46,520 --> 0:27:49,680
یکی این که محرکیست

638
0:27:49,680 --> 0:27:53,920
از آیه سوره هشت

639
0:27:53,920 --> 0:27:54,740
چه میپرمد

640
0:27:54,740 --> 0:27:57,280
فَانْسَاهُمْ اَنفُسَهُمْ

641
0:27:57,280 --> 0:27:58,560
معلوم میشه برد

642
0:27:58,560 --> 0:28:00,420
منسی خداست

643
0:28:00,420 --> 0:28:03,560
قهرن مزکر هم

644
0:28:03,560 --> 0:28:04,920
خدا خواهد بود

645
0:28:04,920 --> 0:28:07,060
پس مزکر اوست

646
0:28:07,060 --> 0:28:08,640
چنک منسی هم

647
0:28:08,640 --> 0:28:10,040
اوش محرک

648
0:28:10,040 --> 0:28:13,040
یکی این که انسان این راهارا

649
0:28:13,820 --> 0:28:15,440
به خودی خود

650
0:28:15,440 --> 0:28:15,960
تیمی خوده

651
0:28:16 --> 0:28:18,660
یا گروهی تیمی خود

652
0:28:18,660 --> 0:28:20,680
اگر گروهی تیمی خود

653
0:28:20,680 --> 0:28:23,500
قهرن با رهبری رهبران

654
0:28:23,500 --> 0:28:24,120
تیمی خود

655
0:28:24,120 --> 0:28:27,720
اون راه نما کیست که انسانها را به اینجا میبرد

656
0:28:27,720 --> 0:28:30,020
یه امام جوری هست

657
0:28:30,020 --> 0:28:31,980
که پیروان خود را

658
0:28:31,980 --> 0:28:34,120
به دنبال خود به جهنم میبرد

659
0:28:34,120 --> 0:28:36,540
یه امام قسطو عبدی هست

660
0:28:36,540 --> 0:28:38,020
که رهروان

661
0:28:38,020 --> 0:28:40,100
راه خود را به بهشت میبرد

662
0:28:40,100 --> 0:28:41,980
این یوم ندعو

663
0:28:41,980 --> 0:28:44,500
کل اناسن به امام هم

664
0:28:44,500 --> 0:28:45,980
دو گروه را

665
0:28:46 --> 0:28:47,960
زیر مجموعه خود دارد

666
0:28:47,960 --> 0:28:50,400
یه ده بینا یه ده نابینا

667
0:28:50,400 --> 0:28:52,680
والحمدلله رب العالمين

668
0:29:16 --> 0:29:18,400
عابد

669
