با این که سآلت بر نگردید

226
0:24:29,040 --> 0:24:31,040
کلا سر نورفته

227
0:24:31,040 --> 0:24:33,040
چرا؟

228
0:24:33,040 --> 0:24:36,040
داریم میریم کربلا

229
0:24:36,040 --> 0:24:37,040
کربلا؟

230
0:24:37,040 --> 0:24:39,040
کربلا هم خوبه

231
0:24:39,040 --> 0:24:43,040
ولی این که سآلت همینجا

232
0:24:43,040 --> 0:24:46,040
اگه گفتی چرا؟

233
0:24:46,040 --> 0:24:50,040
برای این که تنها

234
0:24:50,040 --> 0:24:53,040
بین اعمه چارده مسئول

235
0:24:53,040 --> 0:24:56,040
اون که دست میذاریم تو سینه

236
0:24:56,040 --> 0:24:58,040
میگیم السلام علیکه

237
0:24:58,040 --> 0:25:01,040
ایهاد امام رعوف

238
0:25:01,040 --> 0:25:04,040
این امام

239
0:25:04,040 --> 0:25:06,040
پیغمبرم رعوفه

240
0:25:06,040 --> 0:25:11,040
و در زیارت معصوره صحی

241
0:25:11,040 --> 0:25:13,040
برای این امام اومده

242
0:25:13,040 --> 0:25:19,040
السلام علیکه ایهاد امام رعوف

243
0:25:19,040 --> 0:25:24,040
با این آقایی که سآلت اگر دارید درمیان بگذارید

244
0:25:24,040 --> 0:25:27,040
ساده برید پیشه

245
0:25:27,040 --> 0:25:33,040
خیر و دعا ما یجری علال سانک

246
0:25:33,040 --> 0:25:35,040
بهترین دعا اینه؟

247
0:25:35,040 --> 0:25:39,040
که ساده به آقا بگید

248
0:25:39,040 --> 0:25:42,040
همینطور که میبنه سر زبونه

249
0:25:42,040 --> 0:25:48,040
به آقا بگو من کسالت عصبانیت دارم

250
0:25:48,040 --> 0:25:53,040
اومدم هم خدمت شما

251
0:25:53,040 --> 0:25:57,040
به هر وسیله ای که اومدم

252
0:25:57,040 --> 0:25:59,040
ببینه؟

253
0:25:59,040 --> 0:26:02,040
به هر واسطه ای که اومدم

254
0:26:02,040 --> 0:26:04,040
اگه اداره اردتیه

255
0:26:04,040 --> 0:26:06,040
سپاه اردتیه

256
0:26:06,040 --> 0:26:08,040
ارتش اردتیه

257
0:26:08,040 --> 0:26:12,040
مهمون اونا نیستیم

258
0:26:12,040 --> 0:26:16,040
درسته مهمونی تو به وسیله اونا عاشقه

259
0:26:16,040 --> 0:26:19,040
ولی مهمون آقایی

260
0:26:19,040 --> 0:26:24,040
به هر مهمانی بر میزمان حق داره

261
0:26:24,040 --> 0:26:26,040
خودشون گفتن

262
0:26:26,040 --> 0:26:32,040
الوارد عل المورود حق

263
0:26:32,040 --> 0:26:34,040
در عربه هم هست

264
0:26:34,040 --> 0:26:38,040
میگن اگر حاجتی داری

265
0:26:38,040 --> 0:26:40,040
پیشی یه نفر

266
0:26:40,040 --> 0:26:43,040
سیکن مهمونش پیشی

267
0:26:43,040 --> 0:26:47,040
وقتی مهمونی شدی سر صفره حاجتا بگو

268
0:26:47,040 --> 0:26:50,040
اینم صفره آقای

269
0:26:50,040 --> 0:26:54,040
شما وارده بر ایشون

270
0:26:54,040 --> 0:26:56,040
بلاخره مهمونش است

271
0:26:56,040 --> 0:26:59,040
ما مهمون امام رضاییم

272
0:26:59,040 --> 0:27:01,040
چرا اینو نمیگی؟

273
0:27:02,040 --> 0:27:07,040
بگو آقا من همچو کسالتی دارم

274
0:27:07,040 --> 0:27:12,040
استدعام کنم از خدا بخواهی

275
0:27:12,040 --> 0:27:16,040
که این درد و مرز منو شفاه بده

276
0:27:16,040 --> 0:27:19,040
ببین چطور شفاه مده

277
0:27:19,040 --> 0:27:22,040
خودت میفهمی عوض شدی

278
0:27:22,040 --> 0:27:27,040
اونایی که بعدن میاد دیدنید

279
0:27:27,040 --> 0:27:30,040
ببینه عوض شدی

280
0:27:30,040 --> 0:27:35,040
اونایی که بعد معامله داشتن رو برو

281
0:27:35,040 --> 0:27:37,040
بیا داشتن

282
0:27:37,040 --> 0:27:40,040
میفهمن عوض شدید

283
0:27:40,040 --> 0:27:42,040
خیلی مهمه ده

284
0:27:42,040 --> 0:27:44,040
یاد دونه رو

285
0:27:44,040 --> 0:27:47,040
خود دونم به آقا تعهد بسوارید

286
0:27:47,040 --> 0:27:50,040
که خود دونم کمک میکنید

287
0:27:50,040 --> 0:27:54,040
جلو این عصبانیت رو میگیرید

288
0:27:54,040 --> 0:27:58,040
یک حق و ناس عظیمی که بعد

289
0:27:58,040 --> 0:28:01,040
از این ایمابده کارش هستیم انشالله

290
0:28:01,040 --> 0:28:04,040
خدا شفاه مده

291
0:28:04,040 --> 0:28:08,040
و آدم های آرام و نرم میشه

292
0:28:08,040 --> 0:28:14,040
اون وقت ببینید زندگی دون صد درجه بهتر میشه

293
0:28:14,040 --> 0:28:19,040
دون بشاش طلوش عطیقه تسانیه

294
0:28:19,040 --> 0:28:25,040
برندگان زندگی اونایی هستن که مقابمت دارن

295
0:28:25,040 --> 0:28:27,040
حوصله دارن

296
0:28:27,040 --> 0:28:29,040
خد در نمیرن

297
0:28:29,040 --> 0:28:33,040
بعضی ها هستن خانمشون بالا چشمشون

298
0:28:33,040 --> 0:28:36,040
میگه عبرو تو خد در نمیرن

299
0:28:36,040 --> 0:28:39,040
ای که صالته

300
0:28:39,040 --> 0:28:44,040
خدا به عبروی پیغمبر و آل پیغمبر

301
0:28:44,040 --> 0:28:47,040
اگر این مرز داریم

302
0:28:47,040 --> 0:28:51,040
به حق این امام رعوف خدا رو قسم بدی

303
0:28:51,040 --> 0:28:53,040
مرا شفاه بده انشالله

304
0:28:53,040 --> 0:28:56,040
اگه دل اسلام و اهله

305
0:28:56,040 --> 0:28:59,040
وقتو لکوف و اهله

306
0:28:59,040 --> 0:29:02,040
ایدهما تد دین

307
0:29:02,040 --> 0:29:05,040
علما اد دین

308
0:29:05,040 --> 0:29:08,040
مرا جعن لازام

309
0:29:08,040 --> 0:29:12,040
و لا سکه ما آیت بلا خامنه ای

310
0:29:12,040 --> 0:29:16,040
روح امام و شهده رو شاد کن

311
0:29:16,040 --> 0:29:21,040
خیل دنیا و آخرت نصیب همه بفرما

312
0:29:21,040 --> 0:29:24,040
سلوات بلندی خد کنید

313
0:29:26,040 --> 0:29:28,040
خدا با فراش داریم

314
0:29:28,040 --> 0:29:31,040
مرا شفاه بده انشالله

315
0:29:31,040 --> 0:29:34,040
سلوات بلندی خد دین

316
0:29:34,040 --> 0:29:37,040
و ایدهما تد دین

317
0:29:37,040 --> 0:29:41,040
عماه فرش دانه مردم

318
0:29:41,040 --> 0:29:45,040
و سلوات بلندی خد دین

319
0:29:45,040 --> 0:29:48,040
عماه فراش دانه مردم

320
0:29:48,040 --> 0:29:51,040
خدا بلندی خد دین

321
0:29:51,040 --> 0:29:54,040
و سلوات بلندی خد دین

322
0:29:54,040 --> 0:29:59,880
محمد و آل محمد

