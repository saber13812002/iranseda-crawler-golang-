0:24:26,020 --> 0:24:27,960
دو جور خدا میخواهد

407
0:24:27,960 --> 0:24:31,180
ولی اون جور برای جامعه انسانی

408
0:24:31,180 --> 0:24:32,220
سودمند نیست

409
0:24:32,220 --> 0:24:34,500
یکی این که همه اینا را فرشته کند

410
0:24:34,500 --> 0:24:35,440
خب کرد

411
0:24:35,440 --> 0:24:38,280
از این قبیل موجودات به مای عالم و جنوب دارد

412
0:24:38,280 --> 0:24:40
بکه الله و خدا زیاد دارد

413
0:24:40 --> 0:24:42,400
یکی این که اینا در حالی که انسانن

414
0:24:42,400 --> 0:24:45,080
موجوده ارزیان دارد شهبت و قذبن

415
0:24:45,080 --> 0:24:47,680
ملجهشون بکند به ایمان

416
0:24:47,680 --> 0:24:49,260
اما خب اون سودی ندارد

417
0:24:49,260 --> 0:24:49,720
قول

418
0:24:49,720 --> 0:24:52,880
ولی الله الهجت البالغتو

419
0:24:52,880 --> 0:24:56,140
فنو شاء لحداکم اجمعین

420
0:24:56,140 --> 0:24:59,680
ولی که نخواست شما را آزاد گذاشت

421
0:24:59,680 --> 0:25:02,260
فاون من شافل یومن و من شافل یکفر

422
0:25:02,260 --> 0:25:06,560
تا رو انتخاب آزاد انسان به جایی برسد

423
0:25:06,560 --> 0:25:08,900
چرا بین تکوین و تشریح قبط بکنید

424
0:25:08,900 --> 0:25:12,120
هر جا سخن محققین است

425
0:25:12,120 --> 0:25:13,940
حاسق محققان است

426
0:25:13,940 --> 0:25:16,360
که بین خشی و تکوین خبت نکنید

427
0:25:16,360 --> 0:25:20,140
هر جا سخن اکثری دنبال روی

428
0:25:20,140 --> 0:25:22,700
آثار باستانی پرست است

429
0:25:22,700 --> 0:25:25,420
اونجا تقلید را نکوهش میکند

430
0:25:25,420 --> 0:25:27,540
فبود آخه نیاکانتون هیچند

431
0:25:27,540 --> 0:25:29,980
یه وقت آدم خودش نمیداند

432
0:25:29,980 --> 0:25:31,720
از یه آلمی استفاده میکند

433
0:25:31,720 --> 0:25:33,960
یه وقت نمیداند و نمیپرسد

434
0:25:33,960 --> 0:25:36,920
فبود این نیاکانتون نه آلم بودن نه مهتدی

435
0:25:36,920 --> 0:25:38,620
نه خودشون چیز میفهمدن

436
0:25:38,620 --> 0:25:40,360
نه از چیز فهماش حال میکردن

437
0:25:40,360 --> 0:25:43,080
اولوکان آباؤب

438
0:25:43,940 --> 0:25:46,260
و یعلبون شیعان

439
0:25:46,260 --> 0:25:46,700
یک

440
0:25:46,700 --> 0:25:48,840
و لایحتدون دو

441
0:25:48,840 --> 0:25:52,080
بلاخره یه بلعرزها باید به ذات برسه

442
0:25:52,080 --> 0:25:56,200
انسان یا خودش مستقیمن باید از آلم بپرسه

443
0:25:56,200 --> 0:25:59,880
یا از کسی بپرسه که او از آلم پرسیده است

444
0:25:59,880 --> 0:26:01,860
که بلاخره به آلم ختم بشه

445
0:26:01,860 --> 0:26:04,320
که تقلید تقلید جاهل از آلم باشه

446
0:26:04,320 --> 0:26:05,460
نه جاهل از جاهل

447
0:26:05,460 --> 0:26:08,220
فبود این نیاکانتون نه آلم هستن

448
0:26:08,220 --> 0:26:09,620
نه از علما پرسیدن

449
0:26:09,620 --> 0:26:11,560
خب چه حرفان رو گوش بدید

450
0:26:11,560 --> 0:26:16,360
اولوکان آباؤهم لایعلمون شیعان

451
0:26:16,360 --> 0:26:18,280
که این نکره در سیاق نفی است

452
0:26:18,280 --> 0:26:19,760
اما اخو اینا هیچی نخوندن

453
0:26:19,760 --> 0:26:21,120
چیزی بلد نیستن

454
0:26:21,120 --> 0:26:23,480
شما چرا از جاهل ها تقلید میکنن

455
0:26:23,480 --> 0:26:25,460
اینانه تنها خودشون بلد نیستن

456
0:26:25,460 --> 0:26:27,740
از اون بلد ها هم سؤال نکردن

457
0:26:27,740 --> 0:26:28,620
بلایحتدون

458
0:26:28,620 --> 0:26:33,120
این گروه که به همون آثار باستانی اکتفا میکنن

459
0:26:33,120 --> 0:26:36,680
با گروهی که به علوم مادی بسنده میکنن

460
0:26:36,680 --> 0:26:39,580
هر دو زیر مجموعه اون عنوان

461
0:26:39,580 --> 0:26:43,540
سوره مبارکه قافران که فرهو به ما انده هم من العلم

462
0:26:43,540 --> 0:26:48,940
خواه علم جدید و پیشرفته سنعتی باشد

463
0:26:48,940 --> 0:26:52,620
خواه نیاکان پرستی به ما انده اون باشد

464
0:26:52,620 --> 0:26:55,100
که در سوره مبارکه قافر

465
0:26:55,100 --> 0:26:58,080
این چی ای آمده است که اگر از اونا سؤال بکنیم

466
0:26:58,080 --> 0:27:00,980
به معارف الهی تندر بدید

467
0:27:00,980 --> 0:27:02,800
و چرا تندر نمیدید

468
0:27:02,800 --> 0:27:04,720
فرهو به ما انده هم من العلم

469
0:27:04,720 --> 0:27:07,020
چه علمهای مادی پیشرفته

470
0:27:07,020 --> 0:27:09,420
و چه همین خرافاته

471
0:27:09,420 --> 0:27:11,480
گذشته به سنن گذشته

472
0:27:11,480 --> 0:27:14,140
بنابراین گاهی هم هست که انسان

473
0:27:14,140 --> 0:27:16,340
جاهلانه زندگی میکند

474
0:27:16,340 --> 0:27:17,460
آلم هست

475
0:27:17,460 --> 0:27:19,560
ولی جاهلانه زندگی میکند

476
0:27:19,560 --> 0:27:21,920
مثل که آلمی از آلم تقلید بکند

477
0:27:21,920 --> 0:27:23,440
خب اگر این که میگن

478
0:27:23,440 --> 0:27:25,640
تقلید مشتهد از مشتهد حرام هست

479
0:27:25,640 --> 0:27:26,840
برای همین جهت هست دیگر

480
0:27:26,840 --> 0:27:29,040
ذات اقدس ایلادش ما نعمتی داد

481
0:27:29,040 --> 0:27:30,500
قدرت استنباد داد

482
0:27:30,500 --> 0:27:32
استقلال فکری داد

483
0:27:32 --> 0:27:33,760
خب چرا در کنار صفر دیگری

484
0:27:33,760 --> 0:27:36,380
جاهل از جاهل تقلید بکند حرام هست

485
0:27:36,380 --> 0:27:38,820
آلم حرف آلم مگوش بدد حرام هست

486
0:27:38,820 --> 0:27:41,340
اون برای پیروی بی جا

487
0:27:41,340 --> 0:27:44,440
باید پیرویش به جا باشد

488
0:27:44,440 --> 0:27:48,040
این پیرویه ها را جا به جا کرده هست

489
0:27:48,040 --> 0:27:51,060
و این یکی که آلم از آلم تقلید میکند

490
0:27:51,060 --> 0:27:52,920
بنابراین که استقلال خود را از دست داد

491
0:27:52,920 --> 0:27:55,460
خب تو که دارای قدرت استنبادی

492
0:27:55,460 --> 0:27:57,040
خدا این نعمت را به تو داد

493
0:27:57,040 --> 0:27:58,760
حق ندارد دیگری گوش بدی

494
0:27:58,760 --> 0:28:02,600
دین نمیگوید حرف کسی را همیشه گوش بده

495
0:28:02,600 --> 0:28:04,520
گاهی میگوید اصلا گوش نده

496
0:28:04,520 --> 0:28:07,320
گاهی میگوید حرف دانشمندان را گوش بده

497
0:28:07,320 --> 0:28:10,500
خب فقط تقلید آلم از آلم حرام

498
0:28:10,500 --> 0:28:12,420
تقلید جاهل از جاهل حرام

499
0:28:12,420 --> 0:28:14,560
تقلید آلم از جاهل که

500
0:28:14,560 --> 0:28:17,060
عوامها علمارا بگردونن این حرام

501
0:28:17,060 --> 0:28:20,660
فقط تقلید جاهل از آلم از که به جاست

502
0:28:20,660 --> 0:28:21,240
فرمود

503
0:28:21,240 --> 0:28:27,580
اگه اونا آلم بودن

504
0:28:27,580 --> 0:28:28,580
این تقلید

505
0:28:28,580 --> 0:28:28,740
آلم

506
0:28:28,740 --> 0:28:29,860
جاهل از آلم بود

507
0:28:29,860 --> 0:28:32,940
یا آلم نبودن ولی از علما سآل کردن

508
0:28:32,940 --> 0:28:35,420
باز تقلید معلواسته بود

509
0:28:35,420 --> 0:28:36,120
در حقیقت

510
0:28:36,120 --> 0:28:39,580
مثل کسی که حرف مسئله گو را گوش میدهد

511
0:28:39,580 --> 0:28:40,500
خب مسئله گو

512
0:28:40,500 --> 0:28:42,440
بالاخره مسئله را از روی رساله

513
0:28:42,440 --> 0:28:44,700
آلم مرجع دینی میگوید دیگر

514
0:28:44,700 --> 0:28:46,700
یک گوش دادن به جاییست

515
0:28:46,700 --> 0:28:49,120
فرمود نیاکانتون اون بودن نیست

516
0:28:49,120 --> 0:28:51,020
بخش از اینا در سوره مبارکه

517
0:28:51,020 --> 0:28:53,120
یونس هم آمده است

518
0:28:53,120 --> 0:28:54,360
که اونجا هم

519
0:28:54,360 --> 0:28:56,940
مسئله حرام و حلال را ذکر کرد

520
0:28:56,940 --> 0:28:58,680
و مشابه این تحبیرات

521
0:28:58,680 --> 0:28:59,420
اونجا آمده

522
0:28:59,420 --> 0:29:02,540
آیه هنجاه نوع سوره مبارکه

523
0:29:02,540 --> 0:29:03,180
یونس اینست

524
0:29:03,180 --> 0:29:14,360
شما که وحی را منکرید

525
0:29:14,360 --> 0:29:15,240
میشه افترا

526
0:29:15,240 --> 0:29:18,360
افترا برای کسی که منکره

527
0:29:18,960 --> 0:29:19,820
وحی است

528
0:29:19,820 --> 0:29:22,060
از همین راه نشعت میگرد

529
0:29:22,060 --> 0:29:24,180
که بین تشکیل و تکمین خلص بکنه

530
0:29:24,180 --> 0:29:28,600
اینا که منکره وحی و شریعت و رسالت و نبوبت و بلایتن

531
0:29:28,600 --> 0:29:30,180
میگن این گفته خداست

532
0:29:31,100 --> 0:29:33,500
یعنی تکمینا خدا را امزا کرده

533
0:29:33,500 --> 0:29:35,980
نه این که خدای پیانبری فرست داده

534
0:29:35,980 --> 0:29:38,260
چون اینا نبوبت و آمده را منکره

535
0:29:38,260 --> 0:29:41,460
میگن اگر بنا شد کسی از طرف خدا بیاید

536
0:29:41,460 --> 0:29:43,060
او باید فرشته باشد

537
0:29:43,060 --> 0:29:45,320
بشر نمیتواند پیغمبر باشد

538
0:29:45,320 --> 0:29:46,460
در جاهلیت

539
0:29:46,460 --> 0:29:48,580
معاد مرد انکارشون بود

540
0:29:48,580 --> 0:29:50,980
نبوبت آمده مرد انکارشون بود

541
0:29:50,980 --> 0:29:52,840
وقتی نبوبت آمده نیپذیر افتن

542
0:29:52,840 --> 0:29:54,540
نبوبت خواسترم قبول نداشته

543
0:29:54,540 --> 0:29:56,880
والحمدلله رب العالمين

