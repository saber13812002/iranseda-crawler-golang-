قَالَ سُبْحَانَكَ مَا يَكُونُ لِي أَنْ أَغُودُ مَا لَيْسِ لِي بِحَقٍ

32
0:02:59,400 --> 0:03:02,880
اِنْ كُنْتُ وَقُلْتُهُ فَقَدْ عَلِمْتَهُ

33
0:03:02,880 --> 0:03:07,180
تَعْلَو مَا فِي نَفْسِهِ وَلَا اَعْلَو مَا فِي نَفْسِكِ

34
0:03:07,180 --> 0:03:09,980
اِنَّكَ اَنْتَعْدْ لَامُ الْعُيُوبِ

35
0:03:09,980 --> 0:03:13,780
مَا قُلْتُ لَهُمْ اِلَّا مَا اَمَرْتَنِي بِهِ

36
0:03:13,780 --> 0:03:16,940
اَنْ اِعْبُدُ اللَّهَ رَبِّي وَرَبَّكُمْ

37
0:03:16,940 --> 0:03:20,980
وَكُنْتُ عَلَيْهِمْ شَهِيدًا مَا دُمْتُ فِيهِمْ

38
0:03:20,980 --> 0:03:25,380
فَلَمَّا تَبَفَّيْتَنِي كُنْتَ اَنْتَ اَرْضَغِيبَ عَلَيْهِمْ

39
0:03:25,380 --> 0:03:27,920
وَاَنْتَ عَلَىٰ كُلِّ شَهِيدٍ

40
0:03:27,920 --> 0:03:32,840
اِنْ تُعَذِّبْهُمْ فِي اِنَّهُمْ عِبَادُكَ وَاِنْ تَعْفِدْهُمْ

41
0:03:32,840 --> 0:03:35,260
فِي اِنَّكَ اَنْتَ الْعَزِیزُ الْعَكِيمُ

42
0:03:35,260 --> 0:03:41,160
قَالَ اللَّهُ هَذَا يُوْمُ يَنْفَعُ اُسْقَادِ غِينَ اسْقِدْغُهُمْ

43
0:03:41,160 --> 0:03:46,520
لَهُمْ جَنَّاتٌ تَجْدِی مِنْ تَهْدِ الْأَنْهَارُ خَالِدِينِ فِيهَا اَبَدَا

44
0:03:46,520 --> 0:03:51,780
رَدِیَ اللَّهُ عَنْهُمْ وَرَدُو عَنْدُ وَعَلِكَ الْفُوزُ وَالْعَلِيمُ

45
0:03:51,780 --> 0:03:56,040
بعضی از نکاتی که مربوطی بین آیات هست و منتقل است

46
0:03:56,040 --> 0:04:03,680
عبارت از این است که اگر ذات اقدس اله نعمتی را ابتداهن به کسی مرحمت کرد

47
0:04:03,680 --> 0:04:07,580
اون متنعم موظف از شاکر باشد

48
0:04:07,580 --> 0:04:12,280
یعنی اون نعمت را از ناهی ذات اقدس اله بداند

49
0:04:12,280 --> 0:04:16,180
و اون نعمت را در جا خود سرف بکند و مانند اون

50
0:04:16,180 --> 0:04:21,900
و اگر کفران کرده است خطر زوال نعمت هست

51
0:04:21,900 --> 0:04:24
و احتمال اعذاب

52
0:04:24 --> 0:04:28,240
ولی اگر نعمتی را خود شخص درخواست کرد

53
0:04:28,240 --> 0:04:30,280
و دعای اون مستجاب شد

54
0:04:30,880 --> 0:04:37,180
چنین شخصی در برابر اون نعمت تنها وظیفه شک گذاری محض نیست

55
0:04:37,180 --> 0:04:41,460
باید حشیار باشد که اگر خدای نای کرده کفران کرد

56
0:04:41,460 --> 0:04:44,760
ممکن است به عذاب سختی مبتراب شده

57
0:04:44,760 --> 0:04:46,040
این اصل کلی

58
0:04:46,040 --> 0:04:51,500
بنابراین اگر دعا کردیم و دعای ما مستجاب شد

59
0:04:51,500 --> 0:04:56,280
باید تا آخر موازه باشیم که برابر اون استجابت دعا عمل بکنیم

60
0:04:56,900 --> 0:05:00,060
چون اینجور تحدید ها در جای دیگر نیست

61
0:05:00,060 --> 0:05:03,200
در جای دیگر نزیر سنوی مبارک ابراهیم

62
0:05:03,200 --> 0:05:06,600
میفرماد به این که حرف موسای کریم

63
0:05:06,600 --> 0:05:11,180
که من به مردم وسیله موسای کریم سلام و دلیل گفتن این است

64
0:05:11,180 --> 0:05:15,260
خودم هم اعلام کردن این است که لئن شکرتون را ازیدن نکن

65
0:05:15,260 --> 0:05:15,860
و لئن کفران

66
0:05:16,040 --> 0:05:23,420
اونجا وعد را به سراها زک فرمود و اید را تلویهن

67
0:05:23,420 --> 0:05:27,420
نفرمود و این کفرتم را عذبن نکن

68
0:05:27,420 --> 0:05:33,580
اما در مسئله این که اگر کسی چیزی را با پیشنهاد خود از خدا بخواهد

69
0:05:33,580 --> 0:05:36,420
و خدا همون خواسته را برابرده کند

70
0:05:36,420 --> 0:05:39,320
اینجا تسریحن و اید عذاب داره

71
0:05:39,320 --> 0:05:45,160
بنابراین ما بهدرین راه آنست که عبد مهد باشیم

72
0:05:45,160 --> 0:05:46,020
یعنی کار را بهترین راه آنست که عبد مهد باشیم

73
0:05:46,020 --> 0:05:51,300
و اگر کسی به خدا پیشنهاد داد و گفت

74
0:05:51,300 --> 0:05:53,040
فلون کار را برام انجام بده

75
0:05:53,040 --> 0:05:54,860
فلون خیل را برام انجام بده

76
0:05:54,860 --> 0:05:56,480
فلون چیز را برام بده

77
0:05:56,480 --> 0:05:59,340
باید مبازه باشه اگر تکلیفش جشوار است

78
0:05:59,340 --> 0:06:00,860
این مطلب اول

79
0:06:00,860 --> 0:06:03,200
مطلب دومان است که

80
0:06:03,200 --> 0:06:07,200
در این گونه از موارد که فعل مربوط به قیامت است

81
0:06:07,200 --> 0:06:09,780
وقتی با فعل مازی یاد می شود

82
0:06:09,780 --> 0:06:12,460
نوع مفسری می فرماین

83
0:06:12,460 --> 0:06:16
چون مستقبل محقق قربه او در حکم مازی است

84
0:06:16,020 --> 0:06:19,040
مسحه اطلاق مازی وجود دارد

85
0:06:19,040 --> 0:06:22,940
ازاوقعت الواقعه به مانندان از همین قبیل است

86
0:06:22,940 --> 0:06:28,820
یا یوم یجمالله رسول فیقولو مازا اجبتوم قالو

87
0:06:28,820 --> 0:06:32,640
این قالو به مانندان که فعل مازی است

88
0:06:32,640 --> 0:06:35,940
در قیامت واقع می شود

89
0:06:35,940 --> 0:06:38,140
چون یقینا واقع می شود

90
0:06:38,140 --> 0:06:40,540
از این جهت به فعل مازی تعبیر شده است

91
0:06:40,540 --> 0:06:42,520
آیه محل بحث هم همین است

92
0:06:42,520 --> 0:06:45,380
ویز قال الله یا عیس ابن مریم

93
0:06:46,020 --> 0:06:49,240
تقلت لناس تقزونی و امیراهین

94
0:06:49,240 --> 0:06:51,940
ظرف این قول قیامت است

95
0:06:51,940 --> 0:06:55,420
که در آینده ذات اقدس اله به ایسای مسیح

96
0:06:55,420 --> 0:06:57,620
سلام الله علیه چنین حرفی می زند

97
0:06:57,620 --> 0:07:01,300
چون قیامت محقق قربه او است

98
0:07:01,300 --> 0:07:04,920
از یقول الله به قال الله تقضی شده است

99
0:07:04,920 --> 0:07:09,980
این نکته است که در ازهان همه است

100
0:07:09,980 --> 0:07:12,920
بر اینکه کتب عدبی ما این چنین است

101
0:07:12,920 --> 0:07:15,900
یعنی از همون کتاب های اولیه نه

102
0:07:15,900 --> 0:07:18,400
وقتی نسان میخاند یا سرخ

103
0:07:18,400 --> 0:07:22,800
میگوید دای مستقبل محقق قربه او در حکم مازی است

104
0:07:22,800 --> 0:07:25,040
بعد مثال هم که زکم شود

105
0:07:25,040 --> 0:07:27,800
به جریان قیامت زکم شود

106
0:07:27,800 --> 0:07:32,620
ولی در کتب عدبی یه مطلب امیغ و لطیفی دیگری هم هست

107
0:07:32,620 --> 0:07:37,180
شاید این گونه از مسائل که مربوطه به قیامت است

108
0:07:37,180 --> 0:07:40,180
برابر اون نکته دقیق عدبی باشد

109
0:07:40,180 --> 0:07:43,920
نه این که مستقبل محقق قربه او در حکم مازی است

110
0:07:43,920 --> 0:07:45,180
بیان و ذالک این است که

111
0:07:45,900 --> 0:07:49,600
در باره یه آفرینش ارتدائی عالم

112
0:07:49,600 --> 0:07:52,240
خدا به فعل مازی تعبیر کرد

113
0:07:52,240 --> 0:07:55,160
خلقه سماوات و عرض فی سطح تریان

114
0:07:55,160 --> 0:07:58,100
خب اون روز هنوز زمان نبود

115
0:07:58,100 --> 0:08:01
نه مازی بود نه حال بود نه مستقبل

116
0:08:01 --> 0:08:04,040
نه خلقه بود نه یخلقون خالق

117
0:08:04,040 --> 0:08:07,760
و این که زمانی که ما او رو میشناسیم

118
0:08:07,760 --> 0:08:08,880
امیبارت از آن است

119
0:08:08,880 --> 0:08:13,180
که زمین اگه به دور خود بگردد شبان روز پدید می آید

120
0:08:13,180 --> 0:08:15,160
به دور خرشی درکت کند

121
0:08:15,160 --> 0:08:16,860
سال و ماه پدید می آید

122
0:08:16,860 --> 0:08:18,300
این میشه زمان برای نه

123
0:08:18,300 --> 0:08:21,160
در ساغر منظومه هم به شرحی زد

124
0:08:21,160 --> 0:08:24,560
که اگر یه جرمی دور جرمی دیگر حرکت بکند

125
0:08:24,560 --> 0:08:25,980
زمان پدید می آید

126
0:08:25,980 --> 0:08:28,700
جایی که حرکت نیست زمان نیست

127
0:08:28,700 --> 0:08:31,880
به جایی که متحرک نیست حرکت نیست

128
0:08:31,880 --> 0:08:34,860
پس جایی که متحرک نیست از زمان نیست

129
0:08:34,860 --> 0:08:38,360
ذات اقدس اله هنوز آسمانی نبود

130
0:08:38,360 --> 0:08:40,640
زمین نبود متحرک نبود

131
0:08:40,640 --> 0:08:43,120
تازه می خواهد چیزی را بی آفری ند

132
0:08:43,120 --> 0:08:46,100
در اونجا نه ماضی بود نه مزاره نه مستقبل

133
0:08:46,100 --> 0:08:48,620
خب این خلقه

134
0:08:48,620 --> 0:08:52,820
خلق از سماواته بر ارض فیسته در ایام

135
0:08:52,820 --> 0:08:56,040
همون طوری که اون ایام به معنای

136
0:08:56,040 --> 0:08:58,440
روزی در مقابر شب نیست

137
0:08:58,440 --> 0:09:00,340
به معنای شبان روز نیست

138
0:09:00,340 --> 0:09:02,440
به معنای روزگار نیست

139
0:09:02,440 --> 0:09:04,920
چون نه روزگاری نه دهری

140
0:09:04,920 --> 0:09:07,920
نه شبی نه روزی نه شبان روزو هیچی نبود

141
0:09:07,920 --> 0:09:10,340
تازه می خواهد پدید بیاید

142
0:09:10,640 --> 0:09:15,980
در اون حال این فعل منسلخه از زمان است

143
0:09:15,980 --> 0:09:19,720
چون زمان بعد از خلق پدید می آید

144
0:09:19,720 --> 0:09:23,760
نه قبل از خلق بود نه همراه با خلق

145
0:09:23,760 --> 0:09:26,040
الان کاری که ما انجام می دیم

146
0:09:26,040 --> 0:09:28,840
زمان قبل از کار ما وجود دارد

147
0:09:28,840 --> 0:09:32,180
و کار ما هم منطبقه بر زمان است

148
0:09:32,180 --> 0:09:34,340
چه این که بعد از کار ما هم وجود دارد

149
0:09:34,340 --> 0:09:35,360
این حرف زده

150
0:09:35,360 --> 0:09:37,220
یه عمر تدریجی است

151
0:09:37,220 --> 0:09:39,040
منطبقه بر زمان است

152
0:09:39,040 --> 0:09:40,520
این کلمه اول

153
0:09:40,520 --> 0:09:42
در لحظه اول

154
0:09:42 --> 0:09:44,340
صادق می شود کلمه دوبون

155
0:09:44,340 --> 0:09:46,300
در لحظه دوبون و ها کذا

156
0:09:46,300 --> 0:09:49,340
قبل از این که گوینده شروع به سخن بکند

157
0:09:49,340 --> 0:09:50,340
زمان است

158
0:09:50,340 --> 0:09:53,720
گفتن هم منطبقه بر زمان است

159
0:09:53,720 --> 0:09:55,300
چه این عمر تدریجی است

160
0:09:55,300 --> 0:09:57,900
قهرن ماضی و حال و مستقبل دارد

161
0:09:57,900 --> 0:10:00,580
اما در باره اصل آفرینش

162
0:10:00,580 --> 0:10:02,120
که خلقت خدا

163
0:10:02,120 --> 0:10:05,040
مقدمه بر مخلوق است رتبتن

164
0:10:05,040 --> 0:10:08,160
در اونجا اصلا زمانی نیست

165
0:10:08,160 --> 0:10:09,360
تا این فعل

166
0:10:09,360 --> 0:10:10,340
بسرات فعل مخلوق

167
0:10:10,520 --> 0:10:11,500
ماضی باشد

168
0:10:11,500 --> 0:10:13,540
از اینها قوی تر

169
0:10:13,540 --> 0:10:15,680
اصاف زاتی خود

170
0:10:15,680 --> 0:10:17,100
زات اقباس اله هست

171
0:10:17,100 --> 0:10:19,640
که میگن کانال لها عدیمن قدیره

172
0:10:19,640 --> 0:10:20,840
و امثال زاده

173
0:10:20,840 --> 0:10:23,840
در همین کتب عدبی ملازف هر مدید

174
0:10:23,840 --> 0:10:26
گفتن این گونه از کانه ها

175
0:10:26 --> 0:10:28,320
به فعل های ماضی منسلخه

176
0:10:28,320 --> 0:10:29,300
از زمان است

177
0:10:29,300 --> 0:10:31,680
پس دوتا مطلب تو کتب عدبی هست

178
0:10:31,680 --> 0:10:33,520
یکی این که گاهی

