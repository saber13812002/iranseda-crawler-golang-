649
0:26:55,920 --> 0:26:58,960
معناش نست که این چهارتا رو جدا کردیم

650
0:26:58,960 --> 0:27:02,620
اون یکی که واحد لابلعدد است جدا کردیم

651
0:27:02,620 --> 0:27:05,180
در حالی که اون حقیقت نامتناهی است

652
0:27:05,180 --> 0:27:09,540
در اول همه اینها را بدون امتزاج پر کرده

653
0:27:09,540 --> 0:27:14,360
که فیض او داخل اون فیل اشراع لابل ممازجه

654
0:27:14,360 --> 0:27:17,120
مطلب دیگر اون است که

655
0:27:17,120 --> 0:27:19,600
اینا واقعا قائل بودن

656
0:27:19,600 --> 0:27:22,380
بعد از جریان ایسا سلام الله

657
0:27:22,380 --> 0:27:23,660
به این که سخ خدا

658
0:27:23,660 --> 0:27:24,700
در آلم هست

659
0:27:24,700 --> 0:27:26,840
حالا سه معبود هست مانند آن

660
0:27:26,840 --> 0:27:29,200
اول می گفتن روح القدس

661
0:27:29,200 --> 0:27:31,580
بعد ایسا

662
0:27:31,580 --> 0:27:33,220
و در قبالشون هم

663
0:27:33,220 --> 0:27:34,900
ذات اقدس اله مطرح بود

664
0:27:34,900 --> 0:27:36,460
ولی از آیه

665
0:27:36,460 --> 0:27:38,940
سد و شونزده سوره

666
0:27:38,940 --> 0:27:40,660
ماعده برمی آید

667
0:27:40,660 --> 0:27:43,200
که یک تسلیس دیگری هم داشتن

668
0:27:43,200 --> 0:27:44,800
یا گروه دیگری بودن که

669
0:27:44,800 --> 0:27:46,680
به تسلیس دیگر مبتلا شدن

670
0:27:46,680 --> 0:27:48,440
می گفتن خدا

671
0:27:48,440 --> 0:27:50,960
مریم ایسا

672
0:27:50,960 --> 0:27:53,180
نه ابو ابن روح القدس

673
0:27:53,180 --> 0:27:55,160
آیه سد و شونزده

674
0:27:55,160 --> 0:27:57,660
سوره ماعده این است که

675
0:27:57,660 --> 0:27:59,100
ویز قال الله

676
0:27:59,100 --> 0:28:01,780
یا عیس ابن مریمه

677
0:28:01,780 --> 0:28:04,140
اعنت قلت

678
0:28:04,140 --> 0:28:06,580
لناس تخزونی

679
0:28:06,580 --> 0:28:08,480
و امی الهینه

680
0:28:08,480 --> 0:28:09,480
من دون الله

681
0:28:09,480 --> 0:28:12,360
در قیامت ذات اقدس اله

682
0:28:12,360 --> 0:28:13,860
به مسیح می فرماید

683
0:28:13,860 --> 0:28:15,720
تو به مردم گفتی

684
0:28:15,720 --> 0:28:17,260
که من

685
0:28:17,260 --> 0:28:19,980
و مادرم را غیر از خدا

686
0:28:19,980 --> 0:28:22,040
به عنوان اله و معبود

687
0:28:22,040 --> 0:28:23,180
اتخاث کنید

688
0:28:23,180 --> 0:28:26,440
قبلنم در همین زمینه

689
0:28:26,440 --> 0:28:28,320
به مناسبت آیات سوره

690
0:28:28,320 --> 0:28:30,520
ماعده بحث شد

691
0:28:30,520 --> 0:28:32,060
که این خطاب

692
0:28:32,060 --> 0:28:34,560
پیغمبر مسیحا

693
0:28:34,560 --> 0:28:36,400
یعنی ایسا علیه السلام است

694
0:28:36,400 --> 0:28:37,840
ولی اتحاب به

695
0:28:37,840 --> 0:28:40,440
مبتلایان به تسلیس

696
0:28:40,440 --> 0:28:42,140
نه این که

697
0:28:42,140 --> 0:28:43,960
معاذ الله ایسا گفته باشد

698
0:28:43,960 --> 0:28:46,360
ولی ایسا در قیامت

699
0:28:46,360 --> 0:28:47,300
به خدا عرض میکنه

700
0:28:47,300 --> 0:28:48,820
سبحانه که

701
0:28:48,820 --> 0:28:50,540
ما یکونولی

702
0:28:50,540 --> 0:28:52,900
ان اقول ما لیسلی

703
0:28:52,900 --> 0:28:53,560
به حق

704
0:28:53,560 --> 0:28:56,020
ان کنتو قولتو

705
0:28:56,020 --> 0:28:57,480
فقد علمته

706
0:28:57,480 --> 0:29:00,160
تعله ما فی نفسی

707
0:29:00,160 --> 0:29:02,300
ولا اعله ما فی نفسی

708
0:29:02,300 --> 0:29:04,920
انکن تعلام القیوب

709
0:29:04,920 --> 0:29:05,420
خب

710
0:29:05,420 --> 0:29:08,480
از این تسنیه

711
0:29:08,480 --> 0:29:10,180
در قبال خدا

712
0:29:10,180 --> 0:29:12,780
و با افزودن خدا

713
0:29:12,780 --> 0:29:14,760
که تسلیس در می آید

714
0:29:14,760 --> 0:29:16,060
معلوم می شود

715
0:29:16,060 --> 0:29:17,740
که گروه قائل بودن

716
0:29:17,740 --> 0:29:19,160
به الوهیت خدا

717
0:29:19,160 --> 0:29:21,720
به مریم و ایسا

718
0:29:21,720 --> 0:29:24,160
و گروه دیگر معتقد بودن

719
0:29:24,160 --> 0:29:25,660
به الوهیت خدا

720
0:29:25,660 --> 0:29:27,420
و روح القدس

721
0:29:27,420 --> 0:29:28,340
به مریم

722
0:29:28,340 --> 0:29:31,040
هر کدام از اینها باشد باطل است

723
0:29:31,040 --> 0:29:33,900
آیه محل بعض هر دو را ابتال میکند

724
0:29:33,900 --> 0:29:36,180
که لا تغول و سلاست

725
0:29:36,180 --> 0:29:38,060
و ننتهو خیرن لکم

726
0:29:38,060 --> 0:29:40,620
خواه تسلیس به این صورت باشد

727
0:29:40,620 --> 0:29:42
که بگوید

728
0:29:42 --> 0:29:44,100
ابو ابن روح القدس

729
0:29:44,100 --> 0:29:46,260
خواه به این صورت باشد

730
0:29:46,260 --> 0:29:47,100
که بگوید

731
0:29:47,100 --> 0:29:49,680
ابو امو ابن

732
0:29:49,680 --> 0:29:51,600
بر صورت باشد مستحیل است

733
0:29:51,720 --> 0:29:53,300
مثل این بیان برخ داشت

734
0:29:53,300 --> 0:29:54,180
الحمدلله

