0:27:32,740 --> 0:27:35,740
و عاد ملککم علا مکان

674
0:27:35,740 --> 0:27:38,060
دباره حکومت شما برمی کرده

675
0:27:38,060 --> 0:27:39,420
کمکتونم میکنیم

676
0:27:39,420 --> 0:27:43,500
امددناکم به اموال و بنیم

677
0:27:43,500 --> 0:27:44,860
ایوه اکثرنا لکم

678
0:27:44,860 --> 0:27:47,720
اولادتون را زیاد میکنیم

679
0:27:47,720 --> 0:27:49,100
اموالتون را زیاد میکنیم

680
0:27:49,100 --> 0:27:51,260
اموال تلای دنیا دست اینهاست

681
0:27:51,260 --> 0:27:53,340
اموال دست اینهاست

682
0:27:53,340 --> 0:27:56,240
ادب و ادب و نیرو

683
0:27:56,240 --> 0:27:57,780
همه را به شما برمی گردونیم

684
0:27:57,780 --> 0:28:01,860
و جعناکم اکثر نفیر ها

685
0:28:01,860 --> 0:28:06,240
آیا نفیر به معنای عدده؟

686
0:28:06,240 --> 0:28:10,240
به معنای انصاره؟

687
0:28:10,240 --> 0:28:14,640
و جعناکم اکثر عددن و انصارن من اعدائیکم

688
0:28:14,640 --> 0:28:16,860
عددشون خیلی نیست

689
0:28:16,860 --> 0:28:19,080
اما این

690
0:28:19,100 --> 0:28:23,600
چی میگن پیاد نظامهاشون

691
0:28:23,600 --> 0:28:25,820
کشورهای منطقه

692
0:28:25,820 --> 0:28:27,160
عربستان یهودی

693
0:28:27,160 --> 0:28:28,160
نمیدونم این

694
0:28:28,160 --> 0:28:29,740
بعضی از این کشورهای

695
0:28:29,740 --> 0:28:32,580
کوچک دوائیلات

696
0:28:32,580 --> 0:28:34,600
حاشه خلیج فارس

697
0:28:34,600 --> 0:28:36,520
یا بعضی کشورهای عربی

698
0:28:36,520 --> 0:28:38,480
همدست همدست میشن

699
0:28:38,480 --> 0:28:40,380
بله بیایید فکر بکنیم

700
0:28:40,380 --> 0:28:42,420
که برای فلسطینی ها

701
0:28:42,420 --> 0:28:44,460
یه جای دیگر غیر از قدس

702
0:28:44,460 --> 0:28:47,100
چی میگن پای تخت خرار بدیم

703
0:28:47,100 --> 0:28:49,080
یعنی حرف اونا هرچی بگیرینه هایی

704
0:28:49,100 --> 0:28:49,860
کن درسته

705
0:28:49,860 --> 0:28:51,880
شما باید عقب مشینی کنید

706
0:28:51,880 --> 0:28:53,720
اینا پای دین نظامهاشون هستن

707
0:28:53,720 --> 0:28:55,780
مصر عربستان فقرمون

708
0:28:55,780 --> 0:28:56,760
همشون یکیه

709
0:28:56,760 --> 0:28:59,460
کن لما دخلت امه

710
0:28:59,460 --> 0:29:01,880
لعنت اختها

711
0:29:02,540 --> 0:29:04,220
حسابشون با حساب مردم

712
0:29:04,220 --> 0:29:05,060
فرق بکنن

713
0:29:05,060 --> 0:29:06,460
خلاصه به شما

714
0:29:06,460 --> 0:29:09,700
عدد میدیم انصار میدیم

715
0:29:09,700 --> 0:29:11,880
یار میدیم که از دشمناتون بیشتر باشن

716
0:29:12,520 --> 0:29:15,880
خب باید چی کار کنید

717
0:29:16,680 --> 0:29:19,080
تجربه کردید دیگه

718
0:29:19,080 --> 0:29:21,600
شما را مستحسن کردن

719
0:29:21,600 --> 0:29:23,880
شکن کردن

720
0:29:23,880 --> 0:29:25,040
نتیجه کاراتون بود

721
0:29:25,040 --> 0:29:27,540
خب برگردید

722
0:29:27,540 --> 0:29:30,480
و یک مقدار درست رفتار کنید

723
0:29:30,480 --> 0:29:32,720
و اگر درست رفتار کنید

724
0:29:32,720 --> 0:29:34,020
به نفع خودتونه

725
0:29:34,020 --> 0:29:36,260
این احسنتون احسنتون

726
0:29:36,260 --> 0:29:37,760
لی انفسکون

727
0:29:37,760 --> 0:29:40,520
یعنی اگر در قولتون

728
0:29:40,520 --> 0:29:41,880
در رفتارتون

729
0:29:41,880 --> 0:29:44,060
درست رفتار کنید

730
0:29:44,060 --> 0:29:45,480
این به نفع خودتونه

731
0:29:45,480 --> 0:29:48,060
سنف احسانکم عایدون ایلیکم

732
0:29:48,060 --> 0:29:50,480
به خودتون برمیگرده

733
0:29:50,480 --> 0:29:52,740
و صحابه شما به خودتون برمیگرده

734
0:29:52,740 --> 0:29:53,960
بعد

735
0:29:53,960 --> 0:29:56,180
تنصرونه اما ادکن فدونه

736
0:29:56,180 --> 0:29:56,960
و تثابونه

737
0:29:56,960 --> 0:29:58,440
خب درست رفتار کنید

738
0:29:58,440 --> 0:29:59,880
در دشمانه پیروز میشه

