یا بیش از سد ازار نفر پرستادیم

643
0:25:22,240 --> 0:25:25,080
او رفته معموریت را به خوبی انجام داده

644
0:25:25,080 --> 0:25:26,500
و مردم

645
0:25:26,500 --> 0:25:27,700
به اون ایمان آوردن

646
0:25:27,700 --> 0:25:29,840
و تایی مدتی هم زندگی میشه دادن

647
0:25:29,840 --> 0:25:32,940
فآمنو فمتعناهو ملاهین

648
0:25:32,940 --> 0:25:34,260
به همین دلیل

649
0:25:34,260 --> 0:25:35,460
که در سوره مبارکه

650
0:25:35,460 --> 0:25:37,100
اصافات آمده مردم میشود

651
0:25:37,100 --> 0:25:39,460
که قمعه او این بود که

652
0:25:39,460 --> 0:25:41,380
پیغمبری است که از این استفاده نمیشود

653
0:25:41,380 --> 0:25:43,260
ارز کرد که

654
0:25:43,260 --> 0:25:46,180
لا اله الا ان سبحانه که اندی کنت من الله رمین

655
0:25:46,180 --> 0:25:47,580
اونگاه خداوند

656
0:25:47,580 --> 0:25:49,040
فبول ما او را نجات دادیم

657
0:25:49,040 --> 0:25:52,480
و ارسلناهو الامعت الفن او یزیدون

658
0:25:52,480 --> 0:25:55,060
فآمنو فمتعناهو ملاهین

659
0:25:55,060 --> 0:25:55,940
دیگر

660
0:25:55,940 --> 0:25:58,260
این قمعه او را خداوند

661
0:25:58,260 --> 0:25:59,640
چنون برطرف کرده است

662
0:25:59,640 --> 0:26:01,060
که این گروه دومون

663
0:26:01,060 --> 0:26:02,600
مثل گروه اول نبودن

664
0:26:02,600 --> 0:26:05,280
گروه اول بلخص تمری داشتن

665
0:26:05,280 --> 0:26:06,760
ایمان نیاوردن

666
0:26:06,760 --> 0:26:08,920
و قذب الهی دامن گرونان شد

667
0:26:08,920 --> 0:26:11,580
تا اون آخرین لحظه ایمان نیاوردن

668
0:26:11,580 --> 0:26:13,500
بعد توبه کردن و عذاب الهی

669
0:26:13,500 --> 0:26:14,420
از اینا گرفته شد

670
0:26:14,420 --> 0:26:17,340
ولی موجود اون باره که یونس سلامالله

671
0:26:17,340 --> 0:26:18,920
به این نعمت رسیده است

672
0:26:18,920 --> 0:26:20,740
اونگاه در قیامت

673
0:26:20,740 --> 0:26:23,660
امتی را به همراه خود بهشت میبرد

674
0:26:23,660 --> 0:26:26,280
و همه خیراتی که امت دارن

675
0:26:26,280 --> 0:26:27,780
سواب اونها

676
0:26:27,780 --> 0:26:30,420
در نامه عمل امامشو هم نمیشته میشد

677
0:26:30,420 --> 0:26:32,340
چون من سن سنت هسنه

678
0:26:32,340 --> 0:26:34,680
سواب کسانی که پیروبان

679
0:26:34,680 --> 0:26:36,040
سنت هسنه هستن

680
0:26:36,040 --> 0:26:38,140
در نامه عمل

681
0:26:38,140 --> 0:26:39,640
اون سنت گذار نمیشد

682
0:26:39,640 --> 0:26:41,480
چنین بطی بهتر از این

683
0:26:41,480 --> 0:26:43
اینی که در دعای کمه

684
0:26:43 --> 0:26:45,800
انسان میخواد خدای من را هزمن ازدیکتر بکن

685
0:26:45,800 --> 0:26:48,020
یا در پایان سور فرغان

686
0:26:48,020 --> 0:26:50,320
هست که وجه ادنال المتقینه اماما

687
0:26:50,320 --> 0:26:52,340
خب آدم اگه ترسی زندگی بکند

688
0:26:52,340 --> 0:26:53,940
که انسانهای خوب

689
0:26:53,940 --> 0:26:56,480
در اون گستای یا شهر به اون اقتدام بکنند

690
0:26:56,480 --> 0:26:57,580
نه یعنی فقط

691
0:26:57,580 --> 0:26:59,840
در نماز به اون اقتدام بکنند

692
0:26:59,840 --> 0:27:01,340
روش اون را بپذیرند

693
0:27:01,340 --> 0:27:04,400
همه اعمال خیلی که اون مردم انجام میدن

694
0:27:04,400 --> 0:27:06,480
در نامه عمل این شخص هم صفت است

695
0:27:06,480 --> 0:27:07,980
این که نمیگوید

696
0:27:07,980 --> 0:27:08,940
امه خیر و من

697
0:27:08,940 --> 0:27:11,720
این چون خاک سارتر از همه هست

698
0:27:11,720 --> 0:27:13,080
همه به اون اقتدام بکنند

699
0:27:13,080 --> 0:27:15,780
اما ذات اقدسی اله

700
0:27:15,780 --> 0:27:16,920
دو تا حرف زد

701
0:27:16,920 --> 0:27:20,080
یکی مال قبل

702
0:27:20,080 --> 0:27:21,620
از دریا افتادن

703
0:27:21,620 --> 0:27:23
و به دل ماهی رفتن

704
0:27:23 --> 0:27:24,020
این چی بعد از اون

705
0:27:24,020 --> 0:27:27,860
اون جریان قبل از دریا افتادن

706
0:27:27,860 --> 0:27:29,120
و به دل ماهی رفتن

707
0:27:29,120 --> 0:27:30,860
که اجلهی کرده است

708
0:27:30,860 --> 0:27:32,120
معمولت ترک کرده است

709
0:27:32,120 --> 0:27:33,840
همون اون کار را شما نکنید

710
0:27:33,840 --> 0:27:38,200
اما اون مناجات و اون خضوع

711
0:27:38,200 --> 0:27:40,360
و اون عدب و اون تضروب

712
0:27:40,360 --> 0:27:42,740
و اون تعلوهی که در دل ماهی

713
0:27:42,740 --> 0:27:43,780
نصیب و شده است

714
0:27:43,780 --> 0:27:45,020
اون را اقتدام کنید

715
0:27:45,020 --> 0:27:46,240
با اون عمل کنید

716
0:27:46,240 --> 0:27:47,900
و کذالکه ننجل مؤمنین

717
0:27:47,900 --> 0:27:49,460
نه ننجل مرسلین

718
0:27:49,460 --> 0:27:53,040
تا بدو این ذکر یونس مولا انبیا و مرسلین است

719
0:27:53,040 --> 0:27:54,260
نه ننجل مؤمنین

720
0:27:54,260 --> 0:27:56,860
هر کسی هر غم میداشته باشد

721
0:27:56,860 --> 0:27:58,940
مخصوصات اهل علمی که

722
0:27:58,940 --> 0:28:02,440
قمدین است که رسالت و وراثت انبیا را

723
0:28:02,440 --> 0:28:05,920
نتوانسته به فعالیت برساند

724
0:28:05,920 --> 0:28:09
این ذکر برای اون معصر خواهد بود

725
0:28:09 --> 0:28:11,780
خب شایدان انبیا همینطورا

726
0:28:11,780 --> 0:28:14,880
اونا که فیض خاص نصیب اونها شده است

727
0:28:14,880 --> 0:28:15,600
این چی اینند

728
0:28:15,600 --> 0:28:18,540
در جریان سلیمان و داود

729
0:28:18,540 --> 0:28:19,260
اون نعید

730
0:28:19,460 --> 0:28:21,620
نعمت های عظیمی را که

731
0:28:21,620 --> 0:28:23,840
نصیب داود و سلیمان شده است

732
0:28:23,840 --> 0:28:26,440
اونا فورا گفتن این نعمت خدا است

733
0:28:26,440 --> 0:28:27,780
که ما مرحمت کرده است

734
0:28:27,780 --> 0:28:32,520
یعنی وقتی اون تخت ملکه سبا

735
0:28:32,520 --> 0:28:35,440
از یمن به فلسین آمد

736
0:28:35,440 --> 0:28:48,040
این عدب سلیمان است

737
0:28:48,040 --> 0:28:49,440
مشابه این رازیده

738
0:28:49,460 --> 0:28:52,780
زلغرنه این دارد که در سوره کهف آمده

739
0:28:52,780 --> 0:28:56,100
در سوره کهف وقتی سخن اون زلغرنه نقل میکند

740
0:28:56,100 --> 0:28:58,860
این است که او یه دیوار فلزی ساخته است

741
0:28:58,860 --> 0:29:02,480
نه دیوار خاکی یا سنگی به ماننده اون

742
0:29:02,480 --> 0:29:06,740
چون در سوره کهف آیه ۹۶ به بعد این است که

743
0:29:06,740 --> 0:29:09,020
آتونی زو برال حدیده

744
0:29:09,020 --> 0:29:11,460
حتی ازا سوا بین از صدفه اینه

745
0:29:11,460 --> 0:29:12,260
قالن فخو

746
0:29:12,260 --> 0:29:14,200
حتی ازا جعله نارن

747
0:29:14,200 --> 0:29:16,860
قال آتونی افق علیه قطرن

748
0:29:16,860 --> 0:29:20,320
وقتی که کاملا این مواد زوب شده

749
0:29:20,320 --> 0:29:21,580
افروخت شد

750
0:29:21,580 --> 0:29:23,560
گفت حالا اون مواد را بریزید

751
0:29:23,560 --> 0:29:27,480
که این کاملا به صورت یک صدفه لیزی در بیاید

752
0:29:27,480 --> 0:29:31,320
که نبشه باید از روی او در اثر شدت ارتفاع رفت

753
0:29:31,320 --> 0:29:34,100
و نمیشه باید از وسطش او را نقل زد

754
0:29:34,100 --> 0:29:37,280
چنین صدفه مستحکمی را که دید گفت

755
0:29:37,280 --> 0:29:39,440
حاضا رحمتون من ربی

756
0:29:39,440 --> 0:29:43,720
پس اگر سلیمان است بعد مشاهده اون جاریان تخت

757
0:29:43,720 --> 0:29:46,180
و حاضا من فضل ربی

758
0:29:46,180 --> 0:29:46,720
لیبلو

759
0:29:46,860 --> 0:29:52,200
اگر زورقررین است بعد احداث اون دیوار معروف

760
0:29:52,200 --> 0:29:54,340
که حاضا رحمتون من ربی

761
0:29:54,340 --> 0:29:57,040
این نشانه عدب معلاه است

762
0:29:57,040 --> 0:29:58,760
والحمدلله رب العالمين

