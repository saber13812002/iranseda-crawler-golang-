برای یوسف در زمین

467
0:22:29,880 --> 0:22:34,060
و برای اون که

468
0:22:34,060 --> 0:22:36,640
تعویل الاهادیس رو بهش بگیم

469
0:22:36,640 --> 0:22:38,520
اون چرا در خواب دیده بود

470
0:22:38,520 --> 0:22:42,700
اینا زمینه هاش رو فراهم میکنه

471
0:22:42,700 --> 0:22:46,380
که بروز و نمود

472
0:22:46,380 --> 0:22:48,040
خارجی خوابش رو ببینیم

473
0:22:48,760 --> 0:22:50,040
ملاحظه بفرمایید

474
0:22:50,600 --> 0:22:52,040
او نتخذه و ولدن

475
0:22:53,040 --> 0:22:55,040
اینجا ولد مردن

476
0:22:55,900 --> 0:22:57,680
متعارف نیست

477
0:22:57,680 --> 0:23:02,180
بلکه پسر خاندگی مدره هست

478
0:23:02,180 --> 0:23:06,720
سوره غسس رو بیارید

479
0:23:06,720 --> 0:23:11,400
سوره بیست و هشتم قرآن

480
0:23:11,400 --> 0:23:15,880
آیه نه

481
0:23:15,880 --> 0:23:20,360
همسر فرعون

482
0:23:20,360 --> 0:23:25,880
گفت که این بچه مایی نور چشم ما و شماست

483
0:23:25,900 --> 0:23:29,080
نکش او را

484
0:23:29,080 --> 0:23:33,820
که بسادر آینده به درد ما بخورد

485
0:23:33,820 --> 0:23:37,680
یا او را ما به فرزند خاندگی بگیریم

486
0:23:38,320 --> 0:23:40,880
و هم لای شروع

487
0:23:40,880 --> 0:23:43,680
پس این که

488
0:23:44,240 --> 0:23:46,240
وقالت تخذ الله

489
0:23:46,240 --> 0:23:49,740
ولدن

490
0:23:49,740 --> 0:23:53,680
باید با توجه به این دوتا آیه

491
0:23:54,280 --> 0:23:55,680
معنا کرد

492
0:23:55,900 --> 0:23:57,980
اتخاذ الولد

493
0:23:57,980 --> 0:24:04,440
یعنی کسی را به انوان پسر خاندگی پذیرفتن

494
0:24:04,440 --> 0:24:07,960
نه به انوان پسر آقی

495
0:24:07,960 --> 0:24:09,960
و اما ولد

496
0:24:09,960 --> 0:24:12,360
ولد

497
0:24:12,360 --> 0:24:15,800
به مولود گفته میشه

498
0:24:15,800 --> 0:24:19,740
مفرد ولد است

499
0:24:19,740 --> 0:24:23
جم هم ولد است

500
0:24:23 --> 0:24:25,820
سقیر هم ولد است

501
0:24:25,900 --> 0:24:29,300
کبیر هم ولد است

502
0:24:29,300 --> 0:24:36,120
به فرزند خانده هم ولد گفته میشه

503
0:24:36,120 --> 0:24:38,240
مثل این مواردی که گفتیم

504
0:24:38,240 --> 0:24:39,560
ولد

505
0:24:39,560 --> 0:24:43,780
به معنای خانواده و بچه ها

506
0:24:43,780 --> 0:24:46,080
الولد

507
0:24:46,080 --> 0:24:49,680
الاحل و الولد

508
0:24:49,680 --> 0:24:54,820
والدین هم روشن است

509
0:24:54,820 --> 0:24:55,880
ولدین هم روشن است

510
0:24:55,900 --> 0:24:57,900
ولد پدر است و

511
0:24:57,900 --> 0:24:59,900
ولد مادر

512
0:24:59,900 --> 0:25:05,900
ربق فلی ولدگی

513
0:25:05,900 --> 0:25:07,900
این واجه ولد

514
0:25:07,900 --> 0:25:09,900
ولد

515
0:25:09,900 --> 0:25:11,900
ولد

516
0:25:11,900 --> 0:25:13,900
چی؟

517
0:25:13,900 --> 0:25:15,900
ولی

518
0:25:15,900 --> 0:25:17,900
ولی از ماده ولده نیست

519
0:25:17,900 --> 0:25:19,900
ولید

520
0:25:19,900 --> 0:25:21,900
ولید به معنای نوزاده

521
0:25:21,900 --> 0:25:23,900
بعضی هم میگن نوزادی که از کنیز

522
0:25:23,900 --> 0:25:25,900
ولید به معنای نوزاده

523
0:25:25,900 --> 0:25:27,900
ولید باشه

524
0:25:27,900 --> 0:25:31,900
ولید و ولیده ای که از کنیز باشه

525
0:25:31,900 --> 0:25:33,900
سبحا نهو

526
0:25:33,900 --> 0:25:37,900
اینجا برخی گفتن سبحا نهو

527
0:25:37,900 --> 0:25:40,900
اینجا به معنای تعجبه

528
0:25:40,900 --> 0:25:45,900
برخی هم گفتن که به همون معنای خودشه

529
0:25:45,900 --> 0:25:49,900
سبحان از ریشه سبح است

530
0:25:49,900 --> 0:25:53,900
سبح

531
0:25:53,900 --> 0:25:57,480
به معنای شناگری سریع در آب

532
0:25:57,480 --> 0:26:02,600
یا حرکت سریع در هواست

533
0:26:02,600 --> 0:26:04,900
المرر سریع

534
0:26:05,680 --> 0:26:09,120
فی الماء و فی الهوا

535
0:26:09,120 --> 0:26:13,900
سوره مزمل آیه هفت

536
0:26:13,900 --> 0:26:19,900
این لکف نهاره سبحن طبیله

537
0:26:19,900 --> 0:26:21,900
پیغمبر

538
0:26:21,900 --> 0:26:26,380
یا ایهال مزمل قوم لیل تا آخر آیه

539
0:26:26,380 --> 0:26:31,380
باید عبادت شبانه داشته باشی

540
0:26:31,380 --> 0:26:34,900
چون این لکف نهاره سبحن طبیله

541
0:26:35,480 --> 0:26:41,400
تو روز باید شناگر دریای مشکلات باشی

542
0:26:41,400 --> 0:26:48,780
به تسبیح خدا هم که صبحان گفته میشه

543
0:26:49,900 --> 0:26:54,380
به تنظیح صبحان گفته میشه

544
0:26:54,380 --> 0:26:59,400
المرر سریع فی عبادت الله

545
0:26:59,400 --> 0:27:05,880
چون حرکت سریع در عبادت خداست

546
0:27:05,880 --> 0:27:08,960
با تنظیح خدا

547
0:27:08,960 --> 0:27:14,240
انسان وارد محبته لطف

548
0:27:14,240 --> 0:27:19,440
و محبته انایت خدا قراره

549
0:27:19,900 --> 0:27:26,820
احسنتم این منزه هست چرا

550
0:27:26,820 --> 0:27:32,140
به خاطر اینکه اولین گامی که آدم وارد شناگری

551
0:27:32,140 --> 0:27:36,700
در عرصه عبادت میشود این باوره

552
0:27:36,700 --> 0:27:41,140
یعنی اگر باورش نباشد که

553
0:27:42,480 --> 0:27:46,140
او خداست منزه هست

554
0:27:46,880 --> 0:27:49,140
از صفات بندگان او را عبادتونه

555
0:27:49,900 --> 0:27:51,120
او را عبادتونه میکنه

556
0:27:51,120 --> 0:27:55,380
پس تنظیح خداوند هم

557
0:27:55,380 --> 0:27:59,220
به همین دلیل هست که در حقیقت

558
0:27:59,220 --> 0:28:03,820
آغاز سیر عبادی است

559
0:28:03,820 --> 0:28:08,160
و اما نکات تفسیری

560
0:28:08,160 --> 0:28:11,900
نکته اول تفسیری اینست که

561
0:28:13,240 --> 0:28:16,900
به نظر میرسد هر فیرا که

562
0:28:16,900 --> 0:28:19,320
کفار قریش

563
0:28:19,900 --> 0:28:21,720
میگفتند

564
0:28:21,720 --> 0:28:27,380
میگفتند که ولد

565
0:28:27,380 --> 0:28:31,680
در تدبیر جهان هستی

566
0:28:31,680 --> 0:28:34,280
خدا رو یاری میکنه

567
0:28:34,280 --> 0:28:41,120
جوابی را هم که این آیی شریف دارد

568
0:28:41,120 --> 0:28:44,240
این معنا رو تأیید میکنه

569
0:28:44,240 --> 0:28:49,340
یعنی کفار قریش قبول داشتند

570
0:28:49,900 --> 0:28:53,480
که ولد به معنای متعارف

571
0:28:53,480 --> 0:28:57,540
در مورد خداوند معنا نداره

572
0:28:57,540 --> 0:29:03,140
لیکن این کتا فکری رو داشتند

573
0:29:03,140 --> 0:29:08,560
که میخواستن ایادی برای خدا درست کنند

574
0:29:08,560 --> 0:29:14,160
کسانی رو برای خدا بتراشند

575
0:29:14,160 --> 0:29:17,320
که به او کمک کنند

576
0:29:17,320 --> 0:29:19,320
در تدبیر جهان هستید

577
0:29:19,900 --> 0:29:24,580
سوره اسرا رو بیارید

578
0:29:24,580 --> 0:29:35,620
آیه 111 آخرین آیه سوره اسرا هست

579
0:29:35,620 --> 0:29:38,660
سوره هفته همه قرآن

580
0:29:38,660 --> 0:29:41,640
لم یتخذ ولدن

581
0:29:41,640 --> 0:29:45,840
ولم یکلهو شریکن فلملک

582
0:29:45,840 --> 0:29:48,180
در حقیقت

583
0:29:48,180 --> 0:29:49,700
نفی ولدن

584
0:29:49,900 --> 0:29:55,940
ولد مقدمه آن است که شریکی فلملک

585
0:29:55,940 --> 0:30:00,100
برای ذات مقدس روبوبی نوازده است

