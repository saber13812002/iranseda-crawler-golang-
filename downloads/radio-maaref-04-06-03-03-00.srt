اعضایی که آزادن میشه شست

679
0:25:42,260 --> 0:25:43,840
اونو رو باید بشید

680
0:25:43,840 --> 0:25:46,200
یعنی اگر دست راست شما

681
0:25:46,200 --> 0:25:47,900
شکسته باشه با دست چپ

682
0:25:47,900 --> 0:25:50,340
اونجایی که گچ گرفته شده

683
0:25:50,340 --> 0:25:51,700
به نیت جبیره

684
0:25:51,700 --> 0:25:53,960
حتی یه پارچه پلاسی امروش

685
0:25:53,960 --> 0:25:56,020
بندازید که خدمتون آرزم

686
0:25:56,020 --> 0:25:57,820
دستتون با گچ

687
0:25:57,820 --> 0:26:00,040
برخون نکنه یا اونا از بین نرن

688
0:26:00,040 --> 0:26:01,540
یا ممکنه نجست باشه

689
0:26:01,540 --> 0:26:04,480
یه پارچه پلاسیگی هم استفاده بکنید

690
0:26:04,480 --> 0:26:06,140
اون مقداری که

691
0:26:06,140 --> 0:26:07,900
داخله با

692
0:26:07,900 --> 0:26:09,820
نیت وزو جبیره

693
0:26:09,820 --> 0:26:11,280
دست روش بکشید

694
0:26:11,280 --> 0:26:13,100
یا قصد جبیره فرقی نداره

695
0:26:13,100 --> 0:26:15,980
بقیه یه اعضایی که آزاد

696
0:26:15,980 --> 0:26:17,580
آزادن اونا رو

697
0:26:17,580 --> 0:26:20,140
روال عادی وزو بگیرید

698
0:26:20,140 --> 0:26:21,960
انشانا موفق باشید

699
0:26:23,960 --> 0:26:26,220
به انگام اقامه نماز

700
0:26:26,220 --> 0:26:27,820
اگر حواس ما پرد شود

701
0:26:27,820 --> 0:26:29,440
و از کاری رو که گفتیم

702
0:26:29,440 --> 0:26:32,100
مجددن آغاز نماییم به خاندن آن

703
0:26:32,100 --> 0:26:33,800
آیا این کار ما

704
0:26:33,800 --> 0:26:35,920
اشکالی به نماز وارد می کند

705
0:26:35,920 --> 0:26:37,060
به عنوان مثال

706
0:26:37,060 --> 0:26:38,920
در حین خاندن سوره همد

707
0:26:38,920 --> 0:26:40,660
اگر حواس ما پرد شود

708
0:26:40,660 --> 0:26:43,220
و ما بعد از آن دوباره سوره همد را

709
0:26:43,220 --> 0:26:44,500
از اول بخانیم

710
0:26:44,500 --> 0:26:46,120
نماز ما چه حکمی دارد

711
0:26:46,120 --> 0:26:48,240
حجت الاسلام و المسلمین علیان نجات

712
0:26:48,240 --> 0:26:50,420
پاسخ این سؤال را طبق فتوی

713
0:26:50,420 --> 0:26:52,240
اگر حضرت آیت الله مکاره می شیر

714
0:26:52,240 --> 0:26:53,120
از این توضیح می دن

715
0:26:53,120 --> 0:26:55,880
البته این کار لازم نیست

716
0:26:55,880 --> 0:26:59,260
اما در صورتی که به حد وسواس نرسه

717
0:26:59,260 --> 0:27:01,040
اشکالی نداره

718
0:27:01,040 --> 0:27:02,900
هرچن بهتره

719
0:27:02,900 --> 0:27:04,820
بر جبران این نقیسه

720
0:27:04,820 --> 0:27:07,720
از تقیبات نماز استفاده کنید

721
0:27:07,720 --> 0:27:09,320
چرا که تبایی

722
0:27:09,320 --> 0:27:11,800
از روایات اسلامی استفاده می شه

723
0:27:11,800 --> 0:27:13,380
تقیبات نماز

724
0:27:13,380 --> 0:27:15,360
علاوه بر کمال نماز

725
0:27:15,360 --> 0:27:16,680
و قبولی اون سبب

726
0:27:16,680 --> 0:27:19,060
فرابانی رزق روزی می شه

727
0:27:19,060 --> 0:27:20,400
و تا زمانی که

728
0:27:20,400 --> 0:27:22,420
انسان با ایمان پس از نماز

729
0:27:22,420 --> 0:27:24,420
در حال ذکر خداست

730
0:27:24,420 --> 0:27:26,700
گویا در حالت نمازه

731
0:27:26,700 --> 0:27:28,720
و سواب نماز رو می بره

732
0:27:28,720 --> 0:27:31,720
و دعای بعد از نماز واجب

733
0:27:31,720 --> 0:27:33,320
که نوعی تقیب

734
0:27:33,320 --> 0:27:35,340
محصول می شه از نماز مصحبی

735
0:27:35,340 --> 0:27:36,460
بهتره

736
0:27:50,400 --> 0:28:20,380
محصولی از نماز

737
0:28:20,380 --> 0:28:20,920
از نمازیستانی

738
0:28:20,920 --> 0:28:23,220
اون قسمتی که سیاه شده

739
0:28:23,220 --> 0:28:26,340
یا این که می دونید که نجست شده

740
0:28:26,340 --> 0:28:28,300
همین که به تراشید

741
0:28:28,300 --> 0:28:30,500
کفایت می کنه و مورتون درست می شه

742
0:28:30,500 --> 0:28:32,880
اگر قسمتی که

743
0:28:32,880 --> 0:28:34,100
شما می گید لایه

744
0:28:34,100 --> 0:28:36,580
بین خاک و پیشانی نباشد

745
0:28:36,580 --> 0:28:38,300
این لایه

746
0:28:38,300 --> 0:28:40,820
اگر چربیه و سیاهیه

747
0:28:40,820 --> 0:28:42,260
خب همون رو

748
0:28:42,260 --> 0:28:44,520
شما می تراشید و برطرف

749
0:28:44,520 --> 0:28:46,080
می شه و انشاءالله مشکلی نداره

750
0:28:46,080 --> 0:28:48,200
اما اگر نسبت به نجاست باشد

751
0:28:48,200 --> 0:28:50,080
باید بیشتر به تراشید

752
0:28:50,380 --> 0:28:52,500
که مسئله مطمئن بیشید که

753
0:28:53,180 --> 0:28:54,200
اون لایه نجست

754
0:28:54,200 --> 0:28:55,080
از بین رفته

755
0:28:55,080 --> 0:28:59,260
شنابنده اینو بشته

756
0:28:59,260 --> 0:29:02,220
ماهیانه صدقه به دستم برسه

757
0:29:02,220 --> 0:29:04,200
آیا می تونم این مبارغ رو

758
0:29:04,200 --> 0:29:06,500
به فقیر سیگیت بدم یا نه

759
0:29:07,040 --> 0:29:08,740
مرزه تقریدم حضرت آیت الله

760
0:29:08,740 --> 0:29:10,180
شبهری زنجانی هستن

761
0:29:10,180 --> 0:29:11,940
پاسخه و جترستان و مسلمین

762
0:29:11,940 --> 0:29:13,500
جواهری به این سال

763
0:29:13,500 --> 0:29:16,740
پرداخت صدقات به غیر صادات

764
0:29:16,740 --> 0:29:18,580
اشکالی نداره

765
0:29:18,580 --> 0:29:20,020
که اون صدقه

766
0:29:20,020 --> 0:29:21,580
صدقه مستحب باشه

767
0:29:21,580 --> 0:29:24,080
چه صدقه واجب باشه

768
0:29:24,080 --> 0:29:26,160
اون چیزی که

769
0:29:26,160 --> 0:29:27,560
شاید مد نظر

770
0:29:27,560 --> 0:29:30,620
این پرسشگر محترم بوده

771
0:29:30,620 --> 0:29:32,080
اینه که

772
0:29:32,080 --> 0:29:33,880
پرداخت صدقه

773
0:29:33,880 --> 0:29:36,500
واجب غیر سیید

774
0:29:37,120 --> 0:29:38,580
به سیید

775
0:29:38,580 --> 0:29:40,760
آیا جایز هست یا جایز نیست

776
0:29:40,760 --> 0:29:42,600
یعنی که

777
0:29:42,600 --> 0:29:44,600
شخصی صدقه واجب داره

778
0:29:44,600 --> 0:29:47,540
مثل رد مظالم داره

779
0:29:47,540 --> 0:29:48,660
یا

780
0:29:48,660 --> 0:29:49,860
زکات فطره داره

781
0:29:50,020 --> 0:29:53,020
آیا میشه اگر پرداخت کننده

782
0:29:53,020 --> 0:29:55,180
غیر سیید هست

783
0:29:55,180 --> 0:29:56,160
این رو به

784
0:29:56,160 --> 0:29:58,220
سیید به پردازیم

785
0:29:58,220 --> 0:30:00,020
از نظر آیتالو

