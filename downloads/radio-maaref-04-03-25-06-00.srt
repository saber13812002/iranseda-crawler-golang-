نه این که ما علم نداریم

622
0:26:23 --> 0:26:24,540
برای این که جمله بعد که میگن

623
0:26:24,540 --> 0:26:26,400
این نکه انت علام الغیوب

624
0:26:26,400 --> 0:26:28,120
مهمترین مطلب علمی رو

625
0:26:28,120 --> 0:26:29,280
اونجا اقرار مکنن

626
0:26:29,280 --> 0:26:31,140
عرض بکنن که همه غیب را تو میدانی

627
0:26:31,140 --> 0:26:32,440
خب خودش علم است دیگر

628
0:26:32,440 --> 0:26:35,060
اگر این بونبان نفی جنس باشد

629
0:26:35,060 --> 0:26:36,600
عرض کنن که ما علم نداریم

630
0:26:36,600 --> 0:26:37,780
پس این دهده با چیست

631
0:26:37,780 --> 0:26:39,500
این نکه انت علام الغیوب

632
0:26:39,500 --> 0:26:40,740
خب همه اینا

633
0:26:40,740 --> 0:26:43,240
همه اینا کسانی هستن که خدا

634
0:26:43,240 --> 0:26:45,720
نه تنها عروم ظاهری را بین آموخ

635
0:26:45,720 --> 0:26:48,120
و علم کتاب و حکمت بین آموخ

636
0:26:48,120 --> 0:26:50,300
عروم غیب را بین آموخ

637
0:26:50,300 --> 0:26:51,880
همین در جریان یوسف

638
0:26:51,880 --> 0:26:52,820
سلام الله علیه

639
0:26:52,820 --> 0:26:55,820
وقتی که خواستن این را به شاه بین دازن

640
0:26:55,820 --> 0:26:57,220
تصمیم گرفتن

641
0:26:57,220 --> 0:26:59,460
برادران یوسف که وجود مبارکه

642
0:26:59,460 --> 0:27:01,680
به شاه بین دازن همونجا وحی آمد

643
0:27:01,680 --> 0:27:02,920
فرمود یوسف

644
0:27:02,920 --> 0:27:04,320
تو نجات پیدا میکنی

645
0:27:04,320 --> 0:27:07,480
همین سحنه را یه روزی برادرانت اعلام نده

646
0:27:07,480 --> 0:27:09,360
بعد از این که او به زندان

647
0:27:09,360 --> 0:27:11,560
و از زندان هم بلاخره روی تخت اززت

648
0:27:11,560 --> 0:27:12,940
نشست برادران آمدن

649
0:27:12,940 --> 0:27:14,520
همین گریانه با اونا اعلام کرد

650
0:27:14,520 --> 0:27:17,800
میبینید اینجور به صورت سریح و باز

651
0:27:17,800 --> 0:27:19,280
اخبار قیوی

652
0:27:19,280 --> 0:27:21,780
روزات اقدس ایلابین ها گزارش میده

653
0:27:21,780 --> 0:27:23,380
لحظه با لحظه میفهم

654
0:27:23,380 --> 0:27:25,720
تو اینا آلم قیب بشید به ازن خدا

655
0:27:25,720 --> 0:27:27,720
بد معنیش نیست که ما قیب نمیدونیم

656
0:27:27,720 --> 0:27:29,860
آیه پونزده سوره یوسف

657
0:27:29,860 --> 0:27:30,360
اینست که

658
0:27:30,360 --> 0:27:32,980
فلما زهبو بهی و اجمعو

659
0:27:32,980 --> 0:27:35,140
ان یجالو فی قیابت الجوب

660
0:27:35,140 --> 0:27:36,660
و اوحینا الیه

661
0:27:36,660 --> 0:27:38,640
لتنبه انهم

662
0:27:38,640 --> 0:27:40,760
و امرم هازابهم لا اشعرون

663
0:27:40,760 --> 0:27:42,580
فا اون وقتی خواستن بندازن

664
0:27:42,580 --> 0:27:43,640
تو تایچه ها

665
0:27:43,640 --> 0:27:45,960
ما بهش بعه فرست دیدیم

666
0:27:45,960 --> 0:27:47,880
که بالاخره این اوزا میگذرد

667
0:27:47,880 --> 0:27:50,340
تو روزی به اینها میگویی

668
0:27:50,340 --> 0:27:51,760
که اینها به تو چکردن

669
0:27:51,760 --> 0:27:53,860
همین سوره اینباره که یوسف

670
0:27:53,860 --> 0:27:56,380
آیه هشتاد و نه دارد که

671
0:27:56,380 --> 0:27:58,920
حالا که یوسف به اون اوجه ازیت رسید

672
0:27:58,920 --> 0:28:00,260
برادره آمدن

673
0:28:00,260 --> 0:28:01,380
گفتن به اینکه

674
0:28:01,380 --> 0:28:03,960
یا ایوه العزیز نستنا و اهل نظر

675
0:28:03,960 --> 0:28:05,720
بجه اینا به بزارت المزجات

676
0:28:05,720 --> 0:28:06,800
فا او فرانالکی

677
0:28:06,800 --> 0:28:09,620
قلت صدع علینا این الله یجز المصدقین

678
0:28:09,620 --> 0:28:10,820
فرموند قاله

679
0:28:10,820 --> 0:28:13,500
هل علمتون ما فعلتون به یوسف و اخی

680
0:28:13,500 --> 0:28:15,560
یادیتونه با یوسف شکردی

681
0:28:15,560 --> 0:28:17,420
خب همین وحی است که خدا

682
0:28:17,420 --> 0:28:19,300
در همون سوره اینباره که

683
0:28:19,300 --> 0:28:21,360
یوسف آیه پونزده

684
0:28:21,360 --> 0:28:23,320
در هنگام چاهندازی

685
0:28:23,320 --> 0:28:24,480
یوسف بگو گفت

686
0:28:24,480 --> 0:28:27
این اوزا میگذرد این سحنه میگذرد

687
0:28:27 --> 0:28:28,780
بالاخره اونا پیشتو خواهند آمد

688
0:28:28,780 --> 0:28:30,600
تو این جریانو بنا خواهی گفت

689
0:28:30,600 --> 0:28:32,200
همین اخبار به قیب است دیگر

690
0:28:32,200 --> 0:28:34,840
خب چنین افرادی که تازه

691
0:28:34,840 --> 0:28:37,180
یوسف جزئه کوچکهای اونها است

692
0:28:37,180 --> 0:28:39,280
انبیاه از آنره از من دیگر

693
0:28:39,280 --> 0:28:40,640
و یوسف سلام الله

694
0:28:40,640 --> 0:28:42,240
که جزئه انبیاه از نیست

695
0:28:42,240 --> 0:28:44,620
همه این انبیاه آمدن

696
0:28:44,620 --> 0:28:46,460
و گفتن به این که

697
0:28:46,460 --> 0:28:47,520
لا علم لالا

698
0:28:47,520 --> 0:28:49,560
ولی میشه یه خبر دیگر است

699
0:28:49,560 --> 0:28:51,600
حالا در همه این جریان

700
0:28:51,600 --> 0:28:53,740
بوجود نبارک پیغمبر صلی اللہ علیه وسلم

701
0:28:53,740 --> 0:28:56,020
مستثناصیانه بعضی از بزرگان

702
0:28:56,020 --> 0:28:57,900
احل معرفت گفتن که

703
0:28:57,900 --> 0:28:59,780
در این سؤال و جواب

704
0:28:59,780 --> 0:29:01,460
عمومی پیغمبر اسلام

705
0:29:01,460 --> 0:29:02,400
مستثناصیانه

706
0:29:02,400 --> 0:29:05,960
این نه برای آنست که

707
0:29:05,960 --> 0:29:07,220
شهادت میدهد

708
0:29:07,220 --> 0:29:09,200
که باز نقض غرز بشه برد

709
0:29:09,200 --> 0:29:11,780
بلکه میداند

710
0:29:12,400 --> 0:29:14,200
و مظهره

711
0:29:14,200 --> 0:29:16,360
و ستار خواهد بود

712
0:29:16,360 --> 0:29:18,200
این آیه انبارکی

713
0:29:18,200 --> 0:29:20,040
سوره بغره

714
0:29:20,040 --> 0:29:21,920
را گفتن مخصص آیه

715
0:29:21,920 --> 0:29:23,820
محل بحث

716
0:29:23,820 --> 0:29:24,680
سوره مایده است

717
0:29:24,680 --> 0:29:27,620
آیه سد و نوزده

718
0:29:27,620 --> 0:29:28,360
سوره بغره

719
0:29:28,360 --> 0:29:29,740
انا ارسل

720
0:29:29,740 --> 0:29:34,980
ایم و لا تس اروان اصحاب الجهیم

721
0:29:34,980 --> 0:29:37,220
این و لا تس اروان اصحاب الجهیم

722
0:29:37,220 --> 0:29:39,180
معنیش اینست که اونا که به جهنم رفتن

723
0:29:39,180 --> 0:29:40,280
تو مسئول نیستی

724
0:29:40,280 --> 0:29:42,840
خب این که لا تزیر و واضرتون و ازر و اخره

725
0:29:42,840 --> 0:29:43,900
هیچ کس مسئول نیست

726
0:29:43,900 --> 0:29:46,460
این سؤالی که

727
0:29:46,460 --> 0:29:48,460
ما از دیگران میکنیم

728
0:29:48,460 --> 0:29:49,880
از ساره انبیان میکنیم

729
0:29:49,880 --> 0:29:51,500
از تو دیگر نمیکنیم

730
0:29:51,500 --> 0:29:54,420
به هر تقدیر بعضی خواستن بگوین

731
0:29:54,420 --> 0:29:55,940
این آیه سد و نوزده

732
0:29:55,940 --> 0:29:57,940
مخصص آیه مهده به هستوره

733
0:29:57,940 --> 0:29:58,680
مایده است

