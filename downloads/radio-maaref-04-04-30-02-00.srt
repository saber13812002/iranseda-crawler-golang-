0:24:30,220 --> 0:24:35,260
ذکر ما باشد یا علی مولا

403
0:24:35,260 --> 0:24:38
در رهش بگذریم

404
0:24:38 --> 0:24:39,560
از همه دنیا

405
0:24:39,560 --> 0:24:43,260
مال و فامیل و جان میکنیم

406
0:24:43,260 --> 0:24:45,600
زینب و سادات اهل ایران نیست

407
0:24:45,600 --> 0:24:46,920
اما فرقی نمی کنه

408
0:24:46,920 --> 0:24:48,980
چه اهل کشور افغانستان

409
0:24:48,980 --> 0:24:50,800
چه اهل کشور ایران

410
0:24:50,800 --> 0:24:53,060
باید از ناموس و دین

411
0:24:53,060 --> 0:24:53,920
دفاع کرده های افغانستان

412
0:24:53,940 --> 0:24:56,420
حالا زینب و سادات عزیز

413
0:24:56,420 --> 0:24:57,700
باید سبر کنه

414
0:24:57,700 --> 0:24:59,320
دلش تنگه

415
0:24:59,320 --> 0:25:01,760
هر لحظه میخواد که با سید احمد

416
0:25:01,760 --> 0:25:02,580
حرف بزنه

417
0:25:02,580 --> 0:25:05,600
منتظرشه بهش قول داده که

418
0:25:05,600 --> 0:25:06,680
اگه زنده بودم

419
0:25:06,680 --> 0:25:09,400
سیزده فروردین با ها تماس میگیرم

420
0:25:09,400 --> 0:25:11,420
و چقدر این انتظار

421
0:25:11,420 --> 0:25:12,540
سخته

422
0:25:12,540 --> 0:25:15,600
چقدر این انتظار حال دل آدم رو

423
0:25:15,600 --> 0:25:16,720
دگرگون میکنه

424
0:25:16,720 --> 0:25:19,900
زینب و سادات آروم و قرار نداره

425
0:25:19,900 --> 0:25:20,980
دلش میخواد

426
0:25:20,980 --> 0:25:23,140
یه خبری از سید احمد بشه

427
0:25:23,140 --> 0:25:23,860
اما

428
0:25:23,940 --> 0:25:26,160
باید منتظر بمونه

429
0:25:26,160 --> 0:25:28,760
بعد سبر کردم

430
0:25:28,760 --> 0:25:31,480
سیزده فروردین شو زنگ نزد

431
0:25:31,480 --> 0:25:33,620
چارده هم شو زنگ نزد

432
0:25:33,620 --> 0:25:36,140
گذشت هیفته هم شو زنگ نزد

433
0:25:36,140 --> 0:25:36,780
دیگه

434
0:25:36,780 --> 0:25:39,340
به هر جایی که شواره داشتم

435
0:25:39,340 --> 0:25:40,680
میدونستم زنگ زدم

436
0:25:40,680 --> 0:25:43,620
چون گفته با سیزده هم زنگ میزنم

437
0:25:43,620 --> 0:25:45,420
همه خیلی منتظر بودم

438
0:25:45,420 --> 0:25:47,180
سیزده هم چارده هم

439
0:25:47,180 --> 0:25:49,320
زنگ نزد نزد نزد

440
0:25:49,320 --> 0:25:50,980
من زنگ زدم به

441
0:25:50,980 --> 0:25:53,060
دوستایی که میشناختم

442
0:25:53,060 --> 0:25:53,920
با هم رفته بودم

443
0:25:53,940 --> 0:25:56,600
اون هم یکیشون جواب داد

444
0:25:56,600 --> 0:25:57,420
بعد

445
0:25:57,420 --> 0:25:59,620
خیلی عجیب حرصد

446
0:25:59,620 --> 0:26:02,080
گفت که زنگ نزنن بهتون

447
0:26:02,080 --> 0:26:04,020
گفتم کیا زنگ نزنن بههم

448
0:26:04,020 --> 0:26:05,700
گفت نه یعنی زنگ نزنه

449
0:26:05,700 --> 0:26:08,040
احمد بهتون حتما جایی هم

450
0:26:08,040 --> 0:26:09,940
که دسترسی به تلفون ندارم

451
0:26:10,940 --> 0:26:12,340
بعد دوباره سب کردم

452
0:26:12,340 --> 0:26:13,900
دیدم نه نمیشه اصلا

453
0:26:13,900 --> 0:26:16
بعد یه شب رفتم پیش

454
0:26:16 --> 0:26:18,160
داداشم و به داداشم

455
0:26:18,160 --> 0:26:19,620
گفتم که

456
0:26:19,620 --> 0:26:21,180
تو از احمد خبر داری

457
0:26:21,180 --> 0:26:23,300
چون خیلی با هم دوست بودن

458
0:26:23,300 --> 0:26:25,060
از همه چیز احمد خبر داری

459
0:26:25,060 --> 0:26:27,560
گفت نه من خبر ندارم

460
0:26:27,560 --> 0:26:28,820
بعد سعی میکرد

461
0:26:28,820 --> 0:26:30,560
مستقیم به هم نگاه نکنه

462
0:26:30,560 --> 0:26:32,700
گفتم نه رسول تو

463
0:26:32,700 --> 0:26:34,300
یه چیزی میدونی به من بگو

464
0:26:34,300 --> 0:26:37
گفت نه فقط این که زینبینا

465
0:26:37 --> 0:26:38,520
یه جایی هنگیر کردن

466
0:26:38,520 --> 0:26:40,440
تو همون تپای لازقیه

467
0:26:40,440 --> 0:26:43,420
و تو محاصرن

468
0:26:43,420 --> 0:26:45,100
فقط همینقدر به من

469
0:26:45,100 --> 0:26:46,680
زنگ زدن گفتن که

470
0:26:46,680 --> 0:26:49,340
ممکنه که اینا دیر تماس بگیرن

471
0:26:49,340 --> 0:26:51,220
ولی سالم و سلام اتن

472
0:26:51,220 --> 0:26:52,820
نه این که باور کنم

473
0:26:53,300 --> 0:26:55,220
خودم رو گل میزدم که باور کنم

474
0:26:55,220 --> 0:26:56,720
دوست داشتم اینجوری باشه

475
0:26:56,720 --> 0:26:59,360
خیلی گذشت رو سیامه فر بردیم

476
0:26:59,360 --> 0:27:00,600
دیدم خبری نشد

477
0:27:00,600 --> 0:27:03,140
از سپا ها مدن خونه هم سپا هستن

478
0:27:03,140 --> 0:27:05,660
نشستن سه چهار نفر نشستن

479
0:27:05,660 --> 0:27:07,220
گفتن که

480
0:27:07,220 --> 0:27:08,960
شما خانوم سید احمدی؟

481
0:27:08,960 --> 0:27:09,840
گفتم بله

482
0:27:09,840 --> 0:27:12,700
خیلی تعریفتونو کردن سید احمد

483
0:27:12,700 --> 0:27:15,120
گفت هاره اینا هنوز تو محاصرن

484
0:27:15,120 --> 0:27:16,100
نمیتونن

485
0:27:16,100 --> 0:27:18,280
گفتم این همه وقت تو محاصره اینا

486
0:27:18,280 --> 0:27:20,940
مگه میشه بدونه

487
0:27:20,940 --> 0:27:21,700
آب بدونه

488
0:27:21,700 --> 0:27:23,580
گفت نه اینا هست همراهشون

489
0:27:23,580 --> 0:27:25,900
گفتم اخوه حرفتون غیر من تبیه

490
0:27:25,900 --> 0:27:27,880
بلاخره این همه روز گفت نه خانوم

491
0:27:27,880 --> 0:27:30,160
شما به جنگ آشنا نیستین

492
0:27:30,160 --> 0:27:32,060
و جنگ شهری

493
0:27:32,060 --> 0:27:33,880
و جنگ مثل

494
0:27:33,880 --> 0:27:35,340
دفاع مقدس

495
0:27:35,340 --> 0:27:36,960
خیلی فرق داره با هم

496
0:27:36,960 --> 0:27:40,020
شما آشنا نیستین من نمیتونم بیشتر از این بهتون توضیح بدم

497
0:27:40,020 --> 0:27:42,480
فقط این که خیالتون راحت باشه

498
0:27:42,480 --> 0:27:43,540
و این رفتن

499
0:27:43,540 --> 0:27:46,240
اینا چون اومده بودن من بیشتر نگران شدم

500
0:27:46,240 --> 0:27:51,540
خدایا به اشق و به سوزه

501
0:27:51,540 --> 0:27:57,480
به سبر و به عشق و به آهه

502
0:27:57,480 --> 0:28:03,520
دل همسران شهیدان

503
0:28:03,520 --> 0:28:08,260
که یک دم مگیر از دل ما

504
0:28:08,260 --> 0:28:13,520
رحمه رو رسم وفا

505
0:28:13,540 --> 0:28:21,620
مبادا کسی بهش کند آه

506
0:28:21,620 --> 0:28:26,540
دل پاک آلالهارا

507
0:28:26,540 --> 0:28:29,720
از موعد مقرر گذشت

508
0:28:29,720 --> 0:28:34,820
از اون زمانی که سید احمد به زینب و سادات قول داده بود که باش تماس میگیره

509
0:28:34,820 --> 0:28:36,260
گذشت

510
0:28:36,260 --> 0:28:40,680
حالا دیگه زینب و سادات میخواد قدمی برداره

511
0:28:40,680 --> 0:28:43,360
میخواد بره دنبال گمشده خودش

512
0:28:43,360 --> 0:28:43,520
مبادا کسی به شکل داره باشه

513
0:28:43,540 --> 0:28:46,400
میخواد یه نشونه از عزیزش پیدا کنه

514
0:28:46,400 --> 0:28:51,460
و چقدر این روزها به زینب و سادات سخت گذشت

515
0:28:51,460 --> 0:28:53,100
چقدر

516
0:28:53,100 --> 0:28:53,540
سخت

517
0:28:54,100 --> 0:28:55,600
دیگه دوستش عراقی بود

518
0:28:55,600 --> 0:28:57,020
با خوهرم رفتم عراق

519
0:28:57,020 --> 0:28:59,160
با دوستش دعوت کردن

520
0:28:59,160 --> 0:29:00,240
دوستش اومده بود

521
0:29:00,240 --> 0:29:02,800
اونم همینو به هم گفت

522
0:29:02,800 --> 0:29:04,980
بعد رفتم دیدم نمیشه

523
0:29:04,980 --> 0:29:06,840
این برابر پرسیدم

524
0:29:06,840 --> 0:29:09,540
گفتم زخمی ها رو کجا میارن

525
0:29:09,540 --> 0:29:12,420
بعد گفتن بیمارستان وقیت الله تهران

526
0:29:12,420 --> 0:29:13,420
من فساده

527
0:29:13,540 --> 0:29:15,460
فردا شرافت دادن برم تهران

528
0:29:15,460 --> 0:29:16,740
خوهرم به هم اومد

529
0:29:16,740 --> 0:29:17,800
خوهر بزرگتم

530
0:29:17,800 --> 0:29:21,140
رفتیم بیمارستان پرسیدم

531
0:29:21,140 --> 0:29:22,840
یه طبقه بردم و دیدم

532
0:29:22,840 --> 0:29:24,640
یه سری زخمی هست

533
0:29:24,640 --> 0:29:26,280
اکس احمد به هم بود

534
0:29:26,280 --> 0:29:29,620
چند تا عرب زبان نشسته بودن

535
0:29:29,620 --> 0:29:30,680
زخمی بودن

536
0:29:30,680 --> 0:29:32,980
من این اکس رو بردم نشونشون دادم

537
0:29:32,980 --> 0:29:34,300
کسی همینو میشناسین

538
0:29:34,300 --> 0:29:37,060
اکس استادش بود

539
0:29:37,060 --> 0:29:39,220
با همون لباس هایی که براش خریده بودم

540
0:29:39,220 --> 0:29:41,240
یکیشون سری گفت

541
0:29:41,240 --> 0:29:43,260
با سر اشاره کرد گفت نه

542
0:29:43,260 --> 0:29:46,540
ولی اون یکی ها با هم حرف میزنن

543
0:29:46,540 --> 0:29:49,180
من درست متحجه نمیشدم

544
0:29:49,180 --> 0:29:51,100
برای بیشتر نگران شدم

545
0:29:51,100 --> 0:29:53,940
ای داد بی داد کم نیباشون حرف زدم

546
0:29:53,940 --> 0:29:56,560
یکی که زبانشون رو میفهمید

547
0:29:56,560 --> 0:29:57,280
مسئولم بود

548
0:29:57,280 --> 0:29:58,420
اومد گفتش که خانم

549
0:29:58,420 --> 0:30:00,080
میگن که ما فقط این

