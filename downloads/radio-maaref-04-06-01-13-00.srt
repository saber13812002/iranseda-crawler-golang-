675
0:27:16,260 --> 0:27:18,200
حقوق الله

676
0:27:18,200 --> 0:27:20,760
و حقوق الاحیاء

677
0:27:20,760 --> 0:27:22,700
و حقوق الاموات

678
0:27:22,700 --> 0:27:24,640
سیاست مدار

679
0:27:24,640 --> 0:27:26,920
کسیه که ستا حق رعایت کن

680
0:27:26,920 --> 0:27:28,560
یک حق خدا

681
0:27:28,560 --> 0:27:31,260
دو حق زنده ها

682
0:27:31,260 --> 0:27:31,920
سه حق

683
0:27:31,940 --> 0:27:32,900
حق مرده ها

684
0:27:32,900 --> 0:27:35,660
بعد البته من دیگه وقت نیست بخونم

685
0:27:35,660 --> 0:27:37,980
شما تو فضای مجازی هم بزنین

686
0:27:37,980 --> 0:27:38,760
حدیث میاد

687
0:27:38,760 --> 0:27:41,600
که سیاست از نظر امام اصلا مشتبه شیه

688
0:27:41,600 --> 0:27:42,520
بعد توضیح دار

689
0:27:42,520 --> 0:27:45,700
فرمود حق خدا اینه که واجبات رو انجام بده

690
0:27:45,700 --> 0:27:48,840
هیچ مسئولی حق نداره

691
0:27:48,840 --> 0:27:49,300
به

692
0:27:49,300 --> 0:27:51,320
اسم مسئولیت

693
0:27:51,320 --> 0:27:53,320
یا اداره یک مجموعه

694
0:27:53,320 --> 0:27:55,860
واجبات مردم رو تحتیل کنه

695
0:27:55,860 --> 0:27:57,480
نه نماز روزه حج

696
0:27:57,480 --> 0:27:59,860
بله وگر ضرورتی باشه

697
0:27:59,860 --> 0:28:01,720
حالا تو حج یه بحث دیگریست

698
0:28:01,940 --> 0:28:04,120
ولی یک سیاست

699
0:28:04,120 --> 0:28:05,980
مدار کسیه که

700
0:28:05,980 --> 0:28:08,040
اهمیت بده به حقوق خدا

701
0:28:08,040 --> 0:28:09
دروغ نگه

702
0:28:09 --> 0:28:12,080
خیانت نکنه اختلاس نکنه

703
0:28:12,080 --> 0:28:12,640
این اول

704
0:28:12,640 --> 0:28:14,420
بعد حقوق زندگان

705
0:28:14,420 --> 0:28:16,400
مردم حقوق دارن

706
0:28:16,400 --> 0:28:18,740
همسایه حقوق داره

707
0:28:18,740 --> 0:28:20,420
شهرون حقوق داره

708
0:28:20,420 --> 0:28:21,860
بعد حقوق مرده ها

709
0:28:21,860 --> 0:28:23,820
مرده ها مرده ها حقوق دارن

710
0:28:23,820 --> 0:28:26,280
حالا من فخصت ندارم بخونم این ستارو براتون

711
0:28:26,280 --> 0:28:28,100
امام اصلا میبرمه هست

712
0:28:28,100 --> 0:28:30,160
سیاست رعایت ستا حقه

713
0:28:30,160 --> 0:28:31,160
حق خدا

714
0:28:31,160 --> 0:28:32,640
حق مردم

715
0:28:32,640 --> 0:28:35,040
زنده ها و حق اموات

716
0:28:35,040 --> 0:28:37,640
به هر حال شهادت ایشون

717
0:28:37,640 --> 0:28:40,580
ستا روایت داره آخر سفر

718
0:28:40,580 --> 0:28:42,200
بیسو هشت سفر

719
0:28:42,200 --> 0:28:43,260
هفتم سفر

720
0:28:43,260 --> 0:28:45,940
ولی روایات آخر سفر

721
0:28:45,940 --> 0:28:48,700
سندش محکم تره

722
0:28:48,700 --> 0:28:50,540
گرچه هفتم سفرم

723
0:28:50,540 --> 0:28:52,620
به ازیا مثل شهید

724
0:28:52,620 --> 0:28:54,360
مثل کف امی نقل کرده

725
0:28:54,360 --> 0:28:55,940
اون چه که مسلمه

726
0:28:55,940 --> 0:28:59,040
امام مشتبه تو همین ماه سفر

727
0:28:59,040 --> 0:29:00,520
مسموم شده

728
0:29:00,520 --> 0:29:01,920
و به شهادت رسیده

729
0:29:01,920 --> 0:29:03,980
در چلو هشت سالگی

730
0:29:03,980 --> 0:29:06,840
در حالی که بیشتر بچه هاشم

731
0:29:06,840 --> 0:29:07,840
سقیر بودن

732
0:29:07,840 --> 0:29:10,400
ایشون یه پسر بزرگی داره

733
0:29:10,400 --> 0:29:11,460
به نام زید

734
0:29:11,460 --> 0:29:13,180
اون بزرگ بوده

735
0:29:13,180 --> 0:29:15,780
و اون پسر عمر طولانی هم کرده

736
0:29:15,780 --> 0:29:17,500
ست سال تقریبا عمر کرد

737
0:29:17,500 --> 0:29:20,120
بیشتر سیدای حسنی هم

738
0:29:20,120 --> 0:29:22,500
از نسل همین زیدن

739
0:29:22,500 --> 0:29:25,660
از جمعه حضرت عبدالعظیم حسنی

740
0:29:25,660 --> 0:29:27,560
که در شهر ریه

741
0:29:27,560 --> 0:29:28,700
ایشون

742
0:29:28,700 --> 0:29:30
از نسل زیده

743
0:29:30,520 --> 0:29:32,180
پسر امام حسن

744
0:29:32,180 --> 0:29:35,500
ولی بقیه بچه هایشون کچیک بودن

745
0:29:35,500 --> 0:29:38,420
عبدالله حسن شیرخاره بوده

746
0:29:38,420 --> 0:29:40
قاسم ابن حسن

747
0:29:40 --> 0:29:41,640
سه سالش بوده

748
0:29:41,640 --> 0:29:43,300
بعضی از بچه هایشون

749
0:29:43,300 --> 0:29:44,860
دختراش سقیر بودن

750
0:29:44,860 --> 0:29:47,540
در میان این بچه های کچک

751
0:29:47,540 --> 0:29:50,060
ایشون در چلو هشت سالگی

752
0:29:50,060 --> 0:29:51,900
به شهادت رسید

753
0:29:51,900 --> 0:29:54,060
لا خول ولا قوه

754
0:29:54,060 --> 0:29:56,880
الا بالله العلي العزیم

755
0:29:56,880 --> 0:29:59,660
اللهم صلی

