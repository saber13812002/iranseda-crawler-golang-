195
0:18:21,200 --> 0:18:23,580
وَاِنْ كَذَّبْتُمُونِی

196
0:18:23,580 --> 0:18:25,440
فَاِنَّ فِيكُمْ

197
0:18:25,440 --> 0:18:29,900
مَنْ اِن سَأَلْتُمُوهُ عَنْ ذَلِكَ اَخْبَرَكُمْ

198
0:18:29,900 --> 0:18:34,100
سَلُو جَابِرَ ابن عبد الله الانصاری

199
0:18:34,100 --> 0:18:36,980
وَابا سعید الخجری

200
0:18:36,980 --> 0:18:40,080
وَسَهْلَ ابن سعد الساعدي

201
0:18:40,080 --> 0:18:42,140
وَزَیدَ ابن ارقم

202
0:18:42,140 --> 0:18:44,540
وَانَتَ ابن مهالف

203
0:18:44,540 --> 0:18:46,980
يُخْبِرُوكُمْ اَنَّهُمْ

204
0:18:46,980 --> 0:18:50,880
دَمِعُوا هَذِهِ الْمَقَالَةَ مِنْ رَسُولِ اللَّهِ

205
0:18:50,880 --> 0:18:52,820
وَلِأَخِي

206
0:18:52,820 --> 0:18:56,980
اَمَا فِی هَذَا حَاجِدُ لَكُمْ

207
0:18:56,980 --> 0:18:58,420
عَنْ سَفْكِ دَمِي

208
0:18:58,420 --> 0:19:00,780
هر آیه نگمان می برید که

209
0:19:00,780 --> 0:19:03,680
در گفتهایم دروغی نوفته است

210
0:19:03,680 --> 0:19:05,440
در حالی که خود می دانم

211
0:19:05,440 --> 0:19:07,240
انچرا اظهار می دارم

212
0:19:07,240 --> 0:19:08,400
حق می باشد

213
0:19:08,400 --> 0:19:12,320
و هیچگاه خیشتن را به دروغ نیالودم

214
0:19:12,320 --> 0:19:16,080
اگر کشون این پنداری در باری گفتهایم دارید

215
0:19:16,080 --> 0:19:19
در میان مردم کسانی هستند که

216
0:19:19 --> 0:19:21,660
حقیقت را برای تن بازگو کنند

217
0:19:21,660 --> 0:19:25,140
از جابر ابن عبدالله انصاری بپرسید

218
0:19:25,140 --> 0:19:28,440
از ابا سعید خدری سآل کنید

219
0:19:28,440 --> 0:19:31,840
و یا از سهل ابن سعد سائدی

220
0:19:31,840 --> 0:19:35,880
و یا زید ابن ارقم و انس ابن مالک بپرسید

221
0:19:35,880 --> 0:19:38,480
تا شما را آگاه سازند

222
0:19:38,480 --> 0:19:42,560
و کلام رسول خدا را در باری ما باز شنوید

223
0:19:42,560 --> 0:19:46,060
فَقَالَ شِمْرُهُ وَيَعْبُدُ اللَّهُ

224
0:19:46,060 --> 0:19:50,880
عَلَى حَرْفٍ اِنْ كَانَ يَدْرِیم مَا يَقُوِدِ

225
0:19:50,880 --> 0:19:54
فَقَالَ لَهُ حَبِیبُ ابْنُ مُظَاهِر

226
0:19:54 --> 0:19:57,040
وَاللَّهِ اِنی اَرَاكُ

227
0:19:57,040 --> 0:20:00,420
تَعْبُدُ اللَّهُ عَلَى سَبْعِهِنَ حَرْفًا

228
0:20:00,420 --> 0:20:06,080
وَأَنَا اَشْهَدُ اَنَّكَ صَادِقٌ مَا تَدْرِیمَا يَقُوِدِ

229
0:20:06,080 --> 0:20:08,880
قَطَّبَعَ اللَّهُ عَلَى قَلْبِهِ

230
0:20:08,880 --> 0:20:10,440
در این هنگام

231
0:20:10,440 --> 0:20:14,600
شمر ابن زلجوشن فریاد برمی آورد که

232
0:20:14,600 --> 0:20:18,240
خداوند را با شک و تردید بپرستم

233
0:20:18,240 --> 0:20:21,740
اگر بدانم که چه میگویی ای حسین

234
0:20:21,740 --> 0:20:29,740
و حبیب ابن مظاهر اسدی در پاسخ او چونین میگوید

235
0:20:29,740 --> 0:20:38,860
به خدا سوگند که تو با هفتا درجه شک و دودلی خدا را میپرستی ای شمر

236
0:20:38,860 --> 0:20:43,760
من به خوبی میدانم که تو از انچه مولایم حسین میگوید

237
0:20:43,760 --> 0:20:50,880
ترفی نمیبندی چرا که خدا و دل ناپاکت را همچون سنگ ساخت کرده است

238
0:20:50,900 --> 0:20:54,620
ثم قال الحسین فان کنتم

239
0:20:54,620 --> 0:20:57,700
فی شک من از القول

240
0:20:57,700 --> 0:21:02,380
افت شکون ان ابن بیند نبی کم

241
0:21:02,380 --> 0:21:06,440
فوالله ما بین المشرق والمغرب

242
0:21:06,440 --> 0:21:08,780
ابن بیند نبی نظره

243
0:21:08,860 --> 0:21:10,280
غیری فی کم

244
0:21:10,280 --> 0:21:13,080
ولا فی غیر کم

245
0:21:13,080 --> 0:21:17
ویحكم اتطلبونی بقتیل من کم

246
0:21:17 --> 0:21:21,040
قتلتو او مال لکم استهلکتو

247
0:21:21,040 --> 0:21:23,540
او بقفاص جراحه

248
0:21:23,540 --> 0:21:26,720
فاخذو لا یکلمونه

249
0:21:26,720 --> 0:21:30,380
فنادا یا شبث ابن ابعی

250
0:21:30,380 --> 0:21:33,160
و یا حجار ابن ابجر

251
0:21:33,160 --> 0:21:35,820
و یا قیت ابن الاشعس

252
0:21:35,820 --> 0:21:37,900
و یا زید ابن الحارف

253
0:21:38,860 --> 0:21:41,540
هلم تکتبو الی انقدم

254
0:21:41,540 --> 0:21:44,400
قد اینعت استمار

255
0:21:44,400 --> 0:21:46,920
و خبر الجناب

256
0:21:46,920 --> 0:21:51,300
و انما تقدم على جندل کمجنده

257
0:21:51,300 --> 0:21:53,740
فقالو لم نفعل

258
0:21:53,740 --> 0:21:56,240
قال سبحان الله

259
0:21:56,240 --> 0:21:59,260
بلا والله لقد فعلتو

260
0:21:59,260 --> 0:22:03,060
امام به سخن خیش ادامه میرهند و میفرماویند

261
0:22:03,060 --> 0:22:07,320
اگر در قذیرش گفتارم دودل هستید

262
0:22:07,320 --> 0:22:08,840
و ادعایم راونه میرهند

263
0:22:08,860 --> 0:22:14,860
آیا شک دارید که من زاده دختر پیام براتان می باشم؟

264
0:22:14,860 --> 0:22:23,860
به خدا سوگم که در تمامی بسیط زمین جز من شخص دیگری فرزند دختر رسول خدا نیست.

265
0:22:23,860 --> 0:22:31,860
وای بر شما، مگر من قاتل فردی از شما هستم که می خواهید انتقام خون او را از من بگیرید،

266
0:22:31,860 --> 0:22:39,860
و یا اینکه پنداشتید سروتی را از شما گرفتم که شمشیر بر من کشیده اید؟

267
0:22:39,860 --> 0:22:44,860
هیچ کس پاسخی نمی دهد، حتی شمر.

268
0:22:44,860 --> 0:22:56,860
امام ندادر می رهند که ای شبس ابن ربعی، ای حجار ابن عبجر، ای قیس ابن عشقس، و ای زید ابن حارسه،

269
0:22:56,860 --> 0:23:01,860
مگر شما ننوشتید به سوی مابیا که هنگام میوه چیزید؟

270
0:23:01,860 --> 0:23:04,860
و بره برداری فرا رسیده است.

271
0:23:04,860 --> 0:23:10,860
به درستی که لشکریان آراسته ای را در رکاب خیش خواهید.

272
0:23:10,860 --> 0:23:15,860
آیا عهد و پیمان خیشتن را فراموش کرده اید؟

273
0:23:15,860 --> 0:23:20,860
و هنگام انکار می کنند.

274
0:23:20,860 --> 0:23:30,860
ثم قال ایوه الناس، اذا کرهتمونی و دعونی انفرف عنکم الی ممنی من الارض،

275
0:23:30,860 --> 0:23:33,600
فقال له قیس ابن الاشعب

276
0:23:33,600 --> 0:23:37,380
اولا تنزل على حكم بني عمت

277
0:23:37,380 --> 0:23:41,100
فانهم لن يروك الا ما تحب

278
0:23:41,100 --> 0:23:45,600
ولن يصل اليك منهم مكروه

279
0:23:45,600 --> 0:23:47,580
فقال الحسين

280
0:23:47,580 --> 0:23:49,840
انت اخو اخیک

281
0:23:49,840 --> 0:23:53,860
اتريد ان يطلبك بنو هاشم

282
0:23:53,860 --> 0:23:56,920
اكثر من دم مسلم ابن عقید

283
0:23:56,920 --> 0:23:58,480
لا والله

284
0:23:58,480 --> 0:24:02,580
لا اعطیهم بیدی اعطاء الذلین

285
0:24:02,580 --> 0:24:06,060
ولا افر فرار العبین

286
0:24:06,060 --> 0:24:07,960
عباد الله

287
0:24:07,960 --> 0:24:12,480
انی عوذت بربي و ربكم ان ترجمون

288
0:24:12,480 --> 0:24:15,340
اعوذ بربي و ربكم

289
0:24:15,340 --> 0:24:17,540
من كل متکبر

290
0:24:17,540 --> 0:24:20,820
لا يؤمن بيوم الحساب

291
0:24:20,820 --> 0:24:23,540
ثم انا خراحلته

292
0:24:23,540 --> 0:24:26,760
وامره عقبت ابن سمعان

293
0:24:26,760 --> 0:24:27,940
فعقلها

294
0:24:27,940 --> 0:24:29,740
امام میفرماویند

295
0:24:29,740 --> 0:24:33,740
چرا به خدا سوگند که شما شنین کردید

296
0:24:33,740 --> 0:24:35,940
در این میان

297
0:24:35,940 --> 0:24:38,900
قیصب نش از فریاد برمی آورد

298
0:24:38,900 --> 0:24:41,360
ما نمیفهمیم تو چه میگویی

299
0:24:41,360 --> 0:24:43,520
سلاه تو در این است که

300
0:24:43,520 --> 0:24:46,080
تسلیم خواستهای اموزادگانت شوی

301
0:24:46,080 --> 0:24:48,660
و امر بنی امیر را گردن گذاری

302
0:24:48,660 --> 0:24:51,020
به درستی که آنن چیزی را

303
0:24:51,020 --> 0:24:52,940
جز آنچه تو دوستاری

304
0:24:52,940 --> 0:24:54,720
پاداش نخواهنداد

305
0:24:54,720 --> 0:24:57,920
و هیچ گزندی از آنن به تو نخواهد رسیدید

306
0:24:57,940 --> 0:25:01,220
امام میفرماویند

307
0:25:01,220 --> 0:25:03,340
ای غیس

308
0:25:03,340 --> 0:25:06,200
آیا میپنداری که بنی هاشم

309
0:25:06,200 --> 0:25:08,780
جز خون مسلم ابن عقیل

310
0:25:08,780 --> 0:25:11,040
خون دیگری راستو بخواهند

311
0:25:11,040 --> 0:25:13,360
به خدا سوگند که

312
0:25:13,360 --> 0:25:16,440
هیچگاه دست مزلت به سوی امیران تو

313
0:25:16,440 --> 0:25:17,980
دراز نخواهم کرد

314
0:25:17,980 --> 0:25:19,580
و چونان بردگان نیز

315
0:25:19,580 --> 0:25:22,800
از جنگ با آنن روی بر نخواهم تاست

316
0:25:22,800 --> 0:25:25,040
به خداوندی پناه میبرم

317
0:25:25,040 --> 0:25:26,820
که پروردگار من است

318
0:25:27,940 --> 0:25:57,920
خداوندی با آنن روی بر نخواهم تاست

319
