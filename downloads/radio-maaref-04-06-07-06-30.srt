0:26:21,680 --> 0:26:22,140
الان اقل

669
0:26:22,140 --> 0:26:24,260
ما که ظالم هستیم دیگه

670
0:26:24,260 --> 0:26:26,580
دعا بکن خدا مرا حلاف بکنه

671
0:26:26,580 --> 0:26:28,020
ان کنت من از صادقین

672
0:26:28,020 --> 0:26:29,760
فی دعوا که

673
0:26:29,760 --> 0:26:33,340
ان الله لا یرد دعاک

674
0:26:33,340 --> 0:26:35,180
اگر به محمد و آله تیبین

675
0:26:35,600 --> 0:26:37,560
دعا بکنید رد نمی کند

676
0:26:37,560 --> 0:26:38,600
فقال سلمان

677
0:26:38,600 --> 0:26:41,660
من دوست ندارم

678
0:26:41,660 --> 0:26:42,860
این دعا رو بکنم چرا

679
0:26:42,860 --> 0:26:45,660
من ادعو به الله به حلاک

680
0:26:45,660 --> 0:26:47,820
مخافت این یکونه فی کم

681
0:26:47,820 --> 0:26:49,600
من غد علم الله

682
0:26:49,600 --> 0:26:51,140
انهو سیعمنو بعدو

683
0:26:51,140 --> 0:26:53,100
با این کار من مؤمن بشد

684
0:26:53,100 --> 0:26:55,840
من دوست دارم که

685
0:26:55,840 --> 0:26:57,860
یک نفرم از شما ایمان بیارد

686
0:26:57,860 --> 0:26:59,200
من در این جهت

687
0:26:59,200 --> 0:27:00,480
این غصتم اینه

688
0:27:00,480 --> 0:27:03,680
فاکون قدس عبدالله

689
0:27:03,680 --> 0:27:05,580
تعالی اقتطاعهو

690
0:27:05,580 --> 0:27:07,540
انه الامان اگر من دعا بکنم

691
0:27:07,540 --> 0:27:09,560
حلاک بشید اونیم که قابلیت ایمان دارم

692
0:27:09,560 --> 0:27:11,540
چی میشد آقا حلاک میشد

693
0:27:11,540 --> 0:27:13,740
فقالو قول الله

694
0:27:13,740 --> 0:27:14,980
امه اهدک

695
0:27:14,980 --> 0:27:16,300
اونو گفته اینجوری دعا نکن

696
0:27:16,300 --> 0:27:19,300
دعا رو بکن هر کسی از ماها که قابلیت

697
0:27:19,300 --> 0:27:21,980
برای هدایت نداده اون رو حلاک بکن

698
0:27:21,980 --> 0:27:23,900
دیگه اون محضورم پیش نمیاد

699
0:27:23,900 --> 0:27:26,280
غال فنفر جلهو

700
0:27:26,280 --> 0:27:26,940
حائطون

701
0:27:26,940 --> 0:27:28,180
همینی که گفتن

702
0:27:28,180 --> 0:27:30,300
یک دیوار باس چد

703
0:27:30,300 --> 0:27:34,700
و شاهد رسول الله

704
0:27:34,700 --> 0:27:36,220
صلی اللہ علیه و سلم

705
0:27:36,220 --> 0:27:38,660
سلمان دیوار باس چد

706
0:27:38,660 --> 0:27:40,140
رسول خدا رو مشاهده کرده

707
0:27:40,140 --> 0:27:41
و هوا یقول

708
0:27:41 --> 0:27:44,900
این نحوه وجود مثالی پیام بر رو دیده

709
0:27:44,900 --> 0:27:46,460
شاهد رسول الله

710
0:27:46,460 --> 0:27:46,980
صلی اللہ علیه و سلم

711
0:27:46,980 --> 0:27:47,860
و هوا یقول

712
0:27:47,860 --> 0:27:50,300
یا سلمان ادعو علیهم بالحلاک

713
0:27:50,300 --> 0:27:52,560
این دعا آقایی رو انجام بده

714
0:27:52,560 --> 0:27:54,360
فلیس فیهم احدون

715
0:27:54,360 --> 0:27:55,740
یر شد

716
0:27:55,740 --> 0:27:58,480
حتی یک نفر از این هم اهل رشاد و صلاح

717
0:27:58,480 --> 0:27:59,900
چی آقا نیست

718
0:28:00,300 --> 0:28:01,780
کما دعا نوهن

719
0:28:01,780 --> 0:28:03,100
علا قومهی

720
0:28:03,100 --> 0:28:05,800
لما عرف انهو لن یؤمن من قومهی

721
0:28:05,800 --> 0:28:07,280
الا من آمنه

722
0:28:07,280 --> 0:28:09,620
فقال سلمان کیفه

723
0:28:09,620 --> 0:28:10,460
تریدون

724
0:28:10,460 --> 0:28:12,580
حالا که رسول خدا فرمود به اینه گفت

725
0:28:12,580 --> 0:28:15,060
که خود چجوری بخواهی من شما دعا حلاکت بکنم

726
0:28:15,060 --> 0:28:16,620
فقالو تدالله

727
0:28:16,620 --> 0:28:18,360
و ان یقلب سوته

728
0:28:18,360 --> 0:28:20,180
کل باقه ده منها افعا

729
0:28:20,180 --> 0:28:22,520
دعا بکن که خداوند هر ایک تازیان مر

730
0:28:22,520 --> 0:28:23,780
تبدیل به افعی بکنه

731
0:28:23,780 --> 0:28:25,180
یک اجده ها

732
0:28:25,180 --> 0:28:27,140
بعد نعتف رأس ها

733
0:28:27,140 --> 0:28:28,960
ثم تومش مشه

734
0:28:28,960 --> 0:28:30,840
اضامه صدورنا

735
0:28:30,840 --> 0:28:32,760
این افعی هم بیاد

736
0:28:32,760 --> 0:28:34,900
این غفص های استخانه غفص سینیوه

737
0:28:34,900 --> 0:28:37,020
خود بکند با اون دندان خودش

738
0:28:37,020 --> 0:28:37,760
بعده

739
0:28:37,760 --> 0:28:39,820
فدع الله به ذاده

740
0:28:39,820 --> 0:28:41,500
سلمان دعا کرد

741
0:28:41,500 --> 0:28:43,620
فما من سیاتم من سوتن

742
0:28:43,620 --> 0:28:45,840
الا قلبه الله تعالی

743
0:28:45,840 --> 0:28:47
علیهم افعالها

744
0:28:47 --> 0:28:49,020
خدای تعالی به قدرت خودش

745
0:28:49,020 --> 0:28:50,920
اینها همه تبدیل به اجده ها کرده

746
0:28:50,920 --> 0:28:53,060
لها رأسان تتناولو

747
0:28:53,060 --> 0:28:55,120
به رأس منها رأسه

748
0:28:55,120 --> 0:28:56,940
اون وقت دارد و به رأس

749
0:28:56,940 --> 0:28:58,120
این آخره یمینه

750
0:28:58,120 --> 0:29:01,420
یعنی دو تا

751
0:29:01,420 --> 0:29:03,220
سر داشته با یه سر

752
0:29:03,220 --> 0:29:05,260
اون دستی که تازیانی بوده گرفته

753
0:29:05,260 --> 0:29:06,980
با یه سر دیگه سر خود

754
0:29:06,980 --> 0:29:08,260
این شخص رو گرفته

755
0:29:08,260 --> 0:29:12,800
یعنی اونها رو خورد کرده

756
0:29:12,800 --> 0:29:13,920
و مشهشت هم

757
0:29:13,920 --> 0:29:15,540
اونها رو به استلاح

758
0:29:15,540 --> 0:29:18,220
تا آخر نیشت رو در اینا فرو برده

759
0:29:18,220 --> 0:29:20,180
و بلعت هم

760
0:29:20,180 --> 0:29:22,060
و تقمت هم

761
0:29:22,060 --> 0:29:23,460
فقال رسول صلی اللہ علیه وسلم

762
0:29:23,460 --> 0:29:24,640
و اوفی مجلسی

763
0:29:24,640 --> 0:29:26,920
حالا در این حالی که این کار اتفاق افتاده

764
0:29:26,940 --> 0:29:28,820
رسول خدا اینجا نبود

765
0:29:28,820 --> 0:29:30,700
در این مجلس خودش بوده در جای دیگه

766
0:29:30,700 --> 0:29:32,460
با دوستان و اصحاب خود جلسه داشته

767
0:29:32,460 --> 0:29:35
فقال رسول صلی اللہ علیه وسلم

768
0:29:35 --> 0:29:35,960
و اوفی مجلسی

769
0:29:35,960 --> 0:29:38,820
اینن لا تعالی

770
0:29:38,820 --> 0:29:41,620
غد نسر اخاکم سلمان

771
0:29:41,620 --> 0:29:43,540
ساعتکم حاضهی

772
0:29:43,540 --> 0:29:44,560
همین الان

773
0:29:44,560 --> 0:29:46,960
نسرت خدا شامل آقا سلمان شد

774
0:29:46,960 --> 0:29:49,020
علا اشرین

775
0:29:49,020 --> 0:29:51,420
مردت من یهود

776
0:29:51,420 --> 0:29:52,420
و المنافقین

777
0:29:52,420 --> 0:29:54,520
و بیستو از یهود و منافقین

778
0:29:54,520 --> 0:29:56,520
فقلبت سیاتهم افعایی

779
0:29:56,940 --> 0:29:58,940
رددتهم و معششتهم

