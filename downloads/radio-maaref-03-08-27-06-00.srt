0:25:06,900 --> 0:25:09,540
که در دسترس همه مردم باشد

420
0:25:09,540 --> 0:25:11,060
کتابه بود

421
0:25:11,060 --> 0:25:12,440
تقریبا انحساری

422
0:25:12,440 --> 0:25:14
انجیلم این چنین بود

423
0:25:14 --> 0:25:15,500
لذا

424
0:25:15,500 --> 0:25:16,740
اون مشروعه

425
0:25:16,980 --> 0:25:19,240
شایخ سو و علمای سو اشون

426
0:25:19,240 --> 0:25:21,820
به دلخواه خود تحریف میکردن

427
0:25:21,820 --> 0:25:23,320
تفسیره به رعی میکردن

428
0:25:23,320 --> 0:25:26,240
و مینوشتن میگفتن این حرف تورات و انجیل است

429
0:25:26,240 --> 0:25:28,380
فرمود از این را

430
0:25:28,380 --> 0:25:30,460
اینها دین را تحریف میکردن

431
0:25:30,460 --> 0:25:31,760
و درامدی داشتن

432
0:25:31,760 --> 0:25:33,740
توم یقورون حضام

433
0:25:33,740 --> 0:25:36,540
اند الله لیشتر و به ثمن قریلا

434
0:25:36,540 --> 0:25:38,240
فویلون لهم مما

435
0:25:38,240 --> 0:25:40,480
کتبت ایدیهن و ویلون لهم

436
0:25:40,480 --> 0:25:41,600
مما یک سبوب

437
0:25:41,600 --> 0:25:43,980
در سوره انبارکه

438
0:25:43,980 --> 0:25:46,180
ماعده

439
0:25:46,980 --> 0:25:48,980
بخش دیگری از حرام خوریهای

440
0:25:49,540 --> 0:25:51,340
اهل کتاب

441
0:25:51,340 --> 0:25:52,140
ذکر شده است

442
0:25:52,140 --> 0:25:53,620
و قهرن

443
0:25:53,620 --> 0:25:56,240
تحریف هایی هم که شد

444
0:25:56,240 --> 0:25:58,520
بر اساس هم حرام خوریهای این است

445
0:25:58,520 --> 0:26:01,240
آیه چهل و دو سوره ماعده

446
0:26:01,240 --> 0:26:02,160
این است که

447
0:26:02,160 --> 0:26:04,980
سماغون للکدبه اکارون للسوهد

448
0:26:05,540 --> 0:26:06,940
اصولا

449
0:26:06,940 --> 0:26:08,840
مال حرام را مخصوصا رشوه

450
0:26:08,840 --> 0:26:10,980
و امثال رشوه را سوهد میگویند

451
0:26:11,760 --> 0:26:13,060
برای اینکه سوهد کردن

452
0:26:13,060 --> 0:26:14,260
یعنی نرم کردن

453
0:26:14,260 --> 0:26:16,660
یعنی شما نرم میکنند

454
0:26:16,980 --> 0:26:18,240
مسهوت

455
0:26:18,240 --> 0:26:19,820
مثل مسهوق

456
0:26:19,820 --> 0:26:22,200
اون چیزای پودر شده است

457
0:26:22,200 --> 0:26:23,520
سحیق

458
0:26:23,520 --> 0:26:26,080
به سحیت همین است

459
0:26:26,080 --> 0:26:28,160
خب چون حرام

460
0:26:28,160 --> 0:26:30,440
وارد زندگی کسی بشود

461
0:26:30,440 --> 0:26:32,440
او را پودر میکند

462
0:26:32,440 --> 0:26:34,920
دیگر هر گونه استقامتی هم داشته باشد

463
0:26:34,920 --> 0:26:36,500
او را متلاشی میکند

464
0:26:36,500 --> 0:26:38,500
از این جهت حرام را

465
0:26:38,500 --> 0:26:39,640
سوهد گفتند

466
0:26:39,640 --> 0:26:41,960
چه اینکه حرام را هم حرام گفتند

467
0:26:41,960 --> 0:26:44,240
برای اینکه خدا انسان را

468
0:26:44,240 --> 0:26:46,020
معنی کرده محروم کرده

469
0:26:46,020 --> 0:26:46,960
و اون مال همه

470
0:26:46,980 --> 0:26:48,780
انسان را از سعادت و فضیلت

471
0:26:48,780 --> 0:26:49,540
محروم میکند

472
0:26:49,540 --> 0:26:51,420
باز در سوره بارکه

473
0:26:51,420 --> 0:26:53,680
معده

474
0:26:53,680 --> 0:26:57,140
گوشه از حرام خوریها

475
0:26:57,140 --> 0:26:58,800
یه اهل کتاب را ذکر میکند

476
0:26:58,800 --> 0:26:59,740
آیه

477
0:26:59,740 --> 0:27:02,540
شست و دو این است

478
0:27:02,540 --> 0:27:04,040
شست و دو سوره معده

479
0:27:04,040 --> 0:27:06,140
و ترا کثیر من هم یسارعون

480
0:27:06,140 --> 0:27:08,740
افر افمی و عدوان و اکلیمو سخت

481
0:27:08,740 --> 0:27:10,820
لبعث ماکانو یعملون

482
0:27:10,820 --> 0:27:13,120
مشایخ و علماشون

483
0:27:13,120 --> 0:27:15,680
هم مروجان این سخت خوری بودند

484
0:27:15,680 --> 0:27:16,960
و من لولا

485
0:27:16,960 --> 0:27:18,720
ینها هم ربانیون

486
0:27:18,720 --> 0:27:20,800
و احباران قولهم و عفو

487
0:27:20,800 --> 0:27:22,960
و اکلهم و سخت لبعث ماکانو

488
0:27:22,960 --> 0:27:23,480
یسناون

489
0:27:23,480 --> 0:27:26,640
چرا علماشون احبار ربانیشون

490
0:27:26,640 --> 0:27:28,900
اونها را از حرام خوری باز نقشتند

491
0:27:28,900 --> 0:27:30,960
این چرین گروه

492
0:27:31,480 --> 0:27:34,140
یعنی این احبار روحبان

493
0:27:34,140 --> 0:27:35,720
یا خودشون دستن

494
0:27:35,720 --> 0:27:37,340
در کار تحریف بودند

495
0:27:37,340 --> 0:27:40,360
یا یا آدم بی تفاوت

496
0:27:40,360 --> 0:27:42,660
لذا در سوره بارکه

497
0:27:42,660 --> 0:27:44,440
آل امران ملازه فرمودید

498
0:27:44,440 --> 0:27:46,440
سر این که خداوند

499
0:27:46,440 --> 0:27:49,260
مسیح ها را به مسلمان ها

500
0:27:49,260 --> 0:27:51,800
نزدیک تر از یهودی ها می داند

501
0:27:51,800 --> 0:27:54,680
این اشدن ناس عداوتن

502
0:27:54,680 --> 0:27:56,320
للدین آمن الیهود

503
0:27:56,320 --> 0:27:57,600
ولدین اشتکو

504
0:27:57,600 --> 0:28:00,120
و این اغرب ها مودتن

505
0:28:00,120 --> 0:28:01,680
للدین آمن الیهود

506
0:28:01,680 --> 0:28:03,260
ولدین قال و این نانسارا

507
0:28:03,260 --> 0:28:06,040
و علیه که به انه منهم قسیسین

508
0:28:06,040 --> 0:28:08,500
و روحبان و انه هم لایستکبرون

509
0:28:08,500 --> 0:28:10,400
برای همان از که احبار

510
0:28:10,400 --> 0:28:11,720
و روحبان یهود

511
0:28:11,720 --> 0:28:14,740
غیر از قسیس و روحبان مسیح ها بودند

512
0:28:14,740 --> 0:28:16,120
و در بین ملده

513
0:28:16,440 --> 0:28:20,600
مسیح ها به مسلمان ها نزدیک ترند

514
0:28:20,600 --> 0:28:22,820
مشرکین و یهودی ها

515
0:28:22,820 --> 0:28:24,860
در اثر اون قصاوت قلب

516
0:28:24,860 --> 0:28:28,160
شدید ترین دشمنی را نسبت به اسلام مسلمین دارند

517
0:28:28,160 --> 0:28:30,440
ولی مسیح ها

518
0:28:30,440 --> 0:28:32,140
به سه دلیل

519
0:28:32,140 --> 0:28:34,340
این ها به اسلام نزدیک هستند

520
0:28:34,340 --> 0:28:36,360
و این اغرب ها مودتن

521
0:28:36,360 --> 0:28:37,820
للدین آمن الیهود

522
0:28:37,820 --> 0:28:38,740
و این اغرب ها مودتن

523
0:28:38,740 --> 0:28:40,760
للدین قال و این نانسارا

524
0:28:40,760 --> 0:28:42,020
چرا؟

525
0:28:42,020 --> 0:28:44,220
ولی که به انه منهم قسیسین

526
0:28:44,220 --> 0:28:46,260
و روحبان و انه هم لایستکبرون

527
0:28:46,440 --> 0:28:50,220
این ها طبعا یه آدم های مستکبر نیستند

528
0:28:50,220 --> 0:28:52,060
اگر درست تربیت بشوند

529
0:28:52,060 --> 0:28:52,960
حق پذیرند

530
0:28:52,960 --> 0:28:55,840
طبعا خشن نیستند

531
0:28:55,840 --> 0:28:56,600
این یکی

532
0:28:56,600 --> 0:28:58,480
علمای خوبی هم دارند

533
0:28:58,480 --> 0:28:59,800
این ها رو تربیت میکنند

534
0:28:59,800 --> 0:29:02,700
خب اگر یه ملدی طبعا خشن نباشد

535
0:29:02,700 --> 0:29:05,060
آلمان خوبی هم داشته باشند

536
0:29:05,060 --> 0:29:06,360
درست تربیت میشوند

537
0:29:06,360 --> 0:29:08,100
این آلمان

538
0:29:08,100 --> 0:29:10,260
یعنی قسیس و روحبان

539
0:29:10,260 --> 0:29:12,340
در یهودیت هم بود

540
0:29:12,340 --> 0:29:14,320
اون هم علمای دین داشتند

541
0:29:14,320 --> 0:29:15,320
منتها

542
0:29:15,320 --> 0:29:16,320
روحان

543
0:29:16,440 --> 0:29:18,340
همون ماده پرستی

544
0:29:18,340 --> 0:29:19,680
که در این قشب

545
0:29:19,680 --> 0:29:21,300
در این نجات بود

546
0:29:21,300 --> 0:29:23,740
این علمایشون هم به دام

547
0:29:23,740 --> 0:29:26
همین رزیلت افتادند

548
0:29:26 --> 0:29:28,120
شروع کردند به تحریف

549
0:29:28,120 --> 0:29:29,420
تورات از یک سم

550
0:29:29,420 --> 0:29:31,840
شروع کردند به رشبگیری

551
0:29:31,840 --> 0:29:33,120
از سمت دیگر

552
0:29:33,120 --> 0:29:36,300
لذا قرآن کریم نمیگوید

553
0:29:36,300 --> 0:29:38,220
این ها روحانیون داشتند

554
0:29:38,220 --> 0:29:40,080
این ها علما داشتند

555
0:29:40,080 --> 0:29:41,960
برای که علمایشون اصولا

556
0:29:41,960 --> 0:29:43,700
به همین دام افتادند

557
0:29:43,700 --> 0:29:45,700
و اگر نه از حرف آلم داشتند

558
0:29:46,440 --> 0:29:47,660
این

559
0:29:47,660 --> 0:29:49,680
یعنی آلم سوری

560
0:29:49,680 --> 0:29:51,020
کافی نیست

561
0:29:51,020 --> 0:29:53,540
قصیست به روحبانی که

562
0:29:53,540 --> 0:29:55,940
خودش کتاب الهی را

563
0:29:55,940 --> 0:29:56,920
تحریف میکند

564
0:29:56,920 --> 0:29:58,600
او فساد دامن میزند

