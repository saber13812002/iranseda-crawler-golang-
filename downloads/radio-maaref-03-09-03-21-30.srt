0:25:50,720 --> 0:25:53,160
اصل مسئله اینست که

638
0:25:53,160 --> 0:25:55,020
زمخ شری متوجه شد

639
0:25:55,020 --> 0:25:59,640
اینست که این دلالت میکند که عقل آزادانه و سائر درک میکند

640
0:25:59,640 --> 0:26:04,440
اشاعر به آیه سوره انبیا استدلال میکردن

641
0:26:04,440 --> 0:26:05,240
که

642
0:26:05,240 --> 0:26:07,080
لا یسال و اما یفعه

643
0:26:07,240 --> 0:26:08,460
البهم یسالون

644
0:26:08,460 --> 0:26:09,340
یعنی

645
0:26:09,340 --> 0:26:13,200
ذات اقدسه لا هرگز زیر سؤال قرار نمیگیرد

646
0:26:13,200 --> 0:26:15,040
و مردم هم که مسئولند

647
0:26:15,040 --> 0:26:17,660
آیه 23 سوره انبیا

648
0:26:17,660 --> 0:26:20,960
این لا یسال و اما یفعه البهم یسالون

649
0:26:20,960 --> 0:26:24,280
سند مهم اشاعر است

650
0:26:24,280 --> 0:26:25,580
که خیال بکنن

651
0:26:25,580 --> 0:26:28,860
خدا هر کاری را بکند آزاد است

652
0:26:28,860 --> 0:26:30,580
و هر کار را هم میکند

653
0:26:30,580 --> 0:26:32,880
و هرگز زیر سؤال قرار نمیگیرد

654
0:26:32,880 --> 0:26:35
در حال که این آیه حق است

655
0:26:35 --> 0:26:37,080
معنای آیه این است که

656
0:26:37,080 --> 0:26:38,880
شما اگر بخواهید

657
0:26:38,880 --> 0:26:40,640
از خدا سؤال بکنید

658
0:26:40,640 --> 0:26:42,700
خدا سؤال بردار نیست

659
0:26:42,700 --> 0:26:44,300
سؤال بکنید که

660
0:26:44,300 --> 0:26:46,180
علت فائلی کی بود

661
0:26:46,180 --> 0:26:48,060
کی به تو دستور داد

662
0:26:48,060 --> 0:26:49,980
یه همچنین سؤال معقول نیست

663
0:26:49,980 --> 0:26:52,500
چون خودش فائل مهز است و هوبال اول

664
0:26:52,500 --> 0:26:54,280
اگر سؤال بکنید

665
0:26:54,280 --> 0:26:55,920
که حدفت چی بود

666
0:26:55,920 --> 0:26:58,460
از علت قائی سؤال بکنید

667
0:26:58,460 --> 0:26:59,760
او علت قائی ندارد

668
0:26:59,760 --> 0:27:01
خودش هوبال آخر است

669
0:27:01 --> 0:27:02,480
خودش کمال مهز است

670
0:27:02,480 --> 0:27:05,940
ما هر سؤالی را که از کسی میکنیم

671
0:27:05,940 --> 0:27:07,560
یا سؤال به مبدع

672
0:27:07,560 --> 0:27:09,760
مادی و سوری برمیگردد

673
0:27:09,760 --> 0:27:12,320
از یک سنعتگر سؤال بکنیم

674
0:27:12,320 --> 0:27:14,040
که این وسیله را

675
0:27:14,040 --> 0:27:15,380
با چی درست کردی

676
0:27:15,380 --> 0:27:17
چی جور درست کردی

677
0:27:17 --> 0:27:20,600
که این سؤال از محدوده کار است

678
0:27:20,600 --> 0:27:22,900
که این کار را چطور انجام دادی

679
0:27:22,900 --> 0:27:24,020
یه وقت است که نه

680
0:27:24,020 --> 0:27:25,480
از اون سؤال بکنیم

681
0:27:25,480 --> 0:27:27,580
به دستور کی انجام دادی

682
0:27:27,580 --> 0:27:28,340
این یک

683
0:27:28,340 --> 0:27:31,420
برای چه منظوری انجام دادی

684
0:27:31,420 --> 0:27:31,940
این دو

685
0:27:31,940 --> 0:27:35,100
این سؤال در باره غیر خدا راه دارد

686
0:27:35,100 --> 0:27:35,580
در باره

687
0:27:35,940 --> 0:27:37,360
غیر خدا میتوان

688
0:27:37,360 --> 0:27:39,680
هم از مبدع فائلی سؤال کرد

689
0:27:39,680 --> 0:27:40,760
که چی گفت

690
0:27:40,760 --> 0:27:42,580
هم از مبدع قائی پرسید

691
0:27:42,580 --> 0:27:44,140
که برای چی این کار کردی

692
0:27:44,140 --> 0:27:46
ولی ذات اقدس اله

693
0:27:46 --> 0:27:48,200
که خودش مبدع کل است

694
0:27:48,200 --> 0:27:49,700
از اون نمیشه

695
0:27:49,700 --> 0:27:52,940
و سؤال کرد که تو به دستور کی انجام دادی

696
0:27:52,940 --> 0:27:53,780
و خودش

697
0:27:53,780 --> 0:27:56,660
هدف محض و کمال سرف است

698
0:27:56,660 --> 0:27:58,040
نمیشه و سؤال کرد

699
0:27:58,040 --> 0:28:00,440
که تو این را برای چی انجام دادی

700
0:28:00,440 --> 0:28:01,940
چون هر فائلی

701
0:28:01,940 --> 0:28:03,900
کاری را که انجام میدهد

702
0:28:03,900 --> 0:28:06,380
برای رسیدن به کمال محض است

703
0:28:06,380 --> 0:28:08,840
حالا اگر خود کمال نامتناهی

704
0:28:08,840 --> 0:28:10,880
خواست کار را انجام بدهد

705
0:28:10,880 --> 0:28:13,180
او دیگر برای چیزی

706
0:28:13,180 --> 0:28:14,560
که کار انجام نمیدهد

707
0:28:14,560 --> 0:28:16,140
لذا ذات اقدس اله

708
0:28:16,140 --> 0:28:17,980
اصلا مسئول قرار دامی گرد

709
0:28:17,980 --> 0:28:20,740
لا یسالو اما یفعل و هم یسالو

710
0:28:20,740 --> 0:28:22,200
ولی در این محدوده

711
0:28:22,200 --> 0:28:24,880
اگر پیامبری نفرستد

712
0:28:24,880 --> 0:28:26,700
طبق اون چند آیه

713
0:28:26,700 --> 0:28:27,640
که خوندیم

714
0:28:27,640 --> 0:28:30,260
ما کننا مقدبین حتی نبعث رسولا

715
0:28:30,260 --> 0:28:32,660
در سوره اسلام و لولا ارسلت

716
0:28:32,660 --> 0:28:34,820
ایران رسولان فنت طبع آیات

717
0:28:34,820 --> 0:28:36,680
که من قبلن نزل و نخزا

718
0:28:36,680 --> 0:28:38,400
در پایان سوره امبارکی

719
0:28:38,400 --> 0:28:39,660
تاها دلیل بود

720
0:28:39,660 --> 0:28:46,520
اینا دلیل است بین که

721
0:28:46,520 --> 0:28:48,200
در محدوده کار

722
0:28:48,200 --> 0:28:50,620
عقل میتواند استدلال کند

723
0:28:50,620 --> 0:28:52,580
و خدا آنست

724
0:28:52,580 --> 0:28:55,100
که بنده را مهمل رهانه کند

725
0:28:55,100 --> 0:28:56,900
جامعه انسانی را

726
0:28:56,900 --> 0:28:58,660
مهمل رهانه کند

727
0:28:58,660 --> 0:29:00,900
و اگر کسی مدعی

728
0:29:00,900 --> 0:29:02,360
علوهیت است

729
0:29:02,360 --> 0:29:04,780
و ازالک برای جوامه

730
0:29:04,780 --> 0:29:06,900
بشری فکر هدایتی

731
0:29:06,900 --> 0:29:08,120
نیندیشید

732
0:29:08,120 --> 0:29:09,560
او مبدع نیست

733
0:29:09,560 --> 0:29:12,680
او مبدع آنست که از او این خیر نشعت

734
0:29:12,680 --> 0:29:13,340
بگیرد

735
0:29:13,340 --> 0:29:16,260
این تعلیم خود قرآن کریم است

736
0:29:16,260 --> 0:29:18,340
که یو بیینو لکم ال آیات

737
0:29:18,340 --> 0:29:21,180
اونگاه امام رازی به تکلف افتاده

738
0:29:21,180 --> 0:29:22,780
گفت لالا یکونه

739
0:29:22,780 --> 0:29:24,660
لناسه علالله هجتون

740
0:29:24,660 --> 0:29:25,600
وعدر سور

741
0:29:25,600 --> 0:29:28,560
یعنی لالا یکونه لناسه

742
0:29:28,560 --> 0:29:30,260
علالله ما

743
0:29:30,260 --> 0:29:31,760
یوش به هل هجه

744
0:29:32,360 --> 0:29:34,180
این آیه بازی کرده است

745
0:29:34,180 --> 0:29:36,800
به تفسیر فخر و آزی که براجم کنید

746
0:29:36,800 --> 0:29:38,840
ببینید اصل اشغال را که

747
0:29:38,840 --> 0:29:41,300
زمخشری تحقیق کرده بازگون میکند

748
0:29:41,300 --> 0:29:43,460
اما در جواب اشغال

749
0:29:43,460 --> 0:29:46,180
این لالا یکونه لناسه

750
0:29:46,180 --> 0:29:47,460
علالله هجتون

751
0:29:47,460 --> 0:29:48,560
وعدر رسول

752
0:29:48,560 --> 0:29:51,540
این هجتون را یعنی به ما یوش به هل هجه

753
0:29:51,540 --> 0:29:52,320
برام کند

754
0:29:52,320 --> 0:29:54,040
این جمعی از خود اضافه بکند

755
0:29:54,040 --> 0:29:55,540
و آیه را اصلا تحریف میده

