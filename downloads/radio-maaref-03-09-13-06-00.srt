0:26:18,040 --> 0:26:20,560
آیه 135

643
0:26:20,560 --> 0:26:22,380
کون قوامین

644
0:26:22,380 --> 0:26:24,080
بلغیس شهدال الله

645
0:26:24,080 --> 0:26:26,700
ولو علا انفسکم اول والدین

646
0:26:26,700 --> 0:26:28,300
والاقربین یکن

647
0:26:28,300 --> 0:26:30,300
غنین او فقیرن فله اولاده

648
0:26:30,440 --> 0:26:33,020
با به ما این دیم میتواند جهانی باشد

649
0:26:33,020 --> 0:26:34,880
برای این که نه تنها قائم

650
0:26:34,880 --> 0:26:37,260
بلغیس باشید قوام بلغیس باشید

651
0:26:37,260 --> 0:26:38,940
برای حق شهادت بدید

652
0:26:38,940 --> 0:26:40,840
برای رضا خدا شهادت بدید

653
0:26:40,840 --> 0:26:42,200
و حق شهادت بدید

654
0:26:42,200 --> 0:26:44,580
اگر علایه خود شماست

655
0:26:44,580 --> 0:26:45,560
که اقرار بکنید

656
0:26:45,560 --> 0:26:48,720
اگر علایه پدر یا مادر یا بستگان است

657
0:26:48,720 --> 0:26:50,260
از اداع شهادت

658
0:26:50,260 --> 0:26:51,580
باز نمانید

659
0:26:51,580 --> 0:26:53,920
اگر اون مشهودون علایه

660
0:26:53,920 --> 0:26:56,760
یا مشهودون لفقیر یا قنیس

661
0:26:56,760 --> 0:26:58,300
شما فقر و قناعی

662
0:26:58,300 --> 0:26:59,640
اون را رایت نکنید

663
0:26:59,640 --> 0:27:01,220
حالا اگر یه فقیری

664
0:27:01,220 --> 0:27:03,740
همونطوری در خلال بحث اشاره شد

665
0:27:03,740 --> 0:27:05,620
در اثر رایت نکردن

666
0:27:05,620 --> 0:27:06,940
اصول رانندگی

667
0:27:06,940 --> 0:27:08,840
یا تنرانی مطور

668
0:27:08,840 --> 0:27:11,600
زد به یک کسی که وضعی مالیش خوبه

669
0:27:11,600 --> 0:27:12,380
اون را انداخت

670
0:27:12,380 --> 0:27:14,440
حالا شما خواستید شهادت بدید

671
0:27:14,440 --> 0:27:16,140
بگید چون این راننده

672
0:27:16,140 --> 0:27:19,100
یا این مطور سبار فقیر است

673
0:27:19,100 --> 0:27:21,200
من به نفع اون شهادت بدم

674
0:27:21,200 --> 0:27:23,620
و این مسلومی که به جدول

675
0:27:23,620 --> 0:27:24,740
پرد شده است

676
0:27:26,760 --> 0:27:29,380
من به علیه اون شهادت بدم

677
0:27:29,380 --> 0:27:31,220
فرموز اون کار را شما نداشته باشید

678
0:27:31,220 --> 0:27:33,360
خدا به حساب هر کدام علاهده میرسد

679
0:27:33,360 --> 0:27:35,380
نه توانگریه توانگران

680
0:27:35,960 --> 0:27:37,720
در قسط و عدل شما

681
0:27:37,720 --> 0:27:38,880
دخالت کند

682
0:27:38,880 --> 0:27:41,100
نه توهی دستیه توهی دستان

683
0:27:41,100 --> 0:27:43,040
این یکون قنیه او فقیران

684
0:27:43,040 --> 0:27:44,340
فرله او لا به ما

685
0:27:44,340 --> 0:27:47,600
این قابل قبول است

686
0:27:47,600 --> 0:27:48,800
در هیچ جای دنیا

687
0:27:48,800 --> 0:27:51,020
که اگر یک فقیری

688
0:27:51,020 --> 0:27:53,280
به یک قنی ستم کرد

689
0:27:53,280 --> 0:27:55,380
او رو با مطور زد

690
0:27:55,380 --> 0:27:56,380
از یک مسلمان

691
0:27:56,760 --> 0:27:59,980
که شاهد سهنبود شهادت طلب بکنن

692
0:27:59,980 --> 0:28:01,840
این باید به سود اون مطور سوار

693
0:28:01,840 --> 0:28:02,640
شهادت بده

694
0:28:02,640 --> 0:28:03,640
چون این فقیر است

695
0:28:03,640 --> 0:28:05,320
این قابل قبول است در هیچ جا

696
0:28:05,320 --> 0:28:09,320
چون در محکمه اقل و فطرت قابل قبول نیست

697
0:28:09,320 --> 0:28:10,700
و ذات اقدس اله

698
0:28:10,700 --> 0:28:12,420
بر اساس اقل و فطرت

699
0:28:12,420 --> 0:28:14,860
و کمبودش را با وحی

700
0:28:14,860 --> 0:28:16,200
داوری کرده است

701
0:28:16,200 --> 0:28:19
فرمود این دین دین جهانی است

702
0:28:19 --> 0:28:20,400
حق را بگو

703
0:28:20,400 --> 0:28:22,360
ولو علیه خودت باشی

704
0:28:22,360 --> 0:28:24,160
ولو علیه پدر مادرت باشی

705
0:28:24,160 --> 0:28:26
ولو علیه بستگانت باشی

706
0:28:26 --> 0:28:29,840
فقر فقرا و توانگری توانگرانم

707
0:28:29,840 --> 0:28:32
در احقاق حق به ابتال باطل

708
0:28:32 --> 0:28:33,220
نقشی نداشته باشه

709
0:28:33,220 --> 0:28:35,140
این دین میتواند جهانی باشد

710
0:28:35,140 --> 0:28:37,780
هیچ چیزی در این شهادت

711
0:28:37,780 --> 0:28:38,860
نقش ندارد

712
0:28:38,860 --> 0:28:41,540
متله بعدیان است که

713
0:28:41,540 --> 0:28:44,740
در جریان اطاعت از رحبری

714
0:28:44,740 --> 0:28:46,120
چون این گونه از آیات

715
0:28:46,120 --> 0:28:48,860
که مربوط به تأسیس نظام است

716
0:28:48,860 --> 0:28:50,700
اینها در محک نازل نشد

717
0:28:50,700 --> 0:28:52,080
در مدیر نازل شد

718
0:28:52,080 --> 0:28:54
مسئله اتی اولا و اتی اول رحمه

719
0:28:54,160 --> 0:28:56,080
رسول و اول الامر من کم آمد است

720
0:28:56,080 --> 0:28:57,740
که این اول الامر منظور ایمه

721
0:28:57,740 --> 0:28:58,760
رحمه سلام است

722
0:28:58,760 --> 0:29:01,680
البته به دستور ایمه در زمان قیبت

723
0:29:01,680 --> 0:29:03,100
جانشینان اونها

724
