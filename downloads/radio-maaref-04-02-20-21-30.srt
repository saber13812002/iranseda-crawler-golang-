0:26:29,060 --> 0:26:31,040
بهترین ازمان بهترین اماکن

645
0:26:31,040 --> 0:26:33,640
یه جایی که میمارش دوتا پیغمبر هست

646
0:26:33,640 --> 0:26:35,400
یه جایی که بسیاری از انبیاء

647
0:26:35,400 --> 0:26:37
اونجا تواف کردن

648
0:26:37 --> 0:26:39,580
یه جایی که بسیاری از انبیاء اونجا رهلت کردن

649
0:26:39,580 --> 0:26:40,500
در بخاک سفردن

650
0:26:40,500 --> 0:26:42,620
یه قداسه دیگه بلاخره باید داشته باشد دیگه

651
0:26:42,620 --> 0:26:45,200
که مردم پذیر و دلپذیر باشد

652
0:26:45,200 --> 0:26:47,440
وگنه یه جایی معیین قرار بدد نه

653
0:26:47,440 --> 0:26:49,040
تو همون نهجال بلاغم هست

654
0:26:49,040 --> 0:26:51,100
که اگر ذات اقدس اله میتوانست

655
0:26:51,100 --> 0:26:53,640
بهترین سرزمین را مطاف قرار میداد

656
0:26:53,640 --> 0:26:55,940
ولی خب این جا برای امنیت نبود

657
0:26:55,940 --> 0:26:58,720
انسان وقتی از خودی پایین نیامده

658
0:26:58,720 --> 0:27:00,100
همون درندگی را دارد

659
0:27:00,100 --> 0:27:03,180
یه جایی را انسان را آزمود

660
0:27:03,180 --> 0:27:05,880
که هیچ چیزی از مظاهر حیات درونیست

661
0:27:05,880 --> 0:27:07,120
یه سنگلاقی بیش نیست

662
0:27:07,120 --> 0:27:09,260
این که تو نهجال بلاغم در خطبه اول هست

663
0:27:09,260 --> 0:27:12,720
همون اگر خدا میخواد شما را بیازمایید

664
0:27:12,720 --> 0:27:15,640
خب این همه جاهای خوب خدا و فرید دیگر

665
0:27:15,640 --> 0:27:18,800
جایی که زمستان و تابستانش فاصله ده درجه هست

666
0:27:18,800 --> 0:27:21,020
نه مثل مبارد دیگری که زیر سف باشد

667
0:27:21,020 --> 0:27:23,100
یا درجه چلونجا باشد

668
0:27:23,100 --> 0:27:26,800
یه جای امنی که حد در سر زمستان و تابستان ده درجه هست

669
0:27:26,800 --> 0:27:29,300
هرگز به سف نرسد یخ بندان نباشد

670
0:27:29,300 --> 0:27:32,760
و هرگز گرمای سی درجه و چل درجه داشته باشد

671
0:27:32,760 --> 0:27:34,940
اگر خدا یه همچی جایی را قرار میداد

672
0:27:34,940 --> 0:27:36,340
خب همه دان میامدن

673
0:27:36,340 --> 0:27:38,200
اون جایی برای مرفعین بود

674
0:27:38,200 --> 0:27:39,020
ده برای محرمین

675
0:27:39,020 --> 0:27:41,340
و اون جایی را خدا قرار داد

676
0:27:41,340 --> 0:27:43,360
که بتواند بیاز باید بلاخره

677
0:27:43,360 --> 0:27:45,740
انسان را از خودیش پیاده کند دیگر

678
0:27:45,740 --> 0:27:57,500
اون میخواد انسان را کم کم به سمت قیامت دعوت کند

679
0:27:57,500 --> 0:28:00,580
انسان را از اون خودیش بی اندازد

680
0:28:00,580 --> 0:28:02,920
بلاخره موی افراد عادی را

681
0:28:02,920 --> 0:28:06,080
هر کسی بلاخره در هر حدی هم که باشد

682
0:28:06,080 --> 0:28:07,160
به مو افتخار بکند

683
0:28:07,160 --> 0:28:10,340
حالا یا واقعا برای اون زیبایی می آورد

684
0:28:10,340 --> 0:28:11,320
یا اون عادت کرده

685
0:28:11,320 --> 0:28:11,760
به این

686
0:28:11,760 --> 0:28:15
و اگر کسی موی سر کسی را بتراشد

687
0:28:15 --> 0:28:16,420
باید دیه بدد شرعه

688
0:28:16,420 --> 0:28:17,380
یا همین چیزیه

689
0:28:17,380 --> 0:28:20,460
همین را فرماد در پای دوست باید قربانی کنی

690
0:28:20,460 --> 0:28:23,300
خب کسی که سرش را

691
0:28:23,300 --> 0:28:25,400
بتراشد در پای دوست

692
0:28:25,400 --> 0:28:27,060
معلوم می شود از خودی پایین آمده

693
0:28:27,060 --> 0:28:28,460
نه مزاهمی کسی است

694
0:28:28,460 --> 0:28:30,540
نه کسی هم باید مزاهمی او باشه

695
0:28:30,540 --> 0:28:32,360
انگاه انسان می فهمد که

696
0:28:32,360 --> 0:28:36,900
انسان تا از خود پیاده نشد

697
0:28:36,900 --> 0:28:38,760
که دیگه نمی شود با او گفت

698
0:28:41,320 --> 0:28:43,740
بعد به او گفتن آینه نگاه نکن

699
0:28:43,740 --> 0:28:45
بعد به او گفتن

700
0:28:45 --> 0:28:47,520
ایتری که این همه فضیلت دارد

701
0:28:47,520 --> 0:28:49
یک رکد نماز با عطر

702
0:28:49 --> 0:28:51,980
این همه ثواب دارد گفتن استعمال عطر حرام است

703
0:28:51,980 --> 0:28:53,160
خب این دین

704
0:28:53,160 --> 0:28:54,760
آدم را پیاده می کند

705
0:28:54,760 --> 0:28:56,940
وقتی پیاده کرد دیگه حرفی ندارد

706
0:28:56,940 --> 0:28:59,640
ها انسان سوارست مشکل دارد

707
0:28:59,640 --> 0:29:02,120
وقتی پیاده شد می شود برده و بنده

708
0:29:02,120 --> 0:29:02,560
اینه

709
0:29:02,560 --> 0:29:08,020
وقت کم از کسی مکشه برود

710
0:29:08,020 --> 0:29:10,680
و تایی مدتی بارسته نباشد

711
0:29:10,680 --> 0:29:11,140
گفتن

712
0:29:11,320 --> 0:29:12,760
قبل از این که او آروده بشود

713
0:29:12,760 --> 0:29:13,900
با اون مسافهه کنید

714
0:29:13,900 --> 0:29:15,100
پیشانی او را ببسید

715
0:29:15,100 --> 0:29:16,220
با اون معانقه کنید

716
0:29:16,220 --> 0:29:17,580
این مهمان خداست

717
0:29:17,580 --> 0:29:18,840
این دستور است

718
0:29:18,840 --> 0:29:20,380
پس این سه تا مسئله را

719
0:29:20,380 --> 0:29:22,620
ذات اقدسه را به خوبی تبین کرد

720
0:29:22,620 --> 0:29:24,340
هم اعتقاد را

721
0:29:24,340 --> 0:29:27,480
که مهور اصاسی او بیت الله است

722
0:29:27,480 --> 0:29:29,060
آمل قیام دانست

723
0:29:29,060 --> 0:29:30,800
هم اقتصاد را

724
0:29:30,800 --> 0:29:33,100
و هم اندت تزاهم

725
0:29:33,100 --> 0:29:35,660
اقتصاد را رو بنادانست

726
0:29:35,660 --> 0:29:37,480
و اعتقاد را

727
0:29:37,480 --> 0:29:38,780
زیر بناد

728
0:29:38,780 --> 0:29:40,780
والحمدلله رب العالمين

729
0:29:41,320 --> 0:29:45,320
ای احانی ایمان

730
0:29:45,980 --> 0:29:51,320
بحر ای زد من نان

731
0:29:51,980 --> 0:29:57,320
و کتاب بیداری

732
0:29:58,120 --> 0:29:59,320
ای تبایی

