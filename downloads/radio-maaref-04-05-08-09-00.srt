0:28:43,680 --> 0:28:45,460
گرون تموم میشه

643
0:28:45,460 --> 0:28:48,040
دیگه حالا از ترس خدا بود

644
0:28:48,040 --> 0:28:48,620
یا از

645
0:28:48,620 --> 0:28:52,280
به هر انگیزه بود

646
0:28:52,280 --> 0:28:53,420
گفتیم بریم

647
0:28:53,420 --> 0:28:54,920
ما حرفی نداریم

648
0:28:54,920 --> 0:28:58,100
همون جا به خلبان هلکوبتر گفت

649
0:28:58,100 --> 0:28:59,740
دستشون برد بالا

650
0:28:59,740 --> 0:29:01,300
گفت بره بالا

651
0:29:01,300 --> 0:29:03,680
یعنی ارتفاط رو ببر بالا

652
0:29:04,360 --> 0:29:05,860
امیر خدا

653
0:29:05,860 --> 0:29:07,320
یواهه ما رفتیم

654
0:29:07,320 --> 0:29:09,420
در اون

655
0:29:09,420 --> 0:29:10,200
وسط

656
0:29:10,200 --> 0:29:13,660
مسلسی که

657
0:29:13,660 --> 0:29:15,320
بین بوکان

658
0:29:15,320 --> 0:29:17,320
محاباد

659
0:29:17,320 --> 0:29:18,340
و سردش بود

660
0:29:18,340 --> 0:29:20,620
یعنی درست رفتیم

661
0:29:20,620 --> 0:29:23,700
روستر موازه حضب دموقرات

662
0:29:23,700 --> 0:29:26,340
از اون بالا

663
0:29:26,340 --> 0:29:29,200
تعداد خدروهایی که پایین پارک شده بود

664
0:29:29,200 --> 0:29:32,900
سازوکارهای فیزیکی که تبیه شده بود

665
0:29:32,900 --> 0:29:35,140
ساختمونهایی که وجود داشت

666
0:29:35,140 --> 0:29:36,580
اون موقع ما تازه فهمیدیم

667
0:29:36,580 --> 0:29:37,700
که منطقه

668
0:29:37,700 --> 0:29:39,920
چه خبر هست

669
0:29:39,920 --> 0:29:42,260
اینا این وسط رو دارن

670
0:29:42,260 --> 0:29:43,480
ما هم خب

671
0:29:43,480 --> 0:29:44,840
شهرها دست ما بود اون موقع

672
0:29:44,840 --> 0:29:46,240
جادو هم دست ما بود

673
0:29:46,240 --> 0:29:48,580
اما وسط مسلس

674
0:29:48,580 --> 0:29:50,900
کاملا در دست اینها بود

675
0:29:50,900 --> 0:29:52,700
مقرد داشتن

676
0:29:52,700 --> 0:29:54,140
حکومت داشتن

677
0:29:54,140 --> 0:29:55,740
سازوکار داشتن

678
0:29:55,740 --> 0:29:58,760
و از اونجا عملیاتها رو

679
0:29:58,760 --> 0:29:59,920
هدایت می کنیم

