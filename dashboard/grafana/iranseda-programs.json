  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": true,
      "icon": "dashboard",
      "title": "Admin panel (web)",
      "type": "link",
      "url": "http://127.0.0.1:8990/"
    },
    {
      "asDropdown": true,
      "icon": "external-link",
      "title": "Pipeline overview",
      "type": "link",
      "url": "http://127.0.0.1:3000/d/iranseda-pipeline"
    }
  ],
  "liveNow": false,
  "panels": [
    {
      "type": "row",
      "title": "Filters / فیلترها",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": [],
