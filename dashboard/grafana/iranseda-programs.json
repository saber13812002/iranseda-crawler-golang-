      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "collapsed": false,
      "panels": [],
      "repeat": null
    },
    {
      "type": "stat",
      "title": "This week / این هفته",
      "datasource": {
        "type": "${DS_MYSQL}",
        "uid": "${DS_MYSQL}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 2
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "scheme"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "rawSql": "SELECT COUNT(*) AS value\nFROM radio_program_sessions s\nJOIN radio_programs p ON p.id = s.program_id\nWHERE s.is_subtitled = 1\n  AND CONVERT_TZ(s.updated_at, '+00:00', '+03:30') >= CURDATE() - INTERVAL WEEKDAY(CURDATE()) DAY\n  AND $__timeFilter(CONVERT_TZ(s.updated_at, '+00:00', '+03:30'))\n  AND ${program:raw}",
          "format": "time_series",
          "rawQuery": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Last week / هفته گذشته",
      "datasource": {
        "type": "${DS_MYSQL}",
        "uid": "${DS_MYSQL}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 2
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "scheme"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "rawSql": "SELECT COUNT(*) AS value\nFROM radio_program_sessions s\nJOIN radio_programs p ON p.id = s.program_id\nWHERE s.is_subtitled = 1\n  AND CONVERT_TZ(s.updated_at, '+00:00', '+03:30') >= CURDATE() - INTERVAL WEEKDAY(CURDATE()) DAY - INTERVAL 7 DAY\n  AND CONVERT_TZ(s.updated_at, '+00:00', '+03:30') < CURDATE() - INTERVAL WEEKDAY(CURDATE()) DAY\n  AND $__timeFilter(CONVERT_TZ(s.updated_at, '+00:00', '+03:30'))\n  AND ${program:raw}",
          "format": "time_series",
          "rawQuery": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "This month / این ماه",
      "datasource": {
        "type": "${DS_MYSQL}",
        "uid": "${DS_MYSQL}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 2
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "scheme"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "rawSql": "SELECT COUNT(*) AS value\nFROM radio_program_sessions s\nJOIN radio_programs p ON p.id = s.program_id\nWHERE s.is_subtitled = 1\n  AND DATE_FORMAT(CONVERT_TZ(s.updated_at, '+00:00', '+03:30'), '%Y-%m') = DATE_FORMAT(CURDATE(), '%Y-%m')\n  AND $__timeFilter(CONVERT_TZ(s.updated_at, '+00:00', '+03:30'))\n  AND ${program:raw}",
          "format": "time_series",
          "rawQuery": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Last month / ماه گذشته",
      "datasource": {
        "type": "${DS_MYSQL}",
        "uid": "${DS_MYSQL}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 2
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "scheme"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "rawSql": "SELECT COUNT(*) AS value\nFROM radio_program_sessions s\nJOIN radio_programs p ON p.id = s.program_id\nWHERE s.is_subtitled = 1\n  AND DATE_FORMAT(CONVERT_TZ(s.updated_at, '+00:00', '+03:30'), '%Y-%m') = DATE_FORMAT(CURDATE() - INTERVAL 1 MONTH, '%Y-%m')\n  AND $__timeFilter(CONVERT_TZ(s.updated_at, '+00:00', '+03:30'))\n  AND ${program:raw}",
          "format": "time_series",
          "rawQuery": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Throughput / نرخ تولید (Asia/Tehran)",
      "gridPos": {
