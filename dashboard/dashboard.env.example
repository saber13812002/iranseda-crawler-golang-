# Template for dashboard/dashboard.env (copy to dashboard.env and fill in).
# dashboard.env is gitignored (holds the auth token + LiteLLM master key).

# Server 53 project root (holds .env, docker-compose.whisper.yml, scripts/, downloads/).
IRANSEDA_ROOT=/home/saber/saberprojects/iranseda-crawler-golang-

# Bind port for the dashboard.
PORT=8990

# Bearer token required for /api/* (page /, /health, /metrics stay open).
# Generate one with:  python3 -c "import secrets; print(secrets.token_hex(18))"
DASH_AUTH_TOKEN=CHANGE-ME

# LiteLLM (backend on server 52) — used to list/add/delete models from the dashboard.
LITELLM_BASE_URL=http://172.20.1.52:4000
LITELLM_MASTER_KEY=CHANGE-ME
