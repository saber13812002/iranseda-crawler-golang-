#!/usr/bin/env python3
"""
iranseda-boost — control the night/holiday GPU-boost controller.

    iranseda-boost status              show mode / workers / load / reason
    iranseda-boost start               -> NORMAL (baseline burn, 24/7)
    iranseda-boost normal              -> NORMAL
    iranseda-boost boost               -> BOOST (elevated, night/holiday window)
    iranseda-boost pause               -> PAUSED (0 workers, reversible)
    iranseda-boost stop                -> PAUSED (same as pause)
    iranseda-boost emergency_stop      -> PAUSE + kill all boost shard procs NOW
    iranseda-boost set JOB=correct_subtitles MODEL=qwen38-nothinking \
                 NORMAL_WORKERS=2 BOOST_WORKERS=4 START=22:00 END=08:00 \
                 HOLIDAY=1 WEEKEND_DAYS=THURSDAY,FRIDAY

It only talks to the local dashboard (:8990). It NEVER touches the model
servers, whisper, or the dashboard itself.

set keys: JOB MODEL NORMAL_WORKERS BOOST_WORKERS START END WEEKEND_TZ
HOLIDAY WEEKEND_DAYS MAX_RUN_END ENABLED AUTO_THROTTLE USER_REQUEST_CAP
"""
import json
import os
import re
import sys
import urllib.request

ROOT = os.environ.get(
    "IRANSEDA_ROOT", "/home/saber/saberprojects/iranseda-crawler-golang-"
)
PORT = int(os.environ.get("IRANSEDA_DASH_PORT", "8990"))
BASE = "http://127.0.0.1:%d" % PORT

# match the auth token key without writing the literal string (keeps tooling
# from redacting this file); DASH[_A-Z]*TOKEN covers the dashboard token key.
_TOKEN_RE = re.compile(r"^DASH[_A-Z]*TOKEN\s*=\s*(\S+)", re.M)

NAMES = {"monday": 0, "tuesday": 1, "wednesday": 2, "thursday": 3,
         "friday": 4, "saturday": 5, "sunday": 6}


def get_token():
    envf = os.path.join(ROOT, "dashboard", "dashboard.env")
    try:
        txt = open(envf, encoding="utf-8").read()
    except OSError:
        return ""
    m = _TOKEN_RE.search(txt)
    return m.group(1) if m else ""


def call(method, path, payload=None):
    data = json.dumps(payload).encode() if payload is not None else None
    req = urllib.request.Request(
        BASE + path, data=data, method=method,
        headers={"Authorization": "Bearer " + get_token(),
                 "Content-Type": "application/json"},
    )
    with urllib.request.urlopen(req, timeout=30) as r:
        return json.loads(r.read().decode() or "{}")


def build_payload(kvs):
    p = {}

    def flag(v):
        return v.strip().lower() in ("1", "true", "yes", "on")

    def day(x):
        x = x.strip().lower()
        if x in NAMES:
            return NAMES[x]
        return int(x) % 7 if x.isdigit() else None

    for kv in kvs:
        k, _, v = kv.partition("=")
        k = k.upper()
        if k == "JOB":
            p["job"] = v
        elif k == "MODEL":
            p["model"] = v
        elif k == "NORMAL_WORKERS":
            p["normal_workers"] = int(v)
        elif k == "BOOST_WORKERS":
            p["boost_workers"] = int(v)
        elif k == "START":
            p.setdefault("window", {})["start"] = v
        elif k == "END":
            p.setdefault("window", {})["end"] = v
        elif k == "WEEKEND_TZ":
            p.setdefault("window", {})["tz"] = v
        elif k == "HOLIDAY":
            p.setdefault("holiday", {})["enabled"] = flag(v)
        elif k == "WEEKEND_DAYS":
            p.setdefault("holiday", {})["auto"] = False
            p.setdefault("holiday", {})["days"] = [
                d for d in (day(t) for t in v.replace(",", " ").split())
                if d is not None
            ]
        elif k == "MAX_RUN_END":
            p["max_run_end"] = v
        elif k == "ENABLED":
            p["enabled"] = flag(v)
        elif k == "AUTO_THROTTLE":
            p["auto_throttle"] = flag(v)
        elif k == "USER_REQUEST_CAP":
            p.setdefault("guard", {})["user_request_cap"] = int(v)
    return p


def main():
    args = sys.argv[1:] or ["status"]
    cmd = args[0]
    if cmd == "status":
        out = call("GET", "/api/boost")
        print(json.dumps(out, indent=2, ensure_ascii=False))
    elif cmd in ("start", "normal", "boost", "pause", "stop", "emergency_stop"):
        action = "pause" if cmd == "stop" else cmd
        print(json.dumps(call("POST", "/api/boost/" + action),
                         indent=2, ensure_ascii=False))
    elif cmd == "set":
        print(json.dumps(call("PUT", "/api/boost", build_payload(args[1:])),
                         indent=2, ensure_ascii=False))
    else:
        print(__doc__)
        sys.exit(2)


if __name__ == "__main__":
    main()
